{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeterniUI",
  "version": "0.1.0",
  "identifier": "com.tauri.dev",
  "build": {
    "frontendDist": "../../src/AeterniUI.Sample/bin/Release/net10.0/publish/wwwroot",
    "devUrl": "http://localhost:5178",
    "beforeDevCommand": "dotnet watch --project ../src/AeterniUI.Sample/AeterniUI.Sample.csproj run --no-launch-profile --urls http://localhost:5178",
    "beforeBuildCommand": "dotnet publish ../src/AeterniUI.Sample/AeterniUI.Sample.csproj -c Release"
  },
  "app": {
    "windows": [
      {
        "title": "Aeterni UI",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
