@page "/components/skeleton"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Skeleton</PageTitle>

<ComponentPage AnchorId="skeleton"
               Category="状态反馈"
               Title="Skeleton"
               ComponentName="Skeleton"
               Description="内容加载占位：文本行、矩形和圆形，以及由它们拼出的常见组合。"
               Related="@SkeletonRelated">
    <WhenToUse>
        <p>内容结构已知、只是数据还没到时使用：列表项、卡片正文、头像与封面。等待时间很短或结构未知时用 <code>Spinner</code>。</p>
        <p>占位只在首次加载时出现；刷新已有的内容时不要整块换成占位，那会让页面跳动。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="skeleton-lines"
                  Title="文本占位"
                  Description="Lines 决定堆叠的行数，最后一行按宽度的 80% 收尾；不传 Lines 就是单行。"
                  Code="@LinesCode">
            <Preview>
                <div class="preview-skeleton-demo">
                    <section class="preview-skeleton-block">
                        <span class="preview-value">三行文本</span>
                        <Skeleton Lines="3" />
                    </section>
                    <section class="preview-skeleton-block">
                        <span class="preview-value">单行文本</span>
                        <Skeleton />
                    </section>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="skeleton-shapes"
                  Title="圆形与矩形"
                  Description="Variant 换形状：圆形配合 Height 得到头像，矩形用来占位封面、图表或媒体区块。"
                  Code="@ShapeCode">
            <Preview>
                <div class="preview-skeleton-demo">
                    <section class="preview-skeleton-block">
                        <span class="preview-value">头像 + 两行文本</span>
                        <div class="preview-skeleton-row">
                            <Skeleton Variant="SkeletonVariant.Circle" Height="48px" />
                            <div class="preview-skeleton-copy">
                                <Skeleton Lines="2" Height="12px" />
                            </div>
                        </div>
                    </section>
                    <section class="preview-skeleton-block">
                        <span class="preview-value">矩形（封面 / 图表）</span>
                        <Skeleton Variant="SkeletonVariant.Rectangle" Height="96px" />
                    </section>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="skeleton-params"
                  Title="在宿主容器里使用"
                  Description="Width 与 Height 接收原样 CSS 长度，缺省由变体决定；右侧控件即时生效。"
                  Code="@ParamCode">
            <Preview>
                <div class="preview-skeleton-demo">
                    <section class="preview-skeleton-block">
                        <span class="preview-value">当前参数</span>
                        <Skeleton Variant="@_skeletonVariant"
                                  Lines="@_skeletonLines"
                                  Width="@_skeletonWidth"
                                  Height="@_skeletonHeight" />
                    </section>
                    <span class="preview-feedback" role="status">Variant：@(_skeletonVariant) · Lines：@(_skeletonLines)</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Variant</span>
                    <ShowcaseSelect TValue="SkeletonVariant" Id="skeleton-variant" AriaLabel="Variant" Options="@(Enum.GetValues<SkeletonVariant>())" @bind-Value="_skeletonVariant" />
                </div>
                <div class="control-field">
                    <label for="skeleton-lines">Lines</label>
                    <input id="skeleton-lines" type="number" min="1" max="6" @bind="_skeletonLines" />
                </div>
                <div class="control-field">
                    <label for="skeleton-width">Width</label>
                    <input id="skeleton-width" placeholder="100%" @bind="_skeletonWidth" />
                </div>
                <div class="control-field">
                    <label for="skeleton-height">Height</label>
                    <input id="skeleton-height" placeholder="按变体默认" @bind="_skeletonHeight" />
                </div>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>占位图形对读屏不可见（根元素 <code>aria-hidden="true"</code>）；正在加载的容器由使用方标记 <code>aria-busy</code>。</span>
        <span>文本块的最后一行按宽度的 80% 收尾，避免占位块看起来像一整块实心矩形。</span>
        <span><code>prefers-reduced-motion</code> 下微光动画停止并移除高光渐变，占位块退化为静态色块。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] SkeletonRelated =
    [
        new("Spinner", "/components/spinner"),
        new("Progress", "/components/progress"),
        new("Empty", "/components/empty")
    ];

    private const string LinesCode = """
        <Skeleton Lines="3" />
        <Skeleton />
        """;

    private const string ShapeCode = """
        <Skeleton Variant="SkeletonVariant.Circle" Height="48px" />
        <Skeleton Variant="SkeletonVariant.Rectangle" Height="96px" />
        """;

    private const string ParamCode = """
        <Skeleton Variant="SkeletonVariant.Text"
                  Lines="3"
                  Width="320px"
                  Height="14px" />
        """;

    private SkeletonVariant _skeletonVariant = SkeletonVariant.Text;

    private int _skeletonLines = 3;

    private string? _skeletonWidth;

    private string? _skeletonHeight;
}
