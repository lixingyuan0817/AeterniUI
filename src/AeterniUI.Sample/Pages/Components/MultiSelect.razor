@page "/components/multi-select"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · MultiSelect</PageTitle>

<ComponentPreview AnchorId="multi-select"
                  Category="表单组件"
                  Title="MultiSelect"
                  ComponentName="MultiSelect&lt;TItem&gt;"
                  Description="多值绑定、已选项标签、移除操作以及可选的全选和清空动作。"
                  Code="@UsageCode">
    <Preview>
        <div class="preview-form-control preview-form-control--fill">
            <FormField Label="组件分类" Description="可以通过键盘方向键移动，按空格切换选项。" Disabled="@_disabled" Invalid="@_invalid">
                <MultiSelect TItem="string"
                             Items="@Categories"
                             SelectedValues="@_selected"
                             SelectedValuesChanged="HandleSelectedChanged"
                             Size="@_size"
                             Placeholder="@_placeholder"
                             AllowSelectAll="@_allowSelectAll"
                             AllowClear="@_allowClear"
                             FullWidth="@_fullWidth"
                             Disabled="@_disabled"
                             Invalid="@_invalid"
                             AriaLabel="组件分类" />
            </FormField>
            <span class="preview-feedback" role="status">已选择：@(_selected.Count == 0 ? "（空）" : string.Join("、", _selected))</span>
        </div>
    </Preview>
    <Controls>
        <div class="control-field">
            <label for="multi-select-placeholder">Placeholder</label>
            <input id="multi-select-placeholder" @bind="_placeholder" />
        </div>
        <div class="control-field">
            <span>Size</span>
            <ShowcaseSelect TValue="Size" Id="multi-select-size" AriaLabel="MultiSelect Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
        </div>
        <Checkbox Size="Size.Small" @bind-Value="_allowSelectAll">AllowSelectAll</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_allowClear">AllowClear</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_disabled">Disabled</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_fullWidth">FullWidth</Checkbox>
    </Controls>
    <Notes>
        <span>组件只负责展示和交互；Items、SelectedValues 以及异步数据由宿主应用控制。</span>
        <span>选项使用 listbox/option 多选语义；已选项可以在触发器内单独移除，AllowSelectAll 和 AllowClear 控制批量动作。</span>
    </Notes>
</ComponentPreview>

@code {
    private static readonly string[] Categories = ["设计", "开发", "产品", "运营", "研究"];
    private IReadOnlyList<string> _selected = ["设计", "开发"];
    private string _placeholder = "选择组件分类…";
    private Size _size = Size.Default;
    private bool _allowSelectAll = true;
    private bool _allowClear = true;
    private bool _disabled;
    private bool _invalid;
    private bool _fullWidth;

    private const string UsageCode = """
        <MultiSelect TItem="Category"
                     Items="Categories"
                     @bind-SelectedValues="Selected"
                     TextSelector="@(category => category.Name)"
                     Placeholder="选择分类"
                     AllowSelectAll
                     AllowClear />
        """;

    private Task HandleSelectedChanged(IReadOnlyList<string> values)
    {
        _selected = values;
        return Task.CompletedTask;
    }
}
