@page "/components/slider"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Slider</PageTitle>

<ComponentPage AnchorId="slider"
               Category="表单组件"
               Title="Slider"
               ComponentName="Slider&lt;TValue&gt;"
               Description="单值滑块：指针拖动与键盘步进落在同一个可调控件上。"
               Related="@SliderRelated">
    <WhenToUse>
        <p>取值范围连续、精度要求不苛刻时使用：音量、缩放、阈值。需要精确输入具体数值用 <code>InputNumber</code>。</p>
        <p><code>Step</code> 会把指针位置吸附到步长网格；不设 <code>Step</code> 时是连续值，RTL 下方向键与拖动方向自动镜像。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="slider-basic"
                  Title="基础用法"
                  Description="拖动或方向键改变数值；当前值同时写入 ARIA 与自定义属性，视觉与语义来自同一份数据。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-form-control">
                    <Slider TValue="double" Value="@_volume" ValueChanged="HandleVolumeChanged" Min="0" Max="100" Precision="2" AriaLabel="音量" />
                    <code class="preview-value">Value: @_volume</code>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="slider-step"
                  Title="步长与精度"
                  Description="Step 把指针吸附到网格（本例 5 一档），Precision 决定显示与提交的小数位。"
                  Code="@StepCode">
            <Preview>
                <div class="preview-form-control">
                    <Slider TValue="double" Value="@_stepValue" ValueChanged="HandleStepChanged"
                            Min="0" Max="100" Step="5" Precision="0" AriaLabel="按 5 一档的音量" />
                    <code class="preview-value">Value: @_stepValue</code>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="slider-states"
                  Title="状态与尺寸"
                  Description="无效态改用危险色焦点环，禁用态不进入 Tab 序列；三档尺寸只改变轨道与滑块几何。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-form-control">
                    <FormField Label="阈值" Description="超过阈值时触发告警。" Invalid="@_invalid" Disabled="@_disabled">
                        <Slider TValue="double"
                                Value="@_stateValue"
                                ValueChanged="HandleStateChanged"
                                Min="0" Max="10"
                                Size="@_size"
                                Precision="0"
                                AriaLabel="告警阈值" />
                    </FormField>
                    <code class="preview-value">Value: @_stateValue</code>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Size</span>
                    <ShowcaseSelect TValue="Size" Id="slider-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_disabled">Disabled</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>键盘模型由组件自己接管：方向键、Home/End、PageUp/PageDown 只改数值，不会同时滚动页面。</span>
        <span>滑块不渲染刻度与数值标签：需要刻度、区间标注或双端范围请由宿主在轨道旁组合。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] SliderRelated =
    [
        new("InputNumber", "/components/input-number"),
        new("Progress", "/components/progress"),
        new("FormField", "/components/form-field")
    ];

    private const string BasicCode = """
        <Slider TValue="double" Value="Volume" ValueChanged="HandleVolumeChanged" Min="0" Max="100" />
        """;

    private const string StepCode = """
        <Slider TValue="double" Value="Volume" ValueChanged="HandleVolumeChanged"
                Min="0" Max="100" Step="5" Precision="0" />
        """;

    private const string StateCode = """
        <FormField Label="阈值" Invalid>
            <Slider TValue="double" Value="Threshold" ValueChanged="HandleChanged" Min="0" Max="10" />
        </FormField>
        """;

    private double _volume = 40;
    private double _stepValue = 40;

    private double _stateValue = 6;
    private Size _size = Size.Default;
    private bool _invalid;
    private bool _disabled;

    private Task HandleVolumeChanged(double value)
    {
        _volume = value;
        return Task.CompletedTask;
    }

    private Task HandleStepChanged(double value)
    {
        _stepValue = value;
        return Task.CompletedTask;
    }

    private Task HandleStateChanged(double value)
    {
        _stateValue = value;
        return Task.CompletedTask;
    }
}
