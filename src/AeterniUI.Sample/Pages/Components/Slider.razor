@page "/components/slider"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Slider</PageTitle>

<ComponentPreview AnchorId="slider"
                  Category="表单组件"
                  Title="Slider"
                  ComponentName="Slider&lt;TValue&gt;"
                  Description="单值滑块：默认无级调节，也可配置步进吸附；支持横向与竖向布局、完整键盘模型与指针拖拽。">
    <Preview>
        <div class="preview-form-control preview-form-control--fill">
            <FormField Label="音量"
                       Description="拖动滑块，或聚焦后使用方向键 / Home / End / PageUp / PageDown。"
                       Disabled="@_disabled"
                       Invalid="@_invalid">
                <Slider TValue="double"
                        Value="@_value"
                        ValueChanged="@HandleValueChanged"
                        Min="0d"
                        Max="100d"
                        Step="@EffectiveStep"
                        Precision="2"
                        Size="@_size"
                        Orientation="@_orientation"
                        Disabled="@_disabled"
                        Invalid="@_invalid"
                        AriaLabel="音量" />
            </FormField>
            <span class="preview-feedback" role="status">当前值：@_value.ToString("0.00")</span>
        </div>
    </Preview>
    <Controls>
        <div class="control-grid">
            <div class="control-field">
                <span>Size</span>
                <ShowcaseSelect TValue="Size" Id="slider-size" AriaLabel="Slider Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
            </div>
            <div class="control-field">
                <span>Orientation</span>
                <ShowcaseSelect TValue="Orientation" Id="slider-orientation" AriaLabel="Slider Orientation" Options="@(Enum.GetValues<Orientation>())" @bind-Value="_orientation" />
            </div>
        </div>
        <Checkbox Size="Size.Small" @bind-Value="_useStep">按 5 步进</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_disabled">Disabled</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
    </Controls>
    <Notes>
        <span><code>Step=null</code> 时指针无级跟随；设置正数后，指针与键盘都吸附到以 <code>Min</code> 为起点的步网格。</span>
        <span>无级模式的方向键每次移动量程的 1%，PageUp / PageDown 每次移动 10%；整数类型仍受其可表示精度限制。</span>
        <span>根元素就是滑块本体（<code>role="slider"</code> + 单一 Tab 停留点）；轨道、填充与滑块均为装饰节点。</span>
        <span>竖向布局的值从底边向上增长，长度默认 12rem，可由宿主通过 <code>--aeterni-slider-length</code> 覆盖。</span>
        <span>指针拖拽由 <code>Slider.razor.js</code> 处理；只有配置 <code>Step</code> 时才在 JS 内就近吸附，键盘与取值逻辑全部在 C#。</span>
    </Notes>
</ComponentPreview>

@code {
    private double _value = 40;
    private Size _size = Size.Default;
    private Orientation _orientation = Orientation.Horizontal;
    private bool _useStep;
    private bool _disabled;
    private bool _invalid;

    private double? EffectiveStep => _useStep ? 5d : null;

    private Task HandleValueChanged(double value)
    {
        _value = value;
        return Task.CompletedTask;
    }

}
