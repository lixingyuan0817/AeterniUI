@page "/components/radio"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons
@using AeterniUI.Models.Dialog
@using AeterniUI.Services.Impl

<PageTitle>Aeterni UI · Radio / RadioGroup</PageTitle>

<ComponentPreview AnchorId="radio"
                  Category="表单组件"
                  Title="Radio / RadioGroup"
                  ComponentName="RadioGroup / Radio"
                  Description="原生单选语义与分组绑定，支持禁用、必填和无效状态。"
                  Parameters="@RadioParameters">
    <Controls>
        <Checkbox Size="Size.Small" @bind-Value="_radioDisabled">Disabled</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_radioRequired">Required</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_radioInvalid">Invalid</Checkbox>
        <div class="control-field">
            <span>Size</span>
            <ShowcaseSelect TValue="Size" Id="radio-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_radioSize" />
        </div>
        <div class="control-field">
            <span>Orientation</span>
            <ShowcaseSelect TValue="Orientation" Id="radio-orientation" AriaLabel="Orientation" Options="@(Enum.GetValues<Orientation>())" @bind-Value="_radioOrientation" />
        </div>
    </Controls>
    <Preview>
        <div class="preview-stack">
            <FormField Label="部门" Disabled="@_radioDisabled" Required="@_radioRequired" Invalid="@_radioInvalid">
            <RadioGroup TValue="string" @bind-Value="_radioValue" AriaLabel="部门" Size="_radioSize" Orientation="_radioOrientation">
                <Radio TValue="string" Value="@("设计")">设计</Radio>
                <Radio TValue="string" Value="@("开发")">开发</Radio>
                <Radio TValue="string" Value="@("产品")">产品</Radio>
            </RadioGroup>
            </FormField>
            <div class="preview-state-row" aria-label="Radio 与 Checkbox 视觉重量对照">
                <Radio TValue="bool" @bind-Value="_standaloneRadio" Size="_radioSize">独立 Radio</Radio>
                <Checkbox Size="_radioSize">同尺寸 Checkbox</Checkbox>
            </div>
            <code class="preview-value">Value: @_radioValue · 独立 Value: @_standaloneRadio</code>
        </div>
    </Preview>
</ComponentPreview>

@code {
    private string? _radioValue = "开发";

    // REV-133: a standalone (ungrouped) Radio renders its checked state from the
    // bound value, so the sample binds one to show the display actually follows it.
    private bool _standaloneRadio = true;

    private bool _radioDisabled;

    private bool _radioRequired;

    private bool _radioInvalid;

    private Size _radioSize = Size.Default;

    private Orientation _radioOrientation = Orientation.Horizontal;

    // Ownership matters here: AriaDescribedBy belongs to Radio, the group-level
    // parameters to RadioGroup (REV-159).
    private static readonly ShowcaseParameter[] RadioParameters =
    [
        new("RadioGroup.Value / ValueChanged", "TValue? / EventCallback<TValue?>", "分组当前值，支持 @bind-Value。"),
        new("RadioGroup.Orientation", "Orientation", "分组布局方向，与 aria-orientation 一致。", "Horizontal"),
        new("RadioGroup.AriaLabel", "string?", "分组无障碍名称。"),
        new("Radio.Value / ValueChanged", "TValue? / EventCallback<TValue?>", "独立 Radio 的绑定值（无分组时显示由它驱动），组内使用时同时作为该选项的值。"),
        new("Radio.ValueExpression", "Expression<Func<TValue?>>?", "独立 Radio 接入 EditContext 校验的字段表达式。"),
        new("Radio.ChildContent", "RenderFragment?", "选项内容。"),
        new("Radio.Size", "Size?", "尺寸档位；未设置时使用分组值，分组也未设置时为 Default。"),
        new("Radio.AriaLabel", "string?", "选项无障碍名称。"),
        new("Radio.AriaDescribedBy", "string?", "仅独立 Radio 提供：与该选项关联的描述元素 id。"),
        new("Radio.Name", "string?", "原生单选组名称；组内一般由 RadioGroup 统一提供。"),
        new("RadioGroup / Radio.Disabled / Required / Invalid", "bool", "分组下发到选项；独立 Radio 也可单独设置。", "false")
    ];
}
