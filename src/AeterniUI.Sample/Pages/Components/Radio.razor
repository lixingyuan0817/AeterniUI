@page "/components/radio"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using System.ComponentModel.DataAnnotations

<PageTitle>Aeterni UI · Radio</PageTitle>

<ComponentPage AnchorId="radio"
               Category="表单组件"
               Title="Radio / RadioGroup"
               ComponentName="RadioGroup&lt;TValue&gt;"
               Description="互斥单选：组负责焦点模型，项只声明自己的值。"
               Related="@RadioRelated">
    <WhenToUse>
        <p>选项少（2～7 个）且互斥时使用：部门、优先级、性别。选项多改用 <code>ComboBox</code>；二态开关用 <code>Switch</code>，少量视图切换用 <code>Segmented</code>。</p>
        <p>如果需要「一个都不选」作为合法状态，把某个选项当成「不限」显式列出来——单选组本身不表达空值。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="radio-group-basic"
                  Title="基础用法"
                  Description="组用单一 Tab 停留点，方向键在选项间移动并即时选中；项只写自己的 Value。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-form-control">
                    <RadioGroup TValue="string" @bind-Value="_department" AriaLabel="部门">
                        <Radio TValue="string" Value="@("设计")">设计</Radio>
                        <Radio TValue="string" Value="@("开发")">开发</Radio>
                        <Radio TValue="string" Value="@("运营")">运营</Radio>
                    </RadioGroup>
                    <code class="preview-value">Value: @_department</code>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="radio-group-layout"
                  Title="方向、尺寸与禁用项"
                  Description="Orientation 决定横排或竖排；禁用项不进入方向键与 Tab 序列。"
                  Code="@LayoutCode">
            <Preview>
                <div class="preview-form-control">
                    <RadioGroup TValue="string" @bind-Value="_layoutValue" Orientation="@_orientation" Size="@_size" AriaLabel="优先级">
                        <Radio TValue="string" Value="@("高")">高</Radio>
                        <Radio TValue="string" Value="@("中")">中</Radio>
                        <Radio TValue="string" Value="@("低")">低</Radio>
                    </RadioGroup>
                    <code class="preview-value">Value: @_layoutValue</code>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Orientation</span>
                    <ShowcaseSelect TValue="Orientation" Id="radio-orientation" AriaLabel="Orientation" Options="@(Enum.GetValues<Orientation>())" @bind-Value="_orientation" />
                </div>
                <div class="control-field">
                    <span>Size</span>
                    <ShowcaseSelect TValue="Size" Id="radio-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                </div>
            </Controls>
        </DemoCard>

        <DemoCard Id="radio-standalone"
                  Title="独立 Radio"
                  Description="脱离组时，Radio 自己就是可调控件：显示由绑定值驱动，布尔之外的语义仍与组内一致。"
                  Code="@StandaloneCode">
            <Preview>
                <div class="preview-stack">
                    <Radio TValue="bool" Value="@_accepted" ValueChanged="HandleAcceptedChanged">我接受许可协议</Radio>
                    <span class="preview-feedback" role="status">已接受：@_accepted</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="radio-group-form"
                  Title="在 FormField 中使用"
                  Description="字段的必填与无效状态会传给组与每个选项，标签指向组的第一个可聚焦项。"
                  Code="@FormCode">
            <Preview>
                <div class="preview-form-control">
                    <FormField Label="部门" Description="提交后由管理员复核。"
                               Disabled="@_formDisabled" Required="@_formRequired" Invalid="@_formInvalid">
                        <RadioGroup TValue="string" @bind-Value="_formValue" AriaLabel="部门">
                            <Radio TValue="string" Value="@("设计")">设计</Radio>
                            <Radio TValue="string" Value="@("开发")">开发</Radio>
                        </RadioGroup>
                    </FormField>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_formRequired">Required</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_formInvalid">Invalid</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_formDisabled">Disabled</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="radio-standalone-form"
                  Title="独立 Radio 与 EditForm"
                  Description="独立 Radio 绑定 ValueExpression 时加入级联 EditContext：checked 按“绑定值等于选项 Value”计算，选择后通知字段变化，校验消息参与无效状态。"
                  Code="@StandaloneFormCode">
            <Preview>
                <EditForm Model="_standaloneForm" OnSubmit="SubmitStandaloneForm">
                    <div class="preview-stack">
                        <div class="preview-state-row" role="group" aria-label="许可协议">
                            <Radio TValue="bool" Value="true" Name="accept-terms"
                                   ValueExpression="@(() => _standaloneForm.AcceptTerms)"
                                   ValueChanged="HandleAcceptTermsAsync">接受</Radio>
                            <Radio TValue="bool" Value="false" Name="accept-terms"
                                   ValueExpression="@(() => _standaloneForm.AcceptTerms)"
                                   ValueChanged="HandleAcceptTermsAsync">不接受</Radio>
                        </div>
                        <ValidationMessage For="@(() => _standaloneForm.AcceptTerms)" />
                        <Button Type="ButtonType.Submit" Size="Size.Small">提交</Button>
                        <span class="preview-feedback" role="status">@_standaloneFormNote</span>
                    </div>
                </EditForm>
            </Preview>
        </DemoCard>
    </Demos>
    <Notes>
        <span>组是单一 Tab 停留点：Tab 进入组内当前选项，方向键在可选项之间移动并选中，Home/End 跳到首尾。</span>
        <span>禁用选项既不响应方向键也不参与 Tab 序列，视觉上使用禁用墨而不是整体降透明度。</span>
        <span>独立 <code>Radio</code> 支持值绑定，组模式下仍由组的 <code>Value</code> 决定选中项——两者不叠加。</span>
        <span>独立形态提供 <code>ValueExpression</code> 时会加入级联 <code>EditContext</code>；只有 <code>Value</code> / <code>ValueChanged</code> 时保留兼容的真值语义。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] RadioRelated =
    [
        new("Checkbox", "/components/checkbox"),
        new("Switch", "/components/switch"),
        new("Segmented", "/components/segmented"),
        new("ComboBox", "/components/combobox")
    ];

    private const string BasicCode = """
        <RadioGroup TValue="string" @bind-Value="Department">
            <Radio TValue="string" Value="@("设计")">设计</Radio>
            <Radio TValue="string" Value="@("开发")">开发</Radio>
        </RadioGroup>
        """;

    private const string LayoutCode = """
        <RadioGroup TValue="string" @bind-Value="Priority"
                    Orientation="Orientation.Horizontal" Size="Size.Large">
            <Radio TValue="string" Value="@("高")">高</Radio>
            <Radio TValue="string" Value="@("中")">中</Radio>
        </RadioGroup>
        """;

    private const string StandaloneCode = """
        <Radio TValue="bool" Value="Accepted" ValueChanged="HandleAcceptedChanged">
            我接受许可协议
        </Radio>
        """;

    private const string StandaloneFormCode = """
        <EditForm Model="Form" OnSubmit="Submit">
            <Radio TValue="bool" Value="true"
                   ValueExpression="@(() => Form.AcceptTerms)"
                   ValueChanged="HandleAcceptTerms">接受</Radio>
            <Radio TValue="bool" Value="false"
                   ValueExpression="@(() => Form.AcceptTerms)"
                   ValueChanged="HandleAcceptTerms">不接受</Radio>
            <ValidationMessage For="@(() => Form.AcceptTerms)" />
        </EditForm>
        """;

    private const string FormCode = """
        <FormField Label="部门" Required>
            <RadioGroup TValue="string" @bind-Value="Department">
                <Radio TValue="string" Value="@("设计")">设计</Radio>
                <Radio TValue="string" Value="@("开发")">开发</Radio>
            </RadioGroup>
        </FormField>
        """;

    private string? _department = "开发";
    private string? _layoutValue = "中";
    private Orientation _orientation = Orientation.Vertical;
    private Size _size = Size.Default;

    private bool _accepted;
    private readonly StandaloneFormModel _standaloneForm = new();
    private string? _standaloneFormNote;

    private sealed class StandaloneFormModel
    {
        [Range(typeof(bool), "true", "true", ErrorMessage = "需要接受许可协议才能继续。")]
        public bool AcceptTerms { get; set; }
    }

    private void HandleAcceptTermsAsync(bool value) => _standaloneForm.AcceptTerms = value;

    private void SubmitStandaloneForm(EditContext context) =>
        _standaloneFormNote = context.Validate() ? "已提交：接受许可协议。" : "提交被校验拦下。";

    private string? _formValue = "开发";
    private bool _formRequired;
    private bool _formInvalid;
    private bool _formDisabled;

    private Task HandleAcceptedChanged(bool value)
    {
        _accepted = value;
        return Task.CompletedTask;
    }
}
