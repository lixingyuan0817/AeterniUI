@page "/components/card"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons
@using AeterniUI.Models.Dialog
@using AeterniUI.Services.Impl

<PageTitle>Aeterni UI · Card</PageTitle>

<ComponentPreview AnchorId="card"
                  Category="基础组件"
                  Title="Card"
                  ComponentName="Card"
                  Description="带有 Header、主体和 Footer 内容区域的结构化容器，也可以切换为整卡交互。预览框内铺了一层背景内容，因为模糊必须有东西可采样才看得出来。">
    <Preview>
        <div class="preview-glass-scene">
            <div class="preview-glass-scene__backdrop" aria-hidden="true"></div>
            <Card Variant="@_cardVariant"
                  Elevation="@_cardElevation"
                  Padding="@_cardPadding"
                  Bordered="@_cardBordered"
                  Interactive="@_cardInteractive"
                  AriaLabel="预览卡片"
                  OnClick="MarkCardInteraction">
                <Header><span class="preview-label">Card / Header</span></Header>
                <ChildContent>
                    <h3 class="preview-card-title">一张可组合的卡片</h3>
                    <p class="preview-card-copy">主体内容可以是任意 RenderFragment。</p>
                </ChildContent>
                <Footer><span class="preview-card-footer">Card / Footer</span></Footer>
            </Card>
        </div>
    </Preview>
    <Controls>
        <div class="control-grid">
            <div class="control-field">
                <span>Variant</span>
                <ShowcaseSelect TValue="SurfaceVariant" Id="card-variant" AriaLabel="Variant" Options="@(Enum.GetValues<SurfaceVariant>())" @bind-Value="_cardVariant" />
            </div>
            <div class="control-field">
                <span>Elevation</span>
                <ShowcaseSelect TValue="SurfaceElevation" Id="card-elevation" AriaLabel="Elevation" Options="@(Enum.GetValues<SurfaceElevation>())" @bind-Value="_cardElevation" />
            </div>
            <div class="control-field">
                <span>Padding</span>
                <ShowcaseSelect TValue="SurfacePadding" Id="card-padding" AriaLabel="Padding" Options="@(Enum.GetValues<SurfacePadding>())" @bind-Value="_cardPadding" />
            </div>
        </div>
        <Checkbox Size="Size.Small" @bind-Value="_cardBordered">Bordered</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_cardInteractive">Interactive</Checkbox>
        <span class="control-status" role="status">@_cardNote</span>
    </Controls>
</ComponentPreview>

@code {
    private SurfaceVariant _cardVariant = SurfaceVariant.Elevated;

    private SurfaceElevation _cardElevation = SurfaceElevation.Small;

    private SurfacePadding _cardPadding = SurfacePadding.Medium;

    private bool _cardBordered = true;

    private bool _cardInteractive = true;

    private string _cardNote = "点击卡片查看 OnClick。";

    private void MarkCardInteraction()
    {
        _cardNote = $"卡片 OnClick 已触发：{DateTime.Now:HH:mm:ss}。";
    }
}
