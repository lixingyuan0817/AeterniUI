@page "/components/accordion"
@layout ComponentsLayout
@using AeterniUI.Enums

<ComponentPreview AnchorId="accordion" Category="基础组件" Title="Accordion" ComponentName="Accordion" Description="支持单开或多开的可访问折叠面板。" Parameters="@Parameters">
    <Preview><Accordion Items="@Items" Multiple="@_multiple" AriaLabel="常见问题" /></Preview>
    <Controls>
        <Checkbox Size="Size.Small" @bind-Value="_multiple">允许同时展开多项</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_disableThird">禁用第三项</Checkbox>
    </Controls>
    <Notes>
        <span>关闭面板会同时退出视觉、Tab 顺序和辅助技术可达范围；可展开第一项后 Tab 到其中的链接，再折叠确认焦点不会重新进入内容。</span>
        <span><code>prefers-reduced-motion: reduce</code> 下关闭高度与箭头过渡。</span>
    </Notes>
</ComponentPreview>
@code {
    private bool _multiple;
    private bool _disableThird = true;

    private IReadOnlyList<AccordionItem> Items =>
    [
        new("first", "什么是 AeterniUI？", @<div><p>AeterniUI 是面向 Blazor 的主题化组件库。</p><a href="#accordion">面板内可聚焦链接</a></div>),
        new("second", "是否支持深色主题？", @<p>支持 System、Light 和 Dark 三种主题模式。</p>),
        new("third", "可以组合使用吗？", @<p>组件可以通过 RenderFragment 和现有布局组件组合。</p>, _disableThird)
    ];

    private static readonly ShowcaseParameter[] Parameters =
    [
        new("Items", "IReadOnlyList<AccordionItem>", "面板 ID、标题、内容与禁用状态。"),
        new("Multiple", "bool", "是否允许同时展开多个面板。", "false"),
        new("OpenKeys / OpenKeysChanged", "IReadOnlyList<string>? / EventCallback", "可选受控展开状态。"),
        new("AriaLabel", "string?", "折叠面板组的无障碍名称。")
    ];
}
