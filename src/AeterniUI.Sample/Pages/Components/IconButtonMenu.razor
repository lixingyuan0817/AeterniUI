@page "/components/icon-button-menu"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Components.IconButtonMenu
@using AeterniUI.Enums
@using AeterniUI.Icons
@using AeterniUI.Icons.FontAwesome

<PageTitle>Aeterni UI · IconButtonMenu</PageTitle>

<ComponentPage AnchorId="icon-button-menu"
               Category="基础组件"
               Title="IconButtonMenu"
               ComponentName="IconButtonMenu"
               Description="图标菜单按钮：一个图标动作按钮下挂一份菜单，适合工具栏与列表行尾的「更多」。"
               Related="@IconButtonMenuRelated">
    <WhenToUse>
        <p>空间只够放一个图标、但动作后面还要挂若干次要命令时使用：工具栏的「更多」、卡片角与列表行尾的操作菜单。</p>
        <p>触发器需要可见文字时用 <code>MenuButton</code>；纯图标且没有菜单时用 <code>IconButton</code>；主按钮与菜单并列时用 <code>SplitButton</code>。</p>
        <p><code>AriaLabel</code> 是必需项：触发器没有可见文字，读屏只能靠这个名字识别菜单动作。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="icon-button-menu-basic"
                  Title="基础用法"
                  Description="点击图标打开菜单，Escape 或外部点击关闭；菜单项由 MenuItem 组成，可以带说明与禁用项。右侧控件即时作用在第一个按钮上，第二个按钮演示 Shape=Square。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-stack">
                    <div class="preview-action-row">
                        <IconButtonMenu Icon="@MoreIcon"
                                        AriaLabel="@_ariaLabel"
                                        Variant="@_variant"
                                        Intent="@_intent"
                                        Size="@_size"
                                        Shape="@_shape"
                                        Placement="@_placement"
                                        Flat="@_flat"
                                        Items="@MenuItems"
                                        OnItemSelected="HandleSelectedAsync" />
                        <IconButtonMenu Icon="@RowMoreIcon"
                                        Variant="ButtonVariant.Outline"
                                        Size="Size.Small"
                                        Shape="IconButtonShape.Square"
                                        AriaLabel="行操作"
                                        Items="@MenuItems"
                                        OnItemSelected="HandleSelectedAsync" />
                    </div>
                    <span class="preview-feedback" role="status">@_status</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <label for="icon-button-menu-label">AriaLabel</label>
                    <input id="icon-button-menu-label" @bind="_ariaLabel" />
                </div>
                <div class="control-grid">
                    <div class="control-field">
                        <span>Variant</span>
                        <ShowcaseSelect TValue="ButtonVariant" Id="icon-button-menu-variant" AriaLabel="Variant" Options="@(Enum.GetValues<ButtonVariant>())" @bind-Value="_variant" />
                    </div>
                    <div class="control-field">
                        <span>Intent</span>
                        <ShowcaseSelect TValue="ButtonIntent" Id="icon-button-menu-intent" AriaLabel="Intent" Options="@(Enum.GetValues<ButtonIntent>())" @bind-Value="_intent" />
                    </div>
                    <div class="control-field">
                        <span>Size</span>
                        <ShowcaseSelect TValue="Size" Id="icon-button-menu-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                    </div>
                    <div class="control-field">
                        <span>Shape</span>
                        <ShowcaseSelect TValue="IconButtonShape" Id="icon-button-menu-shape" AriaLabel="Shape" Options="@(Enum.GetValues<IconButtonShape>())" @bind-Value="_shape" />
                    </div>
                    <div class="control-field">
                        <span>Placement</span>
                        <ShowcaseSelect TValue="PopupPlacement" Id="icon-button-menu-placement" AriaLabel="Placement" Options="@(Enum.GetValues<PopupPlacement>())" @bind-Value="_placement" />
                    </div>
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_flat">Flat（摊平为一份列表）</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="icon-button-menu-flat"
                  Title="扁平与分组"
                  Description="Flat 把各分组的条目按顺序摊平成一份无标题列表，不再输出分组开关与 aria-expanded；不开启时保留 Menu 的折叠分组。"
                  Code="@FlatCode">
            <Preview>
                <div class="preview-action-row">
                    <span>Flat</span>
                    <IconButtonMenu Icon="@MoreIcon"
                                    AriaLabel="更多操作（扁平）"
                                    Flat
                                    Items="@MenuItems"
                                    OnItemSelected="HandleSelectedAsync" />
                    <span>分组</span>
                    <IconButtonMenu Icon="@MoreIcon"
                                    AriaLabel="更多操作（分组）"
                                    Items="@MenuItems"
                                    OnItemSelected="HandleSelectedAsync" />
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="icon-button-menu-controlled"
                  Title="受控打开"
                  Description="绑定 Open/OpenChanged 后开关由宿主决定：示例里的按钮由宿主状态驱动，组件只上报请求。"
                  Code="@ControlledCode">
            <Preview>
                <div class="preview-stack">
                    <div class="preview-action-row">
                        <Button Variant="ButtonVariant.Outline" OnClick="ToggleMenu">@(_menuOpen ? "关闭菜单" : "打开菜单")</Button>
                        <IconButtonMenu Icon="@MoreIcon"
                                        AriaLabel="受控菜单"
                                        Open="_menuOpen"
                                        OpenChanged="SetMenuOpen"
                                        Flat
                                        Items="@MenuItems"
                                        OnItemSelected="HandleSelectedAsync" />
                    </div>
                    <span class="preview-feedback" role="status">菜单状态：@(_menuOpen ? "打开" : "关闭")</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="icon-button-menu-states"
                  Title="禁用与加载"
                  Description="Disabled 锁住整个组合；Loading 让触发器忙碌且不可点击，菜单状态由宿主决定。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-action-row">
                    <IconButtonMenu Icon="@MoreIcon" AriaLabel="已禁用" Disabled Items="@MenuItems" />
                    <IconButtonMenu Icon="@MoreIcon" AriaLabel="正在加载" Loading Items="@MenuItems" />
                </div>
            </Preview>
        </DemoCard>
    </Demos>
    <Notes>
        <span>组合复用现有的 <code>IconButton</code>、<code>PopupHost</code>、<code>Popover</code> 与 <code>Menu</code>：Escape、外部点击、方向键导航、视口翻转与关闭后的焦点回归都沿用它们的行为。</span>
        <span><code>Flat</code> 直接传给 <code>Menu.Flat</code>；弹出层的紧凑留白与 <code>MenuButton</code> 保持一致。</span>
        <span><code>Shape</code> 与 <code>IconButton.Shape</code> 同义：默认圆形（与 <code>IconButton</code> 一致），<code>Square</code> 可切回控件的方角；它只改轮廓，不影响菜单与焦点行为。</span>
        <span><code>Loading</code> 只让触发器忙碌，<code>Disabled</code> 才锁住整体；两者都会在根容器输出 <code>aria-disabled</code>。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] IconButtonMenuRelated =
    [
        new("MenuButton", "/components/menu-button"),
        new("IconButton", "/components/icon-button"),
        new("Menu", "/components/menu"),
        new("SplitButton", "/components/split-button")
    ];

    private const string BasicCode = """
        <IconButtonMenu Icon="@MoreIcon"
                        AriaLabel="更多操作"
                        Items="MenuItems"
                        OnItemSelected="HandleSelected" />
        """;

    private const string FlatCode = """
        <IconButtonMenu Icon="@MoreIcon" AriaLabel="更多操作（扁平）" Flat Items="MenuItems" />
        <IconButtonMenu Icon="@MoreIcon" AriaLabel="更多操作（分组）" Items="MenuItems" />
        """;

    private const string ControlledCode = """
        <IconButtonMenu Icon="@MoreIcon"
                        AriaLabel="受控菜单"
                        Open="MenuOpen"
                        OpenChanged="SetMenuOpen"
                        Items="MenuItems" />
        """;

    private const string StateCode = """
        <IconButtonMenu Icon="@MoreIcon" AriaLabel="已禁用" Disabled Items="MenuItems" />
        <IconButtonMenu Icon="@MoreIcon" AriaLabel="正在加载" Loading Items="MenuItems" />
        """;

    private RenderFragment MoreIcon => @<Icon Definition="@FontAwesomeIcons.Solid.EllipsisVertical" />;
    private RenderFragment RowMoreIcon => @<Icon Definition="@FontAwesomeIcons.Solid.Ellipsis" />;

    private static readonly IReadOnlyList<MenuGroup> MenuItems =
    [
        new("actions", "操作", [
            new MenuItem("edit", "编辑", "修改当前内容"),
            new MenuItem("duplicate", "复制", "创建一个副本"),
            new MenuItem("archive", "归档", "移到归档区", Disabled: true)
        ]),
        new("danger", "危险操作", [
            new MenuItem("delete", "删除", "删除后不可恢复")
        ])
    ];

    private bool _menuOpen;
    private bool _flat;
    private string _status = "尚未选择菜单项";
    private string _ariaLabel = "更多操作";
    private ButtonVariant _variant = ButtonVariant.Ghost;
    private ButtonIntent _intent = ButtonIntent.Neutral;
    private Size _size = Size.Default;
    private IconButtonShape _shape = IconButtonShape.Circle;
    private PopupPlacement _placement = PopupPlacement.BottomEnd;

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void SetMenuOpen(bool open) => _menuOpen = open;

    private Task HandleSelectedAsync(MenuItem item)
    {
        _status = $"已选择：{item.Label}";
        return Task.CompletedTask;
    }
}
