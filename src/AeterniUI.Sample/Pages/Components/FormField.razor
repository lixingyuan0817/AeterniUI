@page "/components/form-field"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · FormField</PageTitle>

<ComponentPage AnchorId="form-field"
               Category="表单组件"
               Title="FormField"
               ComponentName="FormField"
               Description="字段容器：把标签、说明、必填与错误状态集中到一处，并交给内部控件继承。"
               Related="@FormFieldRelated">
    <WhenToUse>
        <p>任何带标签的表单控件都该放进字段里：标签、说明、必填与错误提示一次配好，内部控件自动采用字段的输入 id，标签的 <code>for</code> 因此能点得中。</p>
        <p>库外的原生控件同样可以放进字段：把字段给它的 id 用在控件上，关联与状态继承就成立。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="form-field-basic"
                  Title="基础用法"
                  Description="Label 与 Description 分别生成标签与说明元素；说明通过 aria-describedby 关联到控件。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-form-control">
                    <FormField Label="显示名称" Description="会出现在个人资料页与邮件署名里。">
                        <Input @bind-Value="_name" Placeholder="请输入显示名称" />
                    </FormField>
                    <code class="preview-value">Value: @_name</code>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="form-field-states"
                  Title="必填、无效与错误消息"
                  Description="Required 影响标签上的必填标记与 aria-required；Invalid 与 Error 决定错误文案，内部控件继承无效态。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-form-control">
                    <FormField Label="显示名称"
                               Description="会出现在个人资料页与邮件署名里。"
                               Error="@_error"
                               Required="@_required"
                               Invalid="@_invalid">
                        <Input @bind-Value="_stateName" Placeholder="请输入显示名称" />
                    </FormField>
                    <code class="preview-value">Value: @_stateName</code>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <label for="form-field-error">Error</label>
                    <input id="form-field-error" @bind="_error" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_required">Required</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="form-field-native"
                  Title="包装原生控件"
                  Description="原生控件也能进入字段语义：字段提供 id 与状态，宿主把 id 交给控件即可。"
                  Code="@NativeCode">
            <Preview>
                <div class="preview-form-control">
                    <FormField Label="昵称前缀" Description="原生 input 元素，未使用库内组件。" Required="@_nativeRequired">
                        <input id="form-field-native-input"
                               class="preview-native-input"
                               placeholder="例如 aeterni-"
                               aria-required="@(_nativeRequired ? "true" : null)" />
                    </FormField>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_nativeRequired">Required</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>字段只负责「这组说明属于哪个控件」与状态传递；它不校验、不提交、不请求。</span>
        <span><code>For</code> 把字段与绑定表达式关联起来，配合 <code>EditForm</code> 时校验消息会自动出现在字段的错误区域。</span>
        <span>不要在字段内部再写 <code>Label</code>：一个控件被两个标签指向时，读屏会把两段文字拼成同一个名字。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] FormFieldRelated =
    [
        new("Input", "/components/input"),
        new("Label", "/components/label"),
        new("Checkbox", "/components/checkbox"),
        new("Upload", "/components/upload")
    ];

    private const string BasicCode = """
        <FormField Label="显示名称" Description="会出现在个人资料页与邮件署名里。">
            <Input @bind-Value="Name" />
        </FormField>
        """;

    private const string StateCode = """
        <FormField Label="显示名称" Error="名称已被占用。" Required Invalid>
            <Input @bind-Value="Name" />
        </FormField>
        """;

    private const string NativeCode = """
        <FormField Label="昵称前缀" Description="原生 input 元素。" Required>
            <input id="nickname-prefix" placeholder="例如 aeterni-" />
        </FormField>
        """;

    private string? _name;
    private string? _stateName;
    private string _error = "名称已被占用。";
    private bool _required = true;
    private bool _invalid = true;
    private bool _nativeRequired;
}
