@page "/components/nav-tree"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · NavTree</PageTitle>

<ComponentPage AnchorId="nav-tree"
               Category="导航组件"
               Title="NavTree"
               ComponentName="NavTree"
               Description="可展开的导航树：支持项目/会话层级、选中、键盘导航，以及每个节点右侧的独立操作区。"
               Related="@NavTreeRelated">
    <WhenToUse>
        <p>需要在左侧持续展示“项目 → 会话”这类层级导航时使用。只需要一组动作时用 <code>Menu</code>；需要可切换的内容面板时用 <code>Tabs</code>。</p>
        <p>节点右侧的 <code>Trailing</code> 位于节点按钮之外，可以安全地放动作菜单，不会产生按钮嵌套。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="nav-tree-basic"
                  Title="两级导航"
                  Description="项目节点只负责展开/折叠，点击会话节点才进入选中态；右侧反馈当前会话。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-nav-tree">
                    <NavTree Items="_items"
                             SelectedId="@_selectedId"
                             SelectedIdChanged="HandleSelected"
                             OpenKeys="@_openKeys"
                             OpenKeysChanged="HandleOpenKeysChanged"
                             AriaLabel="项目与会话导航预览" />
                </div>
                <span class="preview-feedback" role="status">当前节点：@(_selectedId ?? "未选择")</span>
            </Preview>
        </DemoCard>

        <DemoCard Id="nav-tree-trailing"
                  Title="节点右侧操作"
                  Description="Trailing 放在节点按钮的兄弟位置，用 AeterniUI PopupHost + Popover + Menu 承载重命名/删除等动作。"
                  Code="@TrailingCode">
            <Preview>
                <div class="preview-nav-tree">
                    <NavTree Items="_actionItems"
                             SelectedId="@_selectedId"
                             SelectedIdChanged="HandleSelected"
                             OpenKeys="@_openKeys"
                             OpenKeysChanged="HandleOpenKeysChanged"
                             OnNodeSelected="HandleNodeSelected"
                             AriaLabel="带操作的项目导航预览" />
                </div>
                <span class="preview-feedback" role="status">@_actionNote</span>
            </Preview>
        </DemoCard>
    </Demos>
    <Notes>
        <span>根元素是 <code>role="tree"</code>，节点是 <code>role="treeitem"</code>；展开状态同步到 <code>aria-expanded</code>，选中状态只出现在叶子节点上（<code>aria-selected</code>）。</span>
        <span>可展开节点是导航组：点击、<code>Enter</code> 与 <code>Space</code> 只切换展开/折叠，不改变选中，也不会触发 <code>SelectedIdChanged</code> / <code>OnNodeSelected</code>。</span>
        <span>树只有一个 Tab 停留点，方向键移动焦点：上下切换节点，右键展开/进入子节点，左键折叠/回到父节点，Home/End 跳到两端。</span>
        <span><code>Trailing</code> 是节点右侧的独立区域，不参与节点按钮的点击；适合放操作菜单、计数或状态标记。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] NavTreeRelated =
    [
        new("Menu", "/components/menu"),
        new("Tabs", "/components/tabs"),
        new("List", "/components/list")
    ];

    private const string BasicCode = """
        <NavTree Items="Items"
                 SelectedId="@selectedId"
                 SelectedIdChanged="OnSelected"
                 OpenKeys="@openKeys"
                 OpenKeysChanged="OnOpenKeysChanged" />
        """;

    private const string TrailingCode = """
        // Trailing is a RenderFragment on the node model; it renders outside
        // the node button, so a PopupHost/Menu trigger is valid here.
        var items = new NavTreeNode[]
        {
            new("project-1", "AeterniWorkbench",
                [new("session", "会话")],
                Trailing: @<ProjectActions />)
        };
        """;

    private string? _selectedId = "workbench-rust";
    private string _actionNote = "在节点右侧选择操作。";
    private System.Collections.Generic.List<string> _openKeys = ["workbench", "aeterni-ui"];

    private IReadOnlyList<NavTreeNode> _items =>
    [
        new("workbench", "AeterniWorkbench",
            [
                new("workbench-rust", "Rust + Tauri 桌面壳", Description: "窗口与工作台布局"),
                new("workbench-ui", "AeterniUI 接入", Description: "组件库与主题")
            ],
            Icon: FolderIcon()),
        new("aeterni-ui", "AeterniUI",
            [
                new("nav-tree", "NavTree 组件", Description: "导航树与 trailing 区域"),
                new("splitter", "Splitter 组件", Description: "可拖动分栏")
            ],
            Icon: FolderIcon()),
        new("aeterni-scheduler", "AeterniScheduler", Icon: FolderIcon())
    ];

    private IReadOnlyList<NavTreeNode> _actionItems =>
        _items.Select(node => node with
        {
            Trailing = Actions(node.Label)
        }).ToArray();

    private static RenderFragment FolderIcon() => @<Icon Definition="@AeterniIcons.EmptyBox" Size="Size.Small" />;

    private RenderFragment Actions(string label) => @<NavTreeActionMenu Label="@label" OnAction="HandleAction" />;

    private void HandleSelected(string id) => _selectedId = id;

    private void HandleOpenKeysChanged(IReadOnlyList<string> keys) => _openKeys = keys.ToList();

    private void HandleNodeSelected(NavTreeNode node) => _actionNote = $"当前项目：{node.Label}";

    private void HandleAction(string action) => _actionNote = $"已选择操作：{action}";
}
