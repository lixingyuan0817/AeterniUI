@page "/components/spinner"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Spinner</PageTitle>

<ComponentPage AnchorId="spinner"
               Category="状态反馈"
               Title="Spinner"
               ComponentName="Spinner"
               Description="独立加载指示器，供内容区、对话框和页面级加载复用。"
               Related="@SpinnerRelated">
    <WhenToUse>
        <p>等待时间未知、放不下百分比时使用：局部内容区刷新、按钮之外的异步等待。有明确进度时用 <code>Progress</code>，整块布局还没到位时用 <code>Skeleton</code>。</p>
        <p>按钮自己的加载态由 <code>Button</code> 的 <code>Loading</code> 承担，不需要在按钮里再放一个 Spinner。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="spinner-sizes"
                  Title="尺寸档位"
                  Description="三档尺寸与文字按钮共用 Token；每个实例都要有自己的 AriaLabel，读屏才知道在等什么。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-state-row">
                    <Spinner Size="Size.Small" AriaLabel="小号加载" />
                    <Spinner AriaLabel="默认加载" />
                    <Spinner Size="Size.Large" AriaLabel="大号加载" />
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="spinner-colors"
                  Title="语意色"
                  Description="命名色取色族的文字形态，Default 继承当前文字色——放在深色底或按钮里时不改颜色也能用。"
                  Code="@ColorCode">
            <Preview>
                <div class="preview-spinner-demo">
                    <div class="preview-state-row">
                        @foreach (var family in ColorFamilies)
                        {
                            var familyLabel = $"{family.Label} 加载";
                            <span class="preview-spinner-cell">
                                <Spinner Color="@family.Color" AriaLabel="@familyLabel" />
                                <span class="preview-value">@family.Label</span>
                            </span>
                        }
                    </div>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="spinner-host"
                  Title="放在内容区与按钮里"
                  Description="宿主容器自己标记 aria-busy，Spinner 只负责视觉与一个可访问名称；右侧控件即时生效。"
                  Code="@HostCode">
            <Preview>
                <div class="preview-spinner-demo">
                    <div class="preview-spinner-host">
                        <Spinner Size="@_spinnerSize" Color="@_spinnerColor" AriaLabel="@_spinnerLabel" />
                        <span>内容区加载中…</span>
                    </div>
                    <Button Loading Size="@_spinnerSize" AriaLabel="加载中的按钮">提交</Button>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Size</span>
                    <ShowcaseSelect TValue="Size" Id="spinner-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_spinnerSize" />
                </div>
                <div class="control-field">
                    <span>Color</span>
                    <ShowcaseSelect TValue="Color" Id="spinner-color" AriaLabel="Color" Options="@(Enum.GetValues<Color>())" @bind-Value="_spinnerColor" />
                </div>
                <div class="control-field">
                    <label for="spinner-label">AriaLabel</label>
                    <input id="spinner-label" @bind="_spinnerLabel" />
                </div>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>根元素输出 <code>role="status"</code>，并始终带一个可访问名称：未传 <code>AriaLabel</code> 时取 <code>AeterniUITextOptions.SpinnerLabel</code>。</span>
        <span>Button 的加载遮罩已经带 <code>aria-busy</code>，因此它内部的 Spinner 处于 <code>aria-hidden</code> 容器中，只做视觉指示。</span>
        <span><code>prefers-reduced-motion</code> 下动画停止，环形保持静止；颜色默认继承当前文字色，命名色取色族的文字形态。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] SpinnerRelated =
    [
        new("Progress", "/components/progress"),
        new("Skeleton", "/components/skeleton"),
        new("Button", "/components/button")
    ];

    private const string BasicCode = """
        <Spinner Size="Size.Small" AriaLabel="小号加载" />
        <Spinner AriaLabel="默认加载" />
        <Spinner Size="Size.Large" AriaLabel="大号加载" />
        """;

    private const string ColorCode = """
        <Spinner Color="Color.Primary" AriaLabel="主色加载" />
        <Spinner Color="Color.Danger" AriaLabel="危险色加载" />
        <Spinner Color="Color.Neutral" AriaLabel="中性色加载" />
        """;

    private const string HostCode = """
        <div aria-busy="true">
            <Spinner AriaLabel="内容区加载中" />
            <span>内容区加载中…</span>
        </div>

        <Button Loading AriaLabel="正在提交">提交</Button>
        """;

    private Size _spinnerSize = Size.Default;

    private Color _spinnerColor = Color.Default;

    private string _spinnerLabel = "内容区加载中";
}
