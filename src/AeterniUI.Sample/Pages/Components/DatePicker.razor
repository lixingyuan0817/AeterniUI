@page "/components/date-picker"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using System.ComponentModel.DataAnnotations
@using AeterniUI.Enums

<PageTitle>Aeterni UI · DatePicker</PageTitle>

<ComponentPage AnchorId="date-picker"
               Category="表单组件"
               Title="DatePicker / DateRangePicker"
               ComponentName="DatePicker / DateRangePicker"
               Description="使用 DateOnly 的单日与范围选择：日历在受控弹层里渲染，支持边界、禁用日期与宿主预设。"
               Related="@DatePickerRelated">
    <WhenToUse>
        <p>挑选某一天用 <code>DatePicker</code>；一段连续区间（报表周期、住宿、结算窗口）用 <code>DateRangePicker</code>，它在同一次操作里选起点与终点。</p>
        <p>日期与时间一起选用 <code>DateTimePicker</code>，只要时间用 <code>TimePicker</code>；校验规则写在宿主的 <code>EditContext</code> / <code>DataAnnotations</code> 上。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="date-picker-presets"
                  Title="日期范围与快捷预设"
                  Description="DateRangePicker 用双月视图一次选出起点与终点；Presets 是宿主提供的快捷范围，组件只校验区间有序、不含被禁用的日期。"
                  Code="@PresetsCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <DateRangePicker @bind-StartDate="_startDate"
                                     @bind-EndDate="_endDate"
                                     Presets="@RangePresets"
                                     PresetsAriaLabel="快捷范围"
                                     VisibleMonths="2"
                                     FullWidth="@_rangeFullWidth"
                                     AriaLabel="选择日期范围" />
                    <span class="preview-feedback" role="status">范围：@RangeText</span>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_rangeFullWidth">FullWidth</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="date-picker-single"
                  Title="单日选择与边界"
                  Description="@@bind-Value 绑定单个 DateOnly；MinDate / MaxDate 收窄可选范围，越界日期保持可见但不可选。"
                  Code="@SingleCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <DatePicker @bind-Value="_date"
                                MinDate="@MinDate"
                                MaxDate="@MaxDate"
                                Size="@_size"
                                FullWidth="@_fullWidth"
                                Disabled="@_disabled"
                                Invalid="@_invalid"
                                AriaLabel="选择日期" />
                    <div class="preview-state-row" aria-label="日期控件尺寸对照">
                        <DatePicker Value="@_date" Size="Size.Small" AriaLabel="小号日期选择" />
                        <DatePicker Value="@_date" AriaLabel="默认日期选择" />
                        <DatePicker Value="@_date" Size="Size.Large" AriaLabel="大号日期选择" />
                    </div>
                    <span class="preview-feedback" role="status">当前日期：@(_date?.ToString(DisplayFormat) ?? "未选择")</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Size</span>
                    <ShowcaseSelect TValue="Size" Id="date-picker-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_fullWidth">FullWidth</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_disabled">Disabled</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="date-picker-lunar"
                  Title="农历叠加"
                  Description="ShowLunar 默认 false；开启后只在日历格内叠加一行中国农历副行，绑定值仍是 DateOnly、触发器格式仍由 Format 决定，公历 1901-02-19 至 2101-01-28 之外不显示农历行。"
                  Code="@LunarCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <DatePicker @bind-Value="_lunarDate"
                                ShowLunar="@_showLunar"
                                AriaLabel="选择农历日期" />
                    <DateRangePicker @bind-StartDate="_lunarStartDate"
                                     @bind-EndDate="_lunarEndDate"
                                     ShowLunar="@_showLunar"
                                     VisibleMonths="2"
                                     AriaLabel="选择农历日期范围" />
                    <span class="preview-feedback" role="status">农历副行：@(_showLunar ? "已开启" : "已关闭")</span>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_showLunar">ShowLunar</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="date-picker-form"
                  Title="在 FormField 中校验"
                  Description="For 指向绑定字段，字段标签、描述与验证消息因此都关联到日期触发器；Required 与 Invalid 决定字段状态。"
                  Code="@FormCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <EditForm Model="_validationModel" OnValidSubmit="HandleValidSubmit">
                        <DataAnnotationsValidator />
                        <FormField Label="预约日期"
                                   Description="选择一个日期后再提交。"
                                   For="@(() => _validationModel.RequiredDate)"
                                   Required="@_formRequired"
                                   Invalid="@_formInvalid">
                            <DatePicker @bind-Value="_validationModel.RequiredDate" AriaLabel="预约日期" />
                        </FormField>
                        <ValidationMessage For="@(() => _validationModel.RequiredDate)" />
                        <Button Type="ButtonType.Submit" Size="Size.Small">验证日期</Button>
                    </EditForm>
                    <span class="preview-feedback" role="status">@(_validationSubmitted ? "日期校验通过。" : "尚未提交。")</span>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_formRequired">Required</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_formInvalid">Invalid</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>值类型是 <code>DateOnly?</code>：单日用 <code>Value</code> / <code>ValueChanged</code>，范围用 <code>StartDate</code> / <code>EndDate</code> 各自的绑定三件套；弹层由 <code>PopupHost</code> 与 <code>Popover</code> 承载。</span>
        <span><code>Presets</code> 是宿主数据：每个范围必须有序、不含被禁用或越界的日期，否则在参数设置阶段直接抛错。</span>
        <span>日历打开后可用方向键、Home/End、PageUp/PageDown 连续移动真实焦点；边界日期保持完整网格，窄屏下多月份视图改为单列。</span>
        <span><code>ShowLunar</code> 默认关闭，开启后只在日历格内叠加中国农历副行：绑定值、触发器格式与选择行为都不变，公历 1901-02-19 至 2101-01-28 之外不显示农历行；副行的无障碍前缀取文案表的 <code>Text.DatePickerLunarLabel</code>。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] DatePickerRelated =
    [
        new("DateTimePicker", "/components/date-time-picker"),
        new("TimePicker", "/components/time-picker"),
        new("FormField", "/components/form-field")
    ];

    private const string PresetsCode = """
        <DateRangePicker @bind-StartDate="Start"
                         @bind-EndDate="End"
                         Presets="RangePresets"
                         PresetsAriaLabel="快捷范围"
                         VisibleMonths="2" />
        """;

    private const string SingleCode = """
        <DatePicker @bind-Value="Date"
                    MinDate="MinDate"
                    MaxDate="MaxDate"
                    Size="Size.Large"
                    FullWidth />
        """;

    private const string LunarCode = """
        <DatePicker @bind-Value="Date" ShowLunar />

        <DateRangePicker @bind-StartDate="Start"
                         @bind-EndDate="End"
                         ShowLunar
                         VisibleMonths="2" />
        """;

    private const string FormCode = """
        <FormField Label="预约日期" For="@(() => Model.RequiredDate)" Required>
            <DatePicker @bind-Value="Model.RequiredDate" />
        </FormField>
        """;

    private const string DisplayFormat = "yyyy-MM-dd";

    private static readonly IReadOnlyList<DateRangePreset> RangePresets = CreateRangePresets();

    private DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _startDate;
    private DateOnly? _endDate;
    private Size _size = Size.Default;
    private bool _fullWidth;

    private bool _rangeFullWidth;
    private bool _disabled;
    private bool _invalid;
    private bool _showLunar = true;
    private DateOnly? _lunarDate = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _lunarStartDate;
    private DateOnly? _lunarEndDate;

    private readonly DateValidationModel _validationModel = new();
    private bool _formRequired = true;
    private bool _formInvalid;
    private bool _validationSubmitted;

    private DateOnly MinDate => _today.AddDays(-90);

    private DateOnly MaxDate => _today.AddDays(90);

    private string RangeText =>
        $"{(_startDate?.ToString(DisplayFormat) ?? "未选择")} – {(_endDate?.ToString(DisplayFormat) ?? "未选择")}";

    private static IReadOnlyList<DateRangePreset> CreateRangePresets()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var quarterStart = new DateOnly(today.Year, ((today.Month - 1) / 3) * 3 + 1, 1);
        return
        [
            new("近 7 天", today.AddDays(-6), today),
            new("本月", new DateOnly(today.Year, today.Month, 1), today),
            new("上季度", quarterStart.AddMonths(-3), quarterStart.AddDays(-1))
        ];
    }

    private void HandleValidSubmit() => _validationSubmitted = true;

    private sealed class DateValidationModel
    {
        [Required(ErrorMessage = "请选择预约日期。")]
        public DateOnly? RequiredDate { get; set; }
    }
}
