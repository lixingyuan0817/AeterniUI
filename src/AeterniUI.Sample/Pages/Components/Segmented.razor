@page "/components/segmented"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Segmented</PageTitle>

<ComponentPage AnchorId="segmented"
               Category="表单组件"
               Title="Segmented"
               ComponentName="Segmented&lt;TValue&gt;"
               Description="少量互斥选项的分段切换，滑块几何与选项数量无关。"
               Related="@SegmentedRelated">
    <WhenToUse>
        <p>2～5 个互斥选项、且切换后立刻改变当前视图或范围时使用：列表/看板切换、时间范围。选项更多用 <code>RadioGroup</code>，切换会替换整块内容用 <code>Tabs</code>。</p>
        <p>分段控件是单选控件而不是导航：它只报告当前值，路由与内容由宿主决定。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="segmented-basic"
                  Title="基础用法"
                  Description="Items 提供选项，ItemTemplate 可以给选项加图标等自定义内容；滑块与激活项位置一致。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-stack">
                    <Segmented TValue="string"
                               Items="@_views"
                               Value="@_view"
                               ValueChanged="SelectView"
                               ItemTemplate="@ViewTemplate"
                               AriaLabel="视图切换" />
                    <span class="preview-value">当前视图：@_view</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="segmented-sizes"
                  Title="尺寸与整宽"
                  Description="三档尺寸共用同一份几何；FullWidth 让分段控件撑满容器，滑块仍按当前项移动。"
                  Code="@SizeCode">
            <Preview>
                <div class="preview-stack">
                    <Segmented TValue="string" Items="@_views" Value="@_view" ValueChanged="SelectView" Size="Size.Small" AriaLabel="小号" />
                    <Segmented TValue="string" Items="@_views" Value="@_view" ValueChanged="SelectView" AriaLabel="默认档" />
                    <Segmented TValue="string" Items="@_views" Value="@_view" ValueChanged="SelectView" Size="Size.Large" AriaLabel="大号" />
                    <Segmented TValue="string" Items="@_views" Value="@_view" ValueChanged="SelectView" FullWidth AriaLabel="整宽" />
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="segmented-shape"
                  Title="形状档位"
                  Description="Shape 提供两档：Rounded 是默认档、圆角跟随尺寸档位（4 / 6 / 8px），Pill 是整圆胶囊。形状只改圆角，滑块宽度与位移仍按选项数量计算，选中位置不受影响。"
                  Code="@ShapeCode">
            <Preview>
                <div class="preview-stack">
                    <Segmented TValue="string"
                               Items="@_views"
                               Value="@_view"
                               ValueChanged="SelectView"
                               Shape="@_shape"
                               AriaLabel="形状档位预览" />
                    <Segmented TValue="string"
                               Items="@_views"
                               Value="@_view"
                               ValueChanged="SelectView"
                               AriaLabel="默认形状（圆角）" />
                    <span class="preview-value">控件作用于第一组，第二组保持默认档作对照。</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Shape</span>
                    <ShowcaseSelect TValue="SegmentedShape"
                                    Id="segmented-shape"
                                    AriaLabel="Shape"
                                    Options="@(Enum.GetValues<SegmentedShape>())"
                                    @bind-Value="_shape" />
                </div>
            </Controls>
        </DemoCard>

        <DemoCard Id="segmented-options"
                  Title="禁选项与非字符串值"
                  Description="TValue 可以是任意类型；DisabledSelector 让个别选项不可选，TextSelector 负责显示文本。"
                  Code="@OptionCode">
            <Preview>
                <div class="preview-stack">
                    <Segmented TValue="int"
                               Items="@_ranges"
                               Value="@_range"
                               ValueChanged="SelectRange"
                               DisabledSelector="IsRangeDisabled"
                               TextSelector="RangeLabel"
                               AriaLabel="评分区间（3 分档不可选）" />
                    <span class="preview-value">当前区间：@RangeLabel(_range)</span>
                </div>
            </Preview>
        </DemoCard>
        <DemoCard Id="segmented-states"
                  Title="在 FormField 中使用"
                  Description="字段的必填与无效状态传给分段控件与每个选项；分段控件不是表单提交控件，是否阻止提交由宿主决定。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-form-control">
                    <FormField Label="计费周期"
                               Description="字段状态会同时作用在分段控件与选项上。"
                               Required="@_formRequired" Invalid="@_formInvalid">
                        <Segmented TValue="string"
                                   Items="@_cycles"
                                   Value="@_cycle"
                                   ValueChanged="SelectCycle"
                                   AriaLabel="计费周期" />
                    </FormField>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_formRequired">Required</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_formInvalid">Invalid</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>选项数量变化时滑块几何按当前项重新计算，2 项与 5 项使用同一套 Token，不需要宿主额外配置。</span>
        <span>形状档位只改圆角：<code>Rounded</code> 是默认档、圆角跟随尺寸档位，<code>Pill</code> 是整圆胶囊；两档都不影响滑块的宽度与位移、交互状态或原生 radio 的键盘模型。</span>
        <span>禁用选项不进入键盘移动范围，也不会被点击选中；键盘用方向键在可选项之间移动，Home/End 跳到两端。</span>
        <span>组件不承载导航语义：它没有 <code>tablist</code> 角色，切换后要替换内容请用 <code>Tabs</code>。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] SegmentedRelated =
    [
        new("Tabs / Tab", "/components/tabs"),
        new("ToggleGroup", "/components/toggle-group"),
        new("Radio / RadioGroup", "/components/radio")
    ];

    private const string BasicCode = """
        <Segmented TValue="string" Items="Views" Value="View" ValueChanged="SelectView" />
        """;

    private const string SizeCode = """
        <Segmented TValue="string" Items="Views" Value="View" ValueChanged="SelectView"
                   Size="Size.Small" />
        <Segmented TValue="string" Items="Views" Value="View" ValueChanged="SelectView" FullWidth />
        """;

    private const string StateCode = """
        <FormField Label="计费周期" Required>
            <Segmented TValue="string" Items="Cycles" Value="Cycle" ValueChanged="SelectCycle" />
        </FormField>
        """;

    private const string OptionCode = """
        <Segmented TValue="int"
                   Items="Ranges"
                   Value="Range"
                   ValueChanged="SelectRange"
                   DisabledSelector="IsRangeDisabled"
                   TextSelector="RangeLabel" />
        """;

    private const string ShapeCode = """
        <Segmented TValue="string" Items="Views" Value="View" ValueChanged="SelectView" />

        <Segmented TValue="string" Items="Views" Value="View" ValueChanged="SelectView"
                   Shape="SegmentedShape.Pill" />
        """;

    private static readonly string[] _views = ["列表", "看板", "时间线"];
    private static readonly int[] _ranges = [1, 2, 3, 4, 5];
    private string _view = "列表";
    private int _range = 2;
    private static readonly string[] _cycles = ["按月", "按季", "按年"];
    private string _cycle = "按月";
    private SegmentedShape _shape = SegmentedShape.Rounded;
    private bool _formRequired = true;
    private bool _formInvalid = true;

    private static bool IsRangeDisabled(int range) => range == 3;

    private static string RangeLabel(int range) => $"{range} 分";

    private Task SelectView(string value)
    {
        _view = value;
        return Task.CompletedTask;
    }

    private Task SelectCycle(string value)
    {
        _cycle = value;
        return Task.CompletedTask;
    }

    private Task SelectRange(int range)
    {
        _range = range;
        return Task.CompletedTask;
    }

    private RenderFragment ViewTemplate(string view) => @<span class="preview-segmented-option">@view</span>;
}
