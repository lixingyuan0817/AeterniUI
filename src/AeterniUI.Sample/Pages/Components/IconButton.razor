@page "/components/icon-button"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · IconButton</PageTitle>

<ComponentPage AnchorId="icon-button"
               Category="基础组件"
               Title="IconButton"
               ComponentName="IconButton"
               Description="图标按钮：只有图标的动作按钮，无障碍名称由 AriaLabel 提供。"
               Related="@IconButtonRelated">
    <WhenToUse>
        <p>动作的图标比文字更直观、且位置紧张时使用：工具栏、卡片角、列表行尾。动作需要文字说明时用 <code>Button</code>。</p>
        <p><code>AriaLabel</code> 是必需项：没有可见文字，读屏只能靠这个名字识别动作。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="icon-button-basic"
                  Title="基础用法"
                  Description="默认是 Ghost + Neutral，适合工具栏与低强调动作；每个按钮都要给出自己的无障碍名称。右侧控件即时作用在第一个按钮上。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-stack">
                    <div class="preview-action-row">
                        <IconButton Variant="@_variant"
                                    Intent="@_intent"
                                    Size="@_size"
                                    Icon="@SearchIcon"
                                    AriaLabel="@_ariaLabel"
                                    OnClick="MarkInteraction" />
                        <IconButton Variant="ButtonVariant.Outline" Icon="@SettingsIcon" AriaLabel="设置" OnClick="MarkInteraction" />
                        <IconButton Variant="ButtonVariant.Soft" Intent="ButtonIntent.Warning" Icon="@InfoIcon" AriaLabel="查看警告" OnClick="MarkInteraction" />
                    </div>
                    <span class="preview-feedback" role="status">@_interactionNote</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <label for="icon-button-label">AriaLabel</label>
                    <input id="icon-button-label" @bind="_ariaLabel" />
                </div>
                <div class="control-grid">
                    <div class="control-field">
                        <span>Variant</span>
                        <ShowcaseSelect TValue="ButtonVariant" Id="icon-button-variant" AriaLabel="Variant" Options="@(Enum.GetValues<ButtonVariant>())" @bind-Value="_variant" />
                    </div>
                    <div class="control-field">
                        <span>Intent</span>
                        <ShowcaseSelect TValue="ButtonIntent" Id="icon-button-intent" AriaLabel="Intent" Options="@(Enum.GetValues<ButtonIntent>())" @bind-Value="_intent" />
                    </div>
                    <div class="control-field">
                        <span>Size</span>
                        <ShowcaseSelect TValue="Size" Id="icon-button-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                    </div>
                </div>
            </Controls>
        </DemoCard>

        <DemoCard Id="icon-button-chrome"
                  Title="chrome 预设：形状、墨阶与紧凑尺寸"
                  Description="标题栏与行尾动作使用 chrome 预设：Shape 换成圆形、Tone 接管表面与墨色、Compact 把盒子收到 24px。Tone 会覆盖 Variant/Intent 的配色，几何、加载、禁用与焦点环都不变。右侧控件即时作用在中间按钮上。"
                  Code="@ChromeCode">
            <Preview>
                <div class="preview-stack">
                    <div class="preview-action-row">
                        <IconButton Shape="IconButtonShape.Circle"
                                    Tone="IconButtonTone.DangerTinted"
                                    Icon="@XmarkIcon"
                                    AriaLabel="关闭窗口"
                                    OnClick="MarkInteraction" />
                        <IconButton Shape="@_chromeShape"
                                    Tone="@_chromeTone"
                                    Compact="@_compact"
                                    Icon="@EllipsisIcon"
                                    AriaLabel="更多操作"
                                    OnClick="MarkInteraction" />
                        <IconButton Tone="IconButtonTone.Muted"
                                    Icon="@InfoIcon"
                                    AriaLabel="静默提示"
                                    OnClick="MarkInteraction" />
                    </div>
                    <span class="preview-feedback" role="status">@_interactionNote</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-grid">
                    <div class="control-field">
                        <span>Shape</span>
                        <ShowcaseSelect TValue="IconButtonShape" Id="icon-button-shape" AriaLabel="Shape" Options="@(Enum.GetValues<IconButtonShape>())" @bind-Value="_chromeShape" />
                    </div>
                    <div class="control-field">
                        <span>Tone</span>
                        <ShowcaseSelect TValue="IconButtonTone" Id="icon-button-tone" AriaLabel="Tone" Options="@(Enum.GetValues<IconButtonTone>())" @bind-Value="_chromeTone" />
                    </div>
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_compact">紧凑尺寸（24px）</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="icon-button-states"
                  Title="尺寸、加载与禁用"
                  Description="三档尺寸与文字按钮共用 Token；加载时只保留忙碌指示并输出 aria-busy，禁用态不进入 Tab 序列。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-action-row">
                    <IconButton Size="Size.Small" Icon="@SearchIcon" AriaLabel="小号搜索" OnClick="MarkInteraction" />
                    <IconButton Icon="@SearchIcon" AriaLabel="默认搜索" OnClick="MarkInteraction" />
                    <IconButton Size="Size.Large" Icon="@SearchIcon" AriaLabel="大号搜索" OnClick="MarkInteraction" />
                    <IconButton Loading Icon="@SettingsIcon" AriaLabel="正在保存" />
                    <IconButton Disabled Icon="@InfoIcon" AriaLabel="已禁用" />
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="icon-button-form"
                  Title="表单提交"
                  Description="Type 与文字按钮同一套映射：默认 Button 不会误提交，放进表单提交需显式写 Submit。"
                  Code="@FormCode">
            <Preview>
                <form method="post" @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                    <div class="preview-action-row">
                        <IconButton Type="ButtonType.Submit" Variant="ButtonVariant.Outline" Icon="@CheckIcon" AriaLabel="提交表单" />
                        <IconButton Type="ButtonType.Reset" Icon="@XmarkIcon" AriaLabel="重置表单" />
                    </div>
                </form>
                <span class="preview-feedback" role="status">@_interactionNote</span>
            </Preview>
        </DemoCard>
    </Demos>
    <Notes>
        <span>默认变体是 <code>Ghost + Neutral</code>，可用 <code>Variant</code> / <code>Intent</code> 改成与文字按钮一致的强调层级。</span>
        <span><code>Tone</code> 是 chrome 预设：<code>Muted</code> / <code>DangerTinted</code> 接管表面、描边与墨色，因此覆盖 <code>Variant</code> / <code>Intent</code> 的配色；不传时保持默认的变体与语意色。</span>
        <span><code>Compact</code> 只把盒子收到 24px、字形收到 14px，并优先于 <code>Size</code>；<code>Shape=Circle</code> 使用全圆角，适合标题栏的圆形动作。</span>
        <span>加载态只显示 Spinner 并输出 <code>aria-busy</code>；禁用态使用禁用墨，不整块降低透明度。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] IconButtonRelated =
    [
        new("Button", "/components/button"),
        new("MenuButton", "/components/menu-button"),
        new("Toolbar", "/components/toolbar")
    ];

    private const string BasicCode = """
        <IconButton Icon="SearchIcon" AriaLabel="搜索" OnClick="HandleSearch" />
        <IconButton Variant="ButtonVariant.Outline" Icon="SettingsIcon" AriaLabel="设置" />
        """;

    private const string ChromeCode = """
        <IconButton Shape="IconButtonShape.Circle" Tone="IconButtonTone.DangerTinted"
                    Icon="XmarkIcon" AriaLabel="关闭窗口" />
        <IconButton Tone="IconButtonTone.Muted" Compact Icon="EllipsisIcon" AriaLabel="更多操作" />
        """;

    private const string StateCode = """
        <IconButton Size="Size.Large" Icon="SearchIcon" AriaLabel="搜索" />
        <IconButton Loading Icon="SettingsIcon" AriaLabel="正在保存" />
        <IconButton Disabled Icon="InfoIcon" AriaLabel="已禁用" />
        """;

    private const string FormCode = """
        <form method="post" @onsubmit="HandleSubmit">
            <IconButton Type="ButtonType.Submit" Icon="CheckIcon" AriaLabel="提交表单" />
        </form>
        """;

    private RenderFragment SearchIcon => @<Icon Definition="@AeterniIcons.MagnifyingGlass" />;
    private RenderFragment SettingsIcon => @<Icon Definition="@AeterniIcons.Plus" />;
    private RenderFragment InfoIcon => @<Icon Definition="@AeterniIcons.Info" />;
    private RenderFragment CheckIcon => @<Icon Definition="@AeterniIcons.Check" />;
    private RenderFragment XmarkIcon => @<Icon Definition="@AeterniIcons.Xmark" />;
    private RenderFragment EllipsisIcon => @<Icon Definition="@FontAwesomeIcons.Solid.EllipsisVertical" />;

    private ButtonVariant _variant = ButtonVariant.Ghost;
    private ButtonIntent _intent = ButtonIntent.Neutral;
    private Size _size = Size.Default;
    private string _ariaLabel = "搜索";
    private IconButtonShape _chromeShape = IconButtonShape.Square;
    private IconButtonTone _chromeTone = IconButtonTone.Muted;
    private bool _compact = true;

    private void HandleSubmit() => MarkInteraction(new MouseEventArgs());
}
