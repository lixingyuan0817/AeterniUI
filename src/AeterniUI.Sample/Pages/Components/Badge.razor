@page "/components/badge"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · Badge</PageTitle>

<ComponentPage AnchorId="badge"
               Category="基础组件"
               Title="Badge"
               ComponentName="Badge"
               Description="贴在图标、头像或按钮右上角的数字或圆点角标，位置随书写方向镜像。"
               Related="@BadgeRelated">
    <WhenToUse>
        <p>需要在不打断布局的前提下提示数量或"有新内容"时使用：未读消息、待办数量、构建结果。要表达一段文字性的状态用 <code>Tag</code>，要展示身份图形用 <code>Avatar</code>。</p>
        <p>角标只画指示器本身：被附着的按钮、图标或头像仍由各自的组件渲染，锚点用不用表面也留在锚点上。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="badge-basic"
                  Title="数字与圆点"
                  Description="Count 给出数字，Dot 只画一个圆点并忽略 Count；两者都没给时不渲染任何指示器，显式的 0 会显示为 0。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-badge-demo">
                    <div class="preview-state-row">
                        <Badge Count="3">
                            <Button Variant="ButtonVariant.Outline" Color="Color.Neutral" AriaLabel="通知" StartIcon="@NotifyIcon" OnClick="MarkInteraction" />
                        </Badge>
                        <Badge Dot AriaLabel="有新的构建结果">
                            <Icon Definition="@AeterniIcons.Star" Size="Size.Large" Color="Color.Warning" AriaLabel="收藏" />
                        </Badge>
                        <Badge Count="0">
                            <Surface Class="preview-badge-avatar">AU</Surface>
                        </Badge>
                    </div>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="badge-colors"
                  Title="语意色与上限"
                  Description="Color 决定指示器填充；Count 超过 Max 时显示成 {Max}+，这里 Max 为 99 而 Count 为 120。"
                  Code="@ColorCode">
            <Preview>
                <div class="preview-badge-demo">
                    <div class="preview-state-row">
                        @foreach (var family in ColorFamilies)
                        {
                            <span class="preview-badge-cell">
                                <Badge Count="120" Max="99" Color="@family.Color">
                                    <Surface Class="preview-badge-avatar">AU</Surface>
                                </Badge>
                                <span class="preview-value">@family.Label</span>
                            </span>
                        }
                    </div>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="badge-controls"
                  Title="Count、Max 与可访问名称"
                  Description="AriaLabel 在数字模式下替换裸数字，留空则读出数字本身；Max 是完整显示的上限。右侧控件即时生效。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-badge-demo">
                    <div class="preview-state-row">
                        <Badge Count="@_badgeCount" Max="@_badgeMax" Color="@_badgeColor" AriaLabel="@_badgeAriaLabel">
                            <Button Variant="ButtonVariant.Outline" Color="Color.Neutral" AriaLabel="通知" StartIcon="@NotifyIcon" OnClick="MarkInteraction" />
                        </Badge>
                        <Badge Count="@_badgeCount" Max="@_badgeMax" Color="@_badgeColor">
                            <Surface Class="preview-badge-avatar">AU</Surface>
                        </Badge>
                    </div>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <label for="badge-count">Count</label>
                    <input id="badge-count" type="number" min="0" max="999" @bind="_badgeCount" />
                </div>
                <div class="control-field">
                    <label for="badge-max">Max</label>
                    <input id="badge-max" type="number" min="1" max="999" @bind="_badgeMax" />
                </div>
                <div class="control-field">
                    <span>Color</span>
                    <ShowcaseSelect TValue="Color" Id="badge-color" AriaLabel="Color" Options="@(Enum.GetValues<Color>())" @bind-Value="_badgeColor" />
                </div>
                <div class="control-field">
                    <label for="badge-label">AriaLabel</label>
                    <input id="badge-label" placeholder="留空则读出数字本身" @bind="_badgeAriaLabel" />
                </div>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span><code>Count</code> 为 <code>null</code> 且未开启 <code>Dot</code> 时不渲染角标；显式的 0 会显示为 0，两者语义不同。</span>
        <span>超过 <code>Max</code> 的数字显示为 <code>99+</code> 这类形式；圆点没有可见文字，因此可访问名称作为视觉隐藏文本输出，缺省取 <code>AeterniUITextOptions.BadgeLabel</code>。</span>
        <span>角标用逻辑定位属性贴在右上角，RTL 下自动镜像；<code>Count</code> 为负或 <code>Max</code> 小于 1 会在参数设置阶段抛出 <code>ArgumentOutOfRangeException</code>。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] BadgeRelated =
    [
        new("Avatar", "/components/avatar"),
        new("Icon", "/components/icon"),
        new("Tag", "/components/tag")
    ];

    private const string BasicCode = """
        <Badge Count="3">
            <Button AriaLabel="通知" StartIcon="BellIcon" />
        </Badge>
        <Badge Dot AriaLabel="有新的构建结果">
            <Icon Definition="StarIcon" />
        </Badge>
        """;

    private const string ColorCode = """
        <Badge Count="120" Max="99" Color="Color.Danger">
            <Avatar Name="Ada Lovelace" />
        </Badge>
        """;

    private const string StateCode = """
        <Badge Count="UnreadCount" Max="99" Color="Color.Danger" AriaLabel="未读消息">
            <Button AriaLabel="通知">消息</Button>
        </Badge>
        """;

    private int? _badgeCount = 99;

    private int _badgeMax = 99;

    private Color _badgeColor = Color.Danger;

    private string? _badgeAriaLabel = "99 条未读消息";

    // The bell goes through Button.StartIcon: an <Icon> element inside Button's own
    // child content resolves to Button's legacy Icon parameter, not the component.
    private RenderFragment NotifyIcon => @<Icon Definition="@FontAwesomeIcons.Solid.Bell" />;
}
