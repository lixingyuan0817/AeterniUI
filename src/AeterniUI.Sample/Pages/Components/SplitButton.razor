@page "/components/split-button"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Components.Menu
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · SplitButton</PageTitle>

<ComponentPage AnchorId="split-button"
               Category="基础组件"
               Title="SplitButton"
               ComponentName="SplitButton"
               Description="分裂按钮：主动作与同族次要动作并列，两半各自可点。"
               Related="@SplitButtonRelated">
    <WhenToUse>
        <p>一个动作是主路径、另有若干同族变体时使用：保存 / 另存为、导出 / 导出为 PDF。主次动作不同族时分别用 <code>Button</code> 与 <code>MenuButton</code>。</p>
        <p>两半的禁用与加载分开控制：主动作忙碌不该连菜单一起锁住，反之亦然。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="split-button-basic"
                  Title="基础用法"
                  Description="左半执行主动作并回调 OnClick，右半打开菜单并回调 OnItemSelected；两半共用变体与尺寸。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-stack">
                    <SplitButton Label="保存"
                                 MenuAriaLabel="保存到其它位置"
                                 Items="@MenuItems"
                                 OnClick="HandlePrimaryAsync"
                                 OnItemSelected="HandleSelectedAsync" />
                    <span class="preview-feedback" role="status">@_status</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="split-button-states"
                  Title="分开的禁用与加载"
                  Description="PrimaryDisabled 只锁主动作，MenuDisabled 只锁菜单，Loading 表示主动作正在执行。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-stack">
                    <SplitButton Label="主动作禁用" MenuAriaLabel="主动作禁用的菜单" PrimaryDisabled Items="@MenuItems" OnClick="HandlePrimaryAsync" OnItemSelected="HandleSelectedAsync" />
                    <SplitButton Label="菜单禁用" MenuAriaLabel="已禁用的菜单" MenuDisabled Items="@MenuItems" OnClick="HandlePrimaryAsync" OnItemSelected="HandleSelectedAsync" />
                    <SplitButton Label="主动作忙碌" MenuAriaLabel="保存到其它位置" Loading Items="@MenuItems" OnClick="HandlePrimaryAsync" OnItemSelected="HandleSelectedAsync" />
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="split-button-controlled"
                  Title="受控打开与语意"
                  Description="Open/OpenChanged 让宿主掌握菜单开关；菜单的无障碍名称可以由 MenuAriaLabel 单独指定。"
                  Code="@ControlledCode">
            <Preview>
                <div class="preview-stack">
                    <div class="preview-action-row">
                        <Button Variant="ButtonVariant.Outline" OnClick="ToggleMenu">@(_menuOpen ? "关闭菜单" : "打开菜单")</Button>
                        <SplitButton Label="导出"
                                     Intent="ButtonIntent.Neutral"
                                     MenuAriaLabel="导出为其它格式"
                                     Open="_menuOpen"
                                     OpenChanged="SetMenuOpen"
                                     Items="@MenuItems"
                                     OnClick="HandlePrimaryAsync"
                                     OnItemSelected="HandleSelectedAsync" />
                    </div>
                    <span class="preview-feedback" role="status">菜单状态：@(_menuOpen ? "打开" : "关闭")</span>
                </div>
            </Preview>
        </DemoCard>
    </Demos>
    <Notes>
        <span>两半是各自独立的按钮：键盘可以用 Tab 分别到达，方向键不会在它们之间移动焦点。</span>
        <span><code>Loading</code> 只作用在主动作上，菜单仍然可以打开；需要整体禁用时同时给 <code>PrimaryDisabled</code> 与 <code>MenuDisabled</code>。</span>
        <span>菜单沿用 <code>Popover</code> + <code>Menu</code> 的行为：Escape、外部点击、键盘导航与视口翻转。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] SplitButtonRelated =
    [
        new("MenuButton", "/components/menu-button"),
        new("ButtonGroup", "/components/button-group"),
        new("Button", "/components/button")
    ];

    private const string BasicCode = """
        <SplitButton Label="保存" Items="MenuItems"
                     OnClick="HandlePrimary" OnItemSelected="HandleSelected" />
        """;

    private const string StateCode = """
        <SplitButton Label="主动作禁用" PrimaryDisabled Items="MenuItems" />
        <SplitButton Label="菜单禁用" MenuDisabled Items="MenuItems" />
        """;

    private const string ControlledCode = """
        <SplitButton Label="导出" Open="MenuOpen" OpenChanged="SetMenuOpen" Items="MenuItems"
                     MenuAriaLabel="导出为其它格式" />
        """;

    private bool _menuOpen;
    private string _status = "尚未触发动作";

    private static readonly IReadOnlyList<MenuGroup> MenuItems =
    [
        new("formats", "导出格式", [
            new MenuItem("pdf", "PDF", "适合打印"),
            new MenuItem("csv", "CSV", "适合表格处理"),
            new MenuItem("xlsx", "XLSX", "保留公式")
        ])
    ];

    private void ToggleMenu() => _menuOpen = !_menuOpen;

    private void SetMenuOpen(bool open) => _menuOpen = open;

    private Task HandlePrimaryAsync()
    {
        _status = "已执行主动作。";
        return Task.CompletedTask;
    }

    private Task HandleSelectedAsync(MenuItem item)
    {
        _status = $"已选择：{item.Label}";
        return Task.CompletedTask;
    }
}
