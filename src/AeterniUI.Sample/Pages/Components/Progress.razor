@page "/components/progress"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Progress</PageTitle>

<ComponentPage AnchorId="progress"
               Category="状态反馈"
               Title="Progress"
               ComponentName="Progress"
               Description="线性进度条：确定进度给 Value，时长未知时用不确定态。"
               Related="@ProgressRelated">
    <WhenToUse>
        <p>任务有明确进度时使用：上传、导入、逐步安装。只有“还在转”、没有百分比时用 <code>Spinner</code>；整块内容等待占位用 <code>Skeleton</code>。</p>
        <p>进度条只读，不承担交互：需要用户自己拖动取值时用 <code>Slider</code>。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="progress-basic"
                  Title="基础用法"
                  Description="Value 是当前值、Max 是总量（默认 100）；ShowValue 在确定态下把百分比渲染成文本。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-stack">
                    <Progress Value="68" ShowValue AriaLabel="上传进度" />
                    <Progress Value="3" Max="8" AriaLabel="步骤进度" />
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="progress-colors"
                  Title="语意色对照"
                  Description="同一个数值在五个语意色下各一条，最后一条是时长未知时的不确定态。"
                  Code="@ColorCode">
            <Preview>
                <div class="preview-stack">
                    @foreach (var color in ProgressColors)
                    {
                        var colorLabel = $"{color} 进度";
                        <Progress Value="68" Color="@color" Size="Size.Small" AriaLabel="@colorLabel" />
                    }
                    <Progress Indeterminate Color="Color.Info" AriaLabel="处理中" />
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="progress-states"
                  Title="数值、尺寸与不确定态"
                  Description="右侧控件即时生效：勾上 Indeterminate 后百分比文本消失，改为扫动动画。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-stack">
                    <Progress Value="@_progressValue"
                              Max="@_progressMax"
                              Color="@_progressColor"
                              Size="@_progressSize"
                              ShowValue="@_progressShowValue"
                              Indeterminate="@_progressIndeterminate"
                              AriaLabel="完成进度" />
                    <span class="preview-feedback" role="status">Value：@(_progressValue) / Max：@(_progressMax)</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <label for="progress-value">Value</label>
                    <input id="progress-value" type="range" min="0" max="100" step="1" @bind="_progressValue" />
                </div>
                <div class="control-field">
                    <span>Color</span>
                    <ShowcaseSelect TValue="Color" Id="progress-color" AriaLabel="Color" Options="@(Enum.GetValues<Color>())" @bind-Value="_progressColor" />
                </div>
                <div class="control-field">
                    <span>Size</span>
                    <ShowcaseSelect TValue="Size" Id="progress-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_progressSize" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_progressShowValue">ShowValue</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_progressIndeterminate">Indeterminate</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>根元素输出 <code>role="progressbar"</code> 与 <code>aria-valuemin</code> / <code>aria-valuemax</code>；<code>Indeterminate</code> 或没有 <code>Value</code> 时不输出 <code>aria-valuenow</code>，读屏只播报忙碌。</span>
        <span><code>Value</code> 会被夹到 <code>[0, Max]</code>；<code>Max</code> 必须是正的有限数，<code>Value</code> 不能是 <code>NaN</code> 或无穷大，越界在参数设置阶段抛异常而不是静默截断。</span>
        <span>不确定态由 CSS 动画扫动，<code>prefers-reduced-motion</code> 下停止；百分比文本只在确定态且 <code>Value</code> 有值时渲染，所以勾上 <code>Indeterminate</code> 后它就会消失。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] ProgressRelated =
    [
        new("Spinner", "/components/spinner"),
        new("Skeleton", "/components/skeleton"),
        new("Slider", "/components/slider")
    ];

    private static readonly Color[] ProgressColors =
        [Color.Primary, Color.Success, Color.Warning, Color.Danger, Color.Info];

    private const string BasicCode = """
        <Progress Value="68" ShowValue AriaLabel="上传进度" />
        <Progress Value="3" Max="8" AriaLabel="步骤进度" />
        """;

    private const string ColorCode = """
        <Progress Value="68" Color="Color.Success" Size="Size.Small" AriaLabel="成功进度" />
        <Progress Value="68" Color="Color.Danger" Size="Size.Small" AriaLabel="危险进度" />
        <Progress Indeterminate Color="Color.Info" AriaLabel="处理中" />
        """;

    private const string StateCode = """
        <Progress Value="@Percent"
                  Max="@Total"
                  Color="Color.Primary"
                  Size="Size.Large"
                  ShowValue
                  Indeterminate="@IsUnknown"
                  AriaLabel="完成进度" />
        """;

    private double _progressValue = 68;

    private double _progressMax = 100;

    private Color _progressColor = Color.Primary;

    private Size _progressSize = Size.Default;

    private bool _progressShowValue = true;

    private bool _progressIndeterminate;
}
