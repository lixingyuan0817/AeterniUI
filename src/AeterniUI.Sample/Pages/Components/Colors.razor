    </div>

    <h2 class="showcase-colors__subtitle">间距节奏</h2>
    <p class="showcase-install__note showcase-colors__note">间距是一条 4px 基数的阶梯，组件内部只消费 <code>--aeterni-spacing-*</code>；示例页与业务页也复用同一条，避免出现第二套间距。</p>
    <div class="showcase-colors__spacing">
        <div class="showcase-colors__spacing-row">
            <code>--aeterni-spacing-1</code>
            <span class="showcase-colors__spacing-bar showcase-colors__spacing-bar--1"></span>
            <span>4px</span>
        </div>
        <div class="showcase-colors__spacing-row">
            <code>--aeterni-spacing-2</code>
            <span class="showcase-colors__spacing-bar showcase-colors__spacing-bar--2"></span>
            <span>8px</span>
        </div>
        <div class="showcase-colors__spacing-row">
            <code>--aeterni-spacing-3</code>
            <span class="showcase-colors__spacing-bar showcase-colors__spacing-bar--3"></span>
            <span>12px</span>
        </div>
        <div class="showcase-colors__spacing-row">
            <code>--aeterni-spacing-4</code>
            <span class="showcase-colors__spacing-bar showcase-colors__spacing-bar--4"></span>
            <span>16px</span>
        </div>
        <div class="showcase-colors__spacing-row">
            <code>--aeterni-spacing-6</code>
            <span class="showcase-colors__spacing-bar showcase-colors__spacing-bar--6"></span>
            <span>24px</span>
        </div>
        <div class="showcase-colors__spacing-row">
            <code>--aeterni-spacing-8</code>
            <span class="showcase-colors__spacing-bar showcase-colors__spacing-bar--8"></span>
            <span>32px</span>
        </div>
        <div class="showcase-colors__spacing-row">
            <code>--aeterni-spacing-12</code>
            <span class="showcase-colors__spacing-bar showcase-colors__spacing-bar--12"></span>
            <span>48px</span>
        </div>
    </div>

    <h2 class="showcase-colors__subtitle">对比度验收组合</h2>
    <p class="showcase-install__note showcase-colors__note">下表是品牌色层真正会被验收的 Token 组合与门槛：正文与填充控件里的标签走 4.5:1，图标、描边与聚焦环走 3:1（非文本对比度）。品牌色是可替换的色相层，因此换一层色板就可能跌破门槛——这也正是下表每一组都由 CI 门禁实测而不是靠肉眼确认的原因。</p>
    <div class="showcase-colors__table">
        <div class="showcase-colors__table-row showcase-colors__table-row--head">
            <span>用法</span><span>前景 Token</span><span>背景 Token</span><span>门槛</span>
        </div>
        @foreach (var check in ContrastChecks)
        {
            <div class="showcase-colors__table-row">
                <span>@check.Usage</span>
                <span><code>@check.Foreground</code></span>
                <span><code>@check.Background</code></span>
                <span>@check.Floor</span>
            </div>
        }
    </div>
    <p class="showcase-install__note showcase-colors__note">
        <code>node scripts/check-contrast.mjs</code> 会在每个品牌色相层上重放浅色、深色与系统深色三种状态，解析 <code>var()</code> 链并实测上表每一组；余量低于 1.1× 的色相层必须把实测对比度写进自己的注释块，否则门禁失败。语意色族（success / warning / danger / info）沿用同一套形态与门槛约定，需要时按同样方式补测。
    </p>
</section>

@code {
    /// <summary>对比度验收组合，与 <c>scripts/check-contrast.mjs</c> 的 PAIRS 和门槛一一对应。</summary>
    private static readonly ContrastBaseline[] ContrastChecks =
    [
        new("实心品牌填充上的标签", "--aeterni-text-inverse", "--aeterni-color-brand-default / -hover / -active", "≥ 4.5:1"),
        new("品牌文字与链接", "--aeterni-color-brand-text / --aeterni-text-link", "--aeterni-bg / --aeterni-bg-surface", "≥ 4.5:1"),
        new("品牌文字在着色表面", "--aeterni-color-brand-text", "--aeterni-bg-tertiary", "≥ 4.5:1"),
        new("品牌描边与图标", "--aeterni-color-brand-default", "--aeterni-bg / --aeterni-bg-surface", "≥ 3:1"),
        new("聚焦环", "--aeterni-state-color-focus", "--aeterni-bg-surface", "≥ 3:1")
    ];

    /// <summary>对比度验收组合的一行。</summary>
    private sealed record ContrastBaseline(string Usage, string Foreground, string Background, string Floor);
}
