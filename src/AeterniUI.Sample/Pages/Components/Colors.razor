                <div class="showcase-colors__swatch">
                    <span class="showcase-colors__swatch-fill showcase-colors__swatch-fill--soft">Soft</span>
                    <span class="showcase-colors__swatch-meta">
                        <span class="showcase-colors__swatch-variant">柔和底</span>
                        <code>--aeterni-color-brand-soft</code>
                    </span>
                </div>
            </div>
        </article>

