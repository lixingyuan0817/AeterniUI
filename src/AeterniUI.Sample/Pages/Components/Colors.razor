                    <span class="showcase-colors__swatch-meta">
                        <span class="showcase-colors__swatch-variant">柔和底</span>
                        <code>--aeterni-color-brand-soft</code>
                    </span>
                </div>
            </div>
        </article>

        <article class="showcase-colors__card" data-family="success">
