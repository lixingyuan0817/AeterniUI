@page "/components/theme"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons
@using AeterniUI.Models.Dialog
@using AeterniUI.Services.Impl

<PageTitle>Aeterni UI · ThemeProvider + ThemeSwitch</PageTitle>

<ComponentPreview AnchorId="theme"
                  Category="主题组件"
                  Title="ThemeProvider + ThemeSwitch"
                  ComponentName="ThemeProvider / ThemeSwitch / ThemeBrandSwitch"
                  Description="ThemeProvider 负责主题生命周期，ThemeSwitch 提供 System、Light、Dark 三种模式切换，ThemeBrandSwitch 在紫罗兰、绿色和焦橙三套品牌色层之间切换。"
                  Parameters="@ThemeParameters"
                  Events="@ThemeEvents"
                  Contracts="@ThemeContracts">
    <Preview>
        <div class="preview-stack">
            <ThemeSwitch Size="@_themeSwitchSize" AriaLabel="预览主题模式" ModeChanged="HandleThemeModeChanged" />
            <ThemeBrandSwitch Size="@_themeSwitchSize" AriaLabel="预览品牌色" BrandChanged="HandleBrandChanged" />
            <span class="preview-feedback" role="status">当前模式：@ModeText(ThemeService.Mode) · 实际主题：@(ThemeService.IsDark ? "深色" : "浅色") · 品牌：@BrandText(ThemeService.Brand)</span>
        </div>
    </Preview>
    <Controls>
        <div class="control-field">
            <span>ThemeSwitch Size</span>
            <ShowcaseSelect TValue="Size" Id="theme-size" AriaLabel="ThemeSwitch Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_themeSwitchSize" />
        </div>
        <div class="control-field">
            <span>品牌色</span>
            <ShowcaseSelect TValue="ThemeBrand" Id="theme-brand" AriaLabel="品牌色" Options="@(Enum.GetValues<ThemeBrand>())" Value="@ThemeService.Brand" ValueChanged="HandleBrandChanged" />
        </div>
    </Controls>
    <Notes>
        <span>页面根部已经注册一个 <code>&lt;ThemeProvider /&gt;</code>；示例只调整现有 ThemeService，不直接修改 <code>data-theme</code> 或 <code>data-aeterni-brand</code>。品牌切换与明暗切换互相独立，两者都写在同一组语义 Token 上，所以任何组件都会自动跟随，无需逐个适配。<code>ThemeBrandSwitch</code> 是 <code>Segmented</code> 的专用用法，与 <code>ThemeSwitch</code> 同构；示例宿主顶栏也放了同一个控件，切换后整站（含导航下划线、链接、按钮、焦点环）会一起换色。</span>
    </Notes>
</ComponentPreview>

@code {
    private Size _themeSwitchSize = Size.Large;

    private static readonly ShowcaseParameter[] ThemeParameters =
    [
        new("ThemeProvider", "无组件参数", "负责主题恢复、系统主题监听和页面主题同步。"),
        new("ThemeSwitch.AriaLabel", "string", "主题切换组无障碍名称。", "Theme mode"),
        new("ThemeSwitch.Size", "Size", "切换控件尺寸。", "Medium"),
        new("ThemeSwitch.Disabled", "bool", "是否禁用模式切换。", "false"),
        new("ThemeBrandSwitch.AriaLabel", "string", "品牌切换组无障碍名称。", "Brand color"),
        new("ThemeBrandSwitch.Size", "Size", "切换控件尺寸。", "Medium"),
        new("ThemeBrandSwitch.Disabled", "bool", "是否禁用品牌切换。", "false")
    ];

    private static readonly ShowcaseEvent[] ThemeEvents =
    [
        new("ModeChanged", "EventCallback<ThemeMode>", "主题模式被用户切换时触发。"),
        new("BrandChanged", "EventCallback<ThemeBrand>", "品牌色被用户切换时触发。"),
        new("ThemeService.BrandChanged", "event EventHandler", "品牌色层变化时触发，外部改动也会同步控件。")
    ];

    private static readonly ShowcaseContract[] ThemeContracts =
    [
        new("ThemeService.Mode", "ThemeMode", "System、Light、Dark 三种模式。"),
        new("ThemeService.CurrentTheme", "ThemeKind", "实际生效的浅色 / 深色。"),
        new("ThemeService.Brand", "ThemeBrand", "当前品牌色层，默认 Purple。"),
        new("ThemeService.SetBrand", "方法", "切换品牌色层，落为 <html> 上的 data-aeterni-brand。")
    ];

    private static string ModeText(ThemeMode mode) => mode switch
    {
        ThemeMode.System => "跟随系统",
        ThemeMode.Light => "浅色",
        _ => "深色"
    };

    private static string BrandText(ThemeBrand brand) => brand switch
    {
        ThemeBrand.Green => "绿色",
        ThemeBrand.Orange => "焦橙",
        _ => "紫罗兰"
    };

    private async Task HandleThemeModeChanged(ThemeMode mode)
    {
        _feedbackNote = $"主题模式已切换为 {ModeText(mode)}。";
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleBrandChanged(ThemeBrand brand)
    {
        ThemeService.SetBrand(brand);
        _feedbackNote = $"品牌色已切换为{BrandText(brand)}。";
        await InvokeAsync(StateHasChanged);
    }
}
