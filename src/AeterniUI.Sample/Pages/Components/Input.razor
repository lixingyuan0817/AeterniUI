@page "/components/input"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons
@using AeterniUI.Models.Dialog
@using AeterniUI.Services.Impl

<PageTitle>Aeterni UI · Input</PageTitle>

<ComponentPreview AnchorId="input"
                  Category="表单组件"
                  Title="Input"
                  ComponentName="Input"
                  Description="单行原生输入控件，支持标准绑定、HTML 输入语义、校验状态、事件和 FormField 级联。"
                  Code="@UsageCode">
    <Preview>
        <div class="preview-form-control">
            <Input @bind-Value="_inputValue"
                   Type="@_inputType"
                   Size="@_inputSize"
                   Placeholder="@_inputPlaceholder"
                   ReadOnly="@_inputReadOnly"
                   Required="@_inputRequired"
                   Invalid="@_inputInvalid"
                   Disabled="@_inputDisabled"
                   FullWidth="@_inputFullWidth"
                   AriaLabel="预览输入框" />
            <code class="preview-value">Value: @_inputValue</code>
        </div>
    </Preview>
    <Controls>
        <div class="control-field">
            <label for="input-placeholder">Placeholder</label>
            <input id="input-placeholder" @bind="_inputPlaceholder" />
        </div>
        <div class="control-grid">
            <div class="control-field">
                <span>Type</span>
                <ShowcaseSelect TValue="InputType" Id="input-type" AriaLabel="Type" Options="@(Enum.GetValues<InputType>())" @bind-Value="_inputType" />
            </div>
            <div class="control-field">
                <span>Size</span>
                <ShowcaseSelect TValue="Size" Id="input-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_inputSize" />
            </div>
        </div>
        <Checkbox Size="Size.Small" @bind-Value="_inputReadOnly">ReadOnly</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_inputRequired">Required</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_inputInvalid">Invalid</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_inputDisabled">Disabled</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_inputFullWidth">FullWidth</Checkbox>
    </Controls>
    <Notes>
        <span><code>Type</code> 直接映射到原生 input 类型，密码等类型的自动填充由 <code>AutoComplete</code> 描述。</span>
        <span>在 <code>FormField</code> 内输入采用字段的输入 id，字段标签的 <code>for</code> 因此解析到输入本身；<code>aria-describedby</code> 合并宿主值与字段描述 id。</span>
        <span>禁用态同时输出 <code>disabled</code> 与 <code>aria-disabled="true"</code>；<code>ReadOnly</code> 只做只读，文本仍可选中、焦点仍可达。</span>
        <span>组件不定义校验规则：<code>Invalid</code> 或 <code>EditContext</code> 的校验消息只决定无效态外观，是否阻止提交由宿主决定。</span>
    </Notes>
</ComponentPreview>

@code {
    private string? _inputValue;

    private InputType _inputType = InputType.Text;

    private Size _inputSize = Size.Medium;

    private string _inputPlaceholder = "调整右侧属性后输入";

    private bool _inputReadOnly;

    private bool _inputRequired;

    private bool _inputInvalid;

    private bool _inputDisabled;

    private bool _inputFullWidth;

    private const string UsageCode = """
        <FormField Label="邮箱" Description="用于接收构建通知。">
            <Input @bind-Value="Email"
                   Type="InputType.Email"
                   Placeholder="name@example.com"
                   Required
                   FullWidth />
        </FormField>
        """;

}
