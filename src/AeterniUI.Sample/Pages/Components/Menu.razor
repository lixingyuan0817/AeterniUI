@page "/components/menu"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · Menu</PageTitle>

<ComponentPage AnchorId="menu"
               Category="导航组件"
               Title="Menu"
               ComponentName="Menu"
               Description="分组可折叠的菜单导航：链接项、图标与描述、手风琴、受控展开状态与完整键盘操作。"
               Related="@MenuRelated">
    <WhenToUse>
        <p>站内导航或设置项需要按分组收起展开时使用：侧边栏、设置中心。平铺的选项列表用 <code>List</code>，切换同一区域的内容用 <code>Tabs</code>。</p>
        <p>Menu 是导航内容控件，自身不提供表面：底由宿主容器负责，放进已有卡片不会出现双层底。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="menu-basic"
                  Title="基础用法"
                  Description="Items 提供分组与条目，SelectedId 表达选中项（同时写入 aria-current），激活条目通过 OnItemSelected 上报。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-menu-demo">
                    <Surface Variant="SurfaceVariant.Elevated" Bordered>
                        <Menu Items="MenuBaseGroups"
                              SelectedId="_selectedId"
                              SelectedIdChanged="HandleSelectedId"
                              OnItemSelected="HandleItemSelected"
                              AriaLabel="示例菜单" />
                    </Surface>
                    <span class="preview-feedback" role="status">@_menuNote</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="menu-links"
                  Title="链接项、图标与禁用项"
                  Description="MenuItem 的 Href 让它渲染成真实的 a 元素（保留中键与新标签打开）；Disabled 的分组与条目都不进入键盘移动范围。"
                  Code="@LinkCode">
            <Preview>
                <div class="preview-menu-demo">
                    <Surface Variant="SurfaceVariant.Elevated" Bordered>
                        <Menu Items="MenuLinkGroups"
                              SelectedId="_linkSelectedId"
                              SelectedIdChanged="HandleLinkSelectedId"
                              OnItemSelected="HandleItemSelected"
                              AriaLabel="链接菜单" />
                    </Surface>
                    <span class="preview-feedback" role="status">@_menuNote</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="menu-options"
                  Title="展开状态与可调属性"
                  Description="手风琴、受控展开键、图标档位、链接项、禁用分组与隐藏项都能单独切换；右侧控件即时生效。"
                  Code="@OptionCode">
            <Preview>
                <div class="preview-menu-demo">
                    <Surface Variant="SurfaceVariant.Elevated" Bordered>
                        <Menu Items="MenuControlledGroups"
                              SelectedId="_selectedId"
                              SelectedIdChanged="HandleSelectedId"
                              OnItemSelected="HandleItemSelected"
                              Accordion="_menuAccordion"
                              IconSize="_menuIconSize"
                              OpenKeys="@(_menuControlled ? _openKeys : null)"
                              OpenKeysChanged="HandleOpenKeysChanged"
                              OnGroupToggled="HandleGroupToggled"
                              AriaLabel="可调属性菜单" />
                    </Surface>
                    <span class="preview-feedback" role="status">@_menuNote</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>IconSize</span>
                    <ShowcaseSelect TValue="MenuIconSize" Id="menu-icon-size" AriaLabel="IconSize" Options="@(Enum.GetValues<MenuIconSize>())" @bind-Value="_menuIconSize" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_menuAccordion">Accordion</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_menuControlled">受控 OpenKeys</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_menuHref">菜单项使用 Href</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_menuDisabledGroup">禁用第二个分组</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_menuHiddenItem">隐藏一个菜单项</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>键盘按导航模式工作：<code>Tab</code> 走原生顺序，<code>↑</code>/<code>↓</code> 在可达节点间循环，<code>Home</code>/<code>End</code> 到首尾，<code>←</code>/<code>→</code> 折叠或展开当前分组（RTL 自动互换），禁用项不参与移动。</span>
        <span>选中态与展开态是两份状态：<code>SelectedId</code> 决定 <code>aria-current</code> 与选中样式；传入 <code>OpenKeys</code> 后由消费者接管展开状态，传 <code>null</code> 则组件自行维护。</span>
        <span><code>IconSize</code> 同时改变分组图标与条目图标的槽位（<code>Small</code> 16px / <code>Default</code> 20px / <code>Large</code> 24px），展开箭头保持自己的小尺寸；紧凑的菜单弹层用 <code>Small</code> 即可，不必再从宿主覆盖图标变量。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] MenuRelated =
    [
        new("Tabs / Tab", "/components/tabs"),
        new("List / ListItem", "/components/list"),
        new("Breadcrumb", "/components/breadcrumb"),
        new("Pagination", "/components/pagination")
    ];

    private const string BasicCode = """
        <Menu Items="Groups"
              SelectedId="SelectedId"
              SelectedIdChanged="HandleSelectedId"
              OnItemSelected="HandleItemSelected"
              AriaLabel="示例菜单" />
        """;

    private const string LinkCode = """
        new MenuGroup("guide", "文档", [
            new MenuItem("install", "安装", "安装与初始化", Href: "/components"),
            new MenuItem("soon", "即将推出", "禁用项示例", Disabled: true)
        ], InitiallyOpen: true, Disabled: false)
        """;

    private const string OptionCode = """
        <Menu Items="Groups"
              Accordion
              IconSize="MenuIconSize.Small"
              OpenKeys="OpenKeys"
              OpenKeysChanged="HandleOpenKeysChanged"
              OnGroupToggled="HandleGroupToggled" />
        """;

    private static readonly IReadOnlyList<MenuGroup> MenuBaseGroups =
    [
        new MenuGroup("components", "组件", [
            new MenuItem("button", "Button", "动作按钮"),
            new MenuItem("input", "Input", "单行输入")
        ], GroupIcon(FontAwesomeIcons.Solid.Cubes)),
        new MenuGroup("resources", "资源", [
            new MenuItem("docs", "文档示例", "打开组件总览")
        ], GroupIcon(FontAwesomeIcons.Solid.Book), InitiallyOpen: false)
    ];

    private static readonly IReadOnlyList<MenuGroup> MenuLinkGroups =
    [
        new MenuGroup("guide", "文档", [
            new MenuItem("install", "安装", "安装与初始化", Href: "/components"),
            new MenuItem("quickstart", "快速上手", "最小可运行示例"),
            new MenuItem("soon", "即将推出", "禁用项示例", Disabled: true)
        ], GroupIcon(FontAwesomeIcons.Solid.Rocket)),
        new MenuGroup("components", "组件", [
            new MenuItem("button", "Button", "跳转到 Button 页", Href: "/components/button"),
            new MenuItem("tabs", "Tabs", "跳转到 Tabs 页", Href: "/components/tabs")
        ], GroupIcon(FontAwesomeIcons.Solid.Cubes), Disabled: true)
    ];

    private string _menuNote = "点击菜单项或分组查看事件反馈。";

    private string? _selectedId = "button";
    private string? _linkSelectedId = "install";

    private bool _menuAccordion = true;
    private MenuIconSize _menuIconSize = MenuIconSize.Default;
    private bool _menuHref = true;
    private bool _menuControlled;
    private bool _menuDisabledGroup;
    private bool _menuHiddenItem;

    private IReadOnlyList<string> _openKeys = ["components"];

    private IReadOnlyList<MenuGroup> MenuControlledGroups =>
    [
        new MenuGroup("getting-started", "开始", [
            new MenuItem("install", "安装", "安装与初始化", Href: _menuHref ? "/components" : null),
            new MenuItem("quickstart", "快速上手", "最小可运行示例", Visible: _menuHiddenItem)
        ], GroupIcon(FontAwesomeIcons.Solid.Rocket)),
        new MenuGroup("components", "组件", [
            new MenuItem("button", "Button", "动作按钮"),
            new MenuItem("input", "Input", "单行输入"),
            new MenuItem("soon", "即将推出", "禁用项示例", Disabled: true)
        ], GroupIcon(FontAwesomeIcons.Solid.Cubes), Disabled: _menuDisabledGroup),
        new MenuGroup("resources", "资源", [
            new MenuItem("docs", "文档示例", "跳转到本页锚点", Href: _menuHref ? "/components/menu" : null)
        ], GroupIcon(FontAwesomeIcons.Solid.Book), InitiallyOpen: false)
    ];

    private void HandleSelectedId(string id) => _selectedId = id;

    private void HandleLinkSelectedId(string id) => _linkSelectedId = id;

    private void HandleItemSelected(MenuItem item) => _menuNote = $"选中：{item.Label}";

    private void HandleOpenKeysChanged(IReadOnlyList<string> keys)
    {
        _openKeys = keys;
        _menuNote = keys.Count == 0 ? "已全部折叠" : $"展开：{string.Join(" / ", keys)}";
    }

    private void HandleGroupToggled(MenuGroup group) => _menuNote = $"切换分组：{group.Label}";

    /// <summary>Wraps a definition so <see cref="MenuGroup"/> can render a group icon.</summary>
    private static RenderFragment GroupIcon(IconDefinition definition) => @<Icon Definition="@definition" />;
}
