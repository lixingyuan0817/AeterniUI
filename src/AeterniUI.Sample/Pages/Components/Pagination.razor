@page "/components/pagination"
@layout ComponentsLayout
@using AeterniUI.Enums

<ComponentPreview AnchorId="pagination" Category="导航组件" Title="Pagination" ComponentName="Pagination" Description="用于页面导航的轻量分页控件。">
    <Preview>
        <div class="preview-form-control">
            <Pagination CurrentPage="@_page" TotalPages="15" SiblingCount="1" CurrentPageChanged="OnPageChanged" AriaLabel="内容分页" />
            <span class="preview-feedback" role="status">当前第 @_page 页</span>
            <Pagination CurrentPage="1" TotalPages="1" AriaLabel="单页分页（前后按钮均禁用）" />
        </div>
    </Preview>
    <Controls>
        <Button Size="Size.Small" Variant="ButtonVariant.Outline" OnClick="@(_ => _page = 1)">第一页</Button>
        <Button Size="Size.Small" Variant="ButtonVariant.Outline" OnClick="@(_ => _page = 8)">中间页</Button>
        <Button Size="Size.Small" Variant="ButtonVariant.Outline" OnClick="@(_ => _page = 15)">最后一页</Button>
    </Controls>
    <Notes>
        <span>前后操作使用核心 Chevron 图标；区域、页码和前后按钮文案都可通过组件参数或全局文案表本地化。</span>
        <span><code>prefers-reduced-motion: reduce</code> 下关闭当前页缩放相关过渡。</span>
    </Notes>
</ComponentPreview>
@code {
    private int _page = 3;
    private void OnPageChanged(int page) => _page = page;

}
