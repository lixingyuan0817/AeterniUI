@page "/components/tooltip"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · Tooltip</PageTitle>

<ComponentPage AnchorId="tooltip"
               Category="通知组件"
               Title="Tooltip"
               ComponentName="Tooltip"
               Description="悬停或键盘焦点时出现的辅助说明，越界时自动翻转并在交叉轴偏移。"
               Related="@TooltipRelated">
    <WhenToUse>
        <p>补充说明一个已经有名字的动作或字段时使用：图标按钮的含义、被截断的文本、只读字段的取值来源。触发元素自己必须可聚焦，提示只在悬停或 <code>focus-visible</code> 时出现。</p>
        <p>提示里要放按钮、输入或任何需要操作的内容时改用 <code>Popover</code>；字段的错误与校验说明属于 <code>FormField</code> 的说明文字，不要塞进提示里。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="tooltip-basic"
                  Title="基础用法"
                  Description="Text 是提示内容，AriaLabel 是提示节点自己的无障碍名称；触发元素的名称仍然来自它自己的文字。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-overlay-demo">
                    <p class="preview-overlay-demo__hint">把指针移到触发元素上，或用 Tab 聚焦，提示才会出现。</p>
                    <Tooltip Text="保存当前更改，并覆盖上一次的草稿。" AriaLabel="保存说明">
                        <Button Variant="ButtonVariant.Outline">保存</Button>
                    </Tooltip>
                    <Tooltip Text="留空表示继承全局文案表。" AriaLabel="字段说明">
                        <IconButton Icon="@InfoIcon" AriaLabel="字段说明" />
                    </Tooltip>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="tooltip-placement"
                  Title="方位与越界翻转"
                  Description="Placement 只是首选方位：空间不足时提示会翻到对侧，并沿交叉轴偏移回视口内。"
                  Code="@PlacementCode">
            <Preview>
                <div class="preview-overlay-demo">
                    <p class="preview-overlay-demo__hint">同一段内容在四个方位下的表现；把触发元素挪到视口边缘即可看到翻转。</p>
                    <div class="preview-state-row" aria-label="四个方位的 Tooltip 对照">
                        @foreach (var placement in Enum.GetValues<TooltipPlacement>())
                        {
                            var placementLabel = $"Placement = {placement}";
                            <Tooltip Text="@placementLabel" AriaLabel="@placementLabel" Placement="@placement">
                                <Button Variant="ButtonVariant.Ghost" Size="Size.Small">@placement</Button>
                            </Tooltip>
                        }
                    </div>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="tooltip-states"
                  Title="方位与禁用"
                  Description="右侧控件即时生效：Disabled 时既不渲染提示节点，也不建立描述关联。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-overlay-demo">
                    <p class="preview-overlay-demo__hint">提示文本是「按当前方位显示说明」，悬停或聚焦按钮查看效果。</p>
                    <Tooltip Text="按当前方位显示说明"
                             AriaLabel="方位说明"
                             Placement="@_tooltipPlacement"
                             Disabled="@_tooltipDisabled">
                        <Button Variant="ButtonVariant.Outline">悬停或聚焦查看说明</Button>
                    </Tooltip>
                    <span class="preview-feedback" role="status">Disabled：@(_tooltipDisabled ? "true" : "false") · Placement：@(_tooltipPlacement)</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Placement</span>
                    <ShowcaseSelect TValue="TooltipPlacement" Id="tooltip-placement" AriaLabel="Placement" Options="@(Enum.GetValues<TooltipPlacement>())" @bind-Value="_tooltipPlacement" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_tooltipDisabled">Disabled</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>提示内容由组件自己渲染成 <code>role="tooltip"</code> 的节点，<code>ChildContent</code> 里第一个可聚焦元素通过 <code>aria-describedby</code> 指向它；<code>AriaLabel</code> 是提示节点的名称，触发元素的名称仍由它自己的文字提供。</span>
        <span>方位只在空间不足时改变：优先用 <code>Placement</code>，越界才翻转到对侧并沿交叉轴偏移；显示与隐藏由 CSS 的 <code>:hover</code> / <code>:focus-within</code> 驱动，脚本只复用共享的浮层数学，不做定位以外的事。</span>
        <span><code>Text</code> 为空白或 <code>Disabled</code> 时不渲染提示节点，也不建立描述关联；提示是纯说明，需要操作请换用 <code>Popover</code>。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] TooltipRelated =
    [
        new("PopupHost / Popover", "/components/popup"),
        new("Button", "/components/button"),
        new("IconButton", "/components/icon-button")
    ];

    private const string BasicCode = """
        <Tooltip Text="保存当前更改，并覆盖上一次的草稿。" AriaLabel="保存说明">
            <Button Variant="ButtonVariant.Outline">保存</Button>
        </Tooltip>

        <Tooltip Text="留空表示继承全局文案表。" AriaLabel="字段说明">
            <IconButton Icon="InfoIcon" AriaLabel="字段说明" />
        </Tooltip>
        """;

    private const string PlacementCode = """
        <Tooltip Text="按当前方位显示说明" AriaLabel="方位说明" Placement="TooltipPlacement.Bottom">
            <Button Variant="ButtonVariant.Ghost">对齐方式</Button>
        </Tooltip>
        """;

    private const string StateCode = """
        <Tooltip Text="按当前方位显示说明"
                 AriaLabel="方位说明"
                 Placement="@Placement"
                 Disabled="@IsBusy">
            <Button Variant="ButtonVariant.Outline">查看说明</Button>
        </Tooltip>
        """;

    private TooltipPlacement _tooltipPlacement = TooltipPlacement.Top;

    private bool _tooltipDisabled;

    private RenderFragment InfoIcon => @<Icon Definition="@AeterniIcons.Info" />;
}
