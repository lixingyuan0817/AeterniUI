@page "/components/toolbar"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · Toolbar</PageTitle>

<ComponentPage AnchorId="toolbar"
               Category="基础组件"
               Title="Toolbar"
               ComponentName="Toolbar"
               Description="无背景的动作容器：整条工具栏只占一个 Tab 停留点，组内用方向键移动。"
               Related="@ToolbarRelated">
    <WhenToUse>
        <p>一组相关动作需要集中放在内容上方时使用：文档编辑、列表批处理、画布工具条。动作各自独立、不需要统一的键盘模型时用 <code>ButtonGroup</code>。</p>
        <p>容器本身无背景：视觉分区由宿主提供的表面与分组之间的 <code>Divider</code> 完成，溢出菜单由宿主自己放进某个 <code>ToolbarGroup</code>。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="toolbar-basic"
                  Title="基础用法"
                  Description="工具栏只占一个 Tab 停留点；Tab 进入后焦点落在第一个动作上，方向键在整条工具栏内循环。"
                  Code="@BasicCode">
            <Preview>
                <Surface Bordered="true" FullWidth="true" Padding="SurfacePadding.None">
                    <div class="toolbar-demo">
                        <div class="toolbar-demo__heading">
                            <strong>项目周报</strong>
                            <span>文档工作区</span>
                        </div>
                        <div class="toolbar-demo__actions">
                            <Toolbar AriaLabel="文档操作">
                                <ToolbarGroup AriaLabel="文件">
                                    <IconButton Size="Size.Small" AriaLabel="打开项目" OnClick="@(() => _basicLast = "打开项目")">
                                        <ChildContent><Icon Definition="@FolderOpenIcon" Size="Size.Small" /></ChildContent>
                                    </IconButton>
                                    <IconButton Size="Size.Small" AriaLabel="保存" OnClick="@(() => _basicLast = "保存")">
                                        <ChildContent><Icon Definition="@CheckIcon" Size="Size.Small" /></ChildContent>
                                    </IconButton>
                                </ToolbarGroup>
                                <Divider Orientation="Orientation.Vertical" />
                                <ToolbarGroup AriaLabel="编辑">
                                    <IconButton Size="Size.Small" AriaLabel="撤销" OnClick="@(() => _basicLast = "撤销")">
                                        <ChildContent><Icon Definition="@UndoIcon" Size="Size.Small" /></ChildContent>
                                    </IconButton>
                                    <IconButton Size="Size.Small" AriaLabel="重做" OnClick="@(() => _basicLast = "重做")">
                                        <ChildContent><Icon Definition="@RedoIcon" Size="Size.Small" /></ChildContent>
                                    </IconButton>
                                </ToolbarGroup>
                            </Toolbar>
                        </div>
                        <div class="toolbar-demo__footer">
                            <p role="status">最近操作：@_basicLast</p>
                            <span>Tab 进入工具栏 → ← → 切换动作 → Tab 离开</span>
                        </div>
                    </div>
                </Surface>
            </Preview>
        </DemoCard>

        <DemoCard Id="toolbar-groups"
                  Title="分组与方向"
                  Description="ToolbarGroup 只划分命名区域、不新增 Tab 停留点；组之间的分隔线由 Divider 提供，纵向工具栏的上下键同样循环。"
                  Code="@GroupCode">
            <Preview>
                <Surface Bordered="true" FullWidth="true" Padding="SurfacePadding.None">
                    <div class="toolbar-demo">
                        <div class="toolbar-demo__workspace">
                            <div class="toolbar-demo__actions">
                                <Toolbar AriaLabel="横向动作组">
                                    <ToolbarGroup AriaLabel="文件">
                                        <IconButton Size="Size.Small" AriaLabel="打开项目" OnClick="@(() => _groupLast = "打开项目")">
                                            <ChildContent><Icon Definition="@FolderOpenIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                        <IconButton Size="Size.Small" AriaLabel="保存" OnClick="@(() => _groupLast = "保存")">
                                            <ChildContent><Icon Definition="@CheckIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                    </ToolbarGroup>
                                    <Divider Orientation="Orientation.Vertical" />
                                    <ToolbarGroup AriaLabel="编辑">
                                        <IconButton Size="Size.Small" AriaLabel="撤销" OnClick="@(() => _groupLast = "撤销")">
                                            <ChildContent><Icon Definition="@UndoIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                        <IconButton Size="Size.Small" AriaLabel="重做" OnClick="@(() => _groupLast = "重做")">
                                            <ChildContent><Icon Definition="@RedoIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                    </ToolbarGroup>
                                    <Divider Orientation="Orientation.Vertical" />
                                    <ToolbarGroup AriaLabel="其他操作">
                                        <MenuButton Size="Size.Small" Variant="ButtonVariant.Ghost" Label="更多" Items="@_menu" OnItemSelected="@(item => _groupLast = item.Label)" />
                                    </ToolbarGroup>
                                </Toolbar>
                            </div>
                            <div class="toolbar-demo__actions">
                                <Toolbar AriaLabel="纵向动作组" Orientation="Orientation.Vertical">
                                    <ToolbarGroup AriaLabel="文件">
                                        <IconButton Size="Size.Small" AriaLabel="打开项目" OnClick="@(() => _groupLast = "打开项目")">
                                            <ChildContent><Icon Definition="@FolderOpenIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                        <IconButton Size="Size.Small" AriaLabel="保存" OnClick="@(() => _groupLast = "保存")">
                                            <ChildContent><Icon Definition="@CheckIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                    </ToolbarGroup>
                                    <Divider Orientation="Orientation.Horizontal" />
                                    <ToolbarGroup AriaLabel="编辑">
                                        <IconButton Size="Size.Small" AriaLabel="撤销" OnClick="@(() => _groupLast = "撤销")">
                                            <ChildContent><Icon Definition="@UndoIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                        <IconButton Size="Size.Small" AriaLabel="重做" OnClick="@(() => _groupLast = "重做")">
                                            <ChildContent><Icon Definition="@RedoIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                    </ToolbarGroup>
                                </Toolbar>
                            </div>
                        </div>
                        <div class="toolbar-demo__footer">
                            <p role="status">最近操作：@_groupLast</p>
                            <span>横向工具栏用 ← →，纵向工具栏用 ↑ ↓</span>
                        </div>
                    </div>
                </Surface>
            </Preview>
        </DemoCard>

        <DemoCard Id="toolbar-states"
                  Title="方向、禁用与可见"
                  Description="整条工具栏可以禁用或隐藏，单个动作也能独立禁用或进入加载；右侧控件即时生效。"
                  Code="@StateCode">
            <Preview>
                <Surface Bordered="true" FullWidth="true" Padding="SurfacePadding.None">
                    <div class="toolbar-demo" dir="@(_rtl ? "rtl" : "ltr")">
                        <div class="toolbar-demo__heading"><strong>项目周报</strong><span>文档工作区</span></div>
                        <div class="@(_vertical ? "toolbar-demo__workspace is-vertical" : "toolbar-demo__workspace")">
                            <div class="toolbar-demo__actions">
                                <Toolbar AriaLabel="文档操作" Orientation="@(_vertical ? Orientation.Vertical : Orientation.Horizontal)" Disabled="@_disabled" Visible="@_visible">
                                    <ToolbarGroup AriaLabel="文件">
                                        <IconButton Size="Size.Small" AriaLabel="打开项目" OnClick="@(() => _last = "打开项目")">
                                            <ChildContent><Icon Definition="@FolderOpenIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                        <IconButton Size="Size.Small" AriaLabel="保存" Disabled="@_itemDisabled" Loading="@_loading" OnClick="Save">
                                            <ChildContent><Icon Definition="@CheckIcon" Size="Size.Small" /></ChildContent>
                                        </IconButton>
                                    </ToolbarGroup>
                                    <Divider Orientation="@(_vertical ? Orientation.Horizontal : Orientation.Vertical)" />
                                    <ToolbarGroup AriaLabel="编辑">
                                        @foreach (var action in (_reverse ? _actions.Reverse() : _actions))
                                        {
                                            <IconButton @key="action" Size="Size.Small" AriaLabel="@action" OnClick="@(() => _last = action)">
                                                <ChildContent><Icon Definition="@(action == "撤销" ? UndoIcon : RedoIcon)" Size="Size.Small" /></ChildContent>
                                            </IconButton>
                                        }
                                    </ToolbarGroup>
                                    <Divider Orientation="@(_vertical ? Orientation.Horizontal : Orientation.Vertical)" />
                                    <ToolbarGroup AriaLabel="其他操作">
                                        @if (_extra)
                                        {
                                            <IconButton Size="Size.Small" AriaLabel="打印" OnClick="@(() => _last = "打印")">
                                                <ChildContent><Icon Definition="@PrintIcon" Size="Size.Small" /></ChildContent>
                                            </IconButton>
                                        }
                                        <MenuButton Size="Size.Small" Variant="ButtonVariant.Ghost" Label="更多" Items="@_menu" OnItemSelected="@(item => _last = item.Label)" />
                                    </ToolbarGroup>
                                </Toolbar>
                            </div>
                            <article class="toolbar-demo__document" aria-label="示例文档">
                                <span class="toolbar-demo__caption">周报草稿</span>
                                <h3>本周进展</h3>
                                <p>完成工具栏的分组操作与键盘导航，让文档动作集中在内容区上方。</p>
                                <h4>下一步</h4>
                                <p>使用上方的保存、导出或打印操作，观察下方状态反馈。</p>
                                <Button Variant="ButtonVariant.Link" OnClick="@(() => _last = "查看修订记录")">查看修订记录（工具栏后的焦点）</Button>
                            </article>
                        </div>
                        <div class="toolbar-demo__footer">
                            <p role="status">最近操作：@_last</p>
                            <span>Tab 进入工具栏 → @(_vertical ? "↑ ↓" : "← →") 切换动作 → Tab 进入文档链接</span>
                        </div>
                    </div>
                </Surface>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_vertical">纵向</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_rtl">RTL</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_disabled">整条禁用</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_visible">可见</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_itemDisabled">禁用保存</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_loading">保存加载中</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_extra">动态图标项</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_reverse">重排编辑动作</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>横向用左右键、纵向用上下键在整条工具栏内循环，Home/End 到首尾；Tab 会离开整条工具栏，再次进入时回到最近焦点的动作，Enter/Space 激活按钮。<code>ToolbarGroup</code> 只给出分组名，不新增停留点。</span>
        <span>容器自身没有背景，用紧凑的组间距与组内间距：视觉分区交给宿主的表面与组间的 <code>Divider</code>，组件不会改写子按钮的 <code>Size</code> 或 <code>Variant</code>。</span>
        <span><code>Disabled</code> 输出 <code>aria-disabled</code> 与 <code>inert</code>，整条工具栏一起失效；只接纳 <code>Button</code>、<code>IconButton</code>、<code>MenuButton</code> 这类动作控件，不支持输入框、自动折叠或业务选择状态，溢出菜单及其弹层键盘由宿主与菜单组件自己负责。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] ToolbarRelated =
    [
        new("IconButton", "/components/icon-button"),
        new("ButtonGroup", "/components/button-group"),
        new("MenuButton", "/components/menu-button")
    ];

    private const string BasicCode = """
        <Toolbar AriaLabel="文档操作">
            <ToolbarGroup AriaLabel="文件">
                <IconButton Size="Size.Small" Icon="FolderOpenIcon" AriaLabel="打开项目" OnClick="OpenProject" />
                <IconButton Size="Size.Small" Icon="CheckIcon" AriaLabel="保存" OnClick="Save" />
            </ToolbarGroup>
            <Divider Orientation="Orientation.Vertical" />
            <ToolbarGroup AriaLabel="编辑">
                <IconButton Size="Size.Small" Icon="UndoIcon" AriaLabel="撤销" OnClick="Undo" />
            </ToolbarGroup>
        </Toolbar>
        """;

    private const string GroupCode = """
        <Toolbar AriaLabel="编辑动作">
            <ToolbarGroup AriaLabel="文件">
                <IconButton Size="Size.Small" Icon="CheckIcon" AriaLabel="保存" />
            </ToolbarGroup>
            <Divider Orientation="Orientation.Vertical" />
            <ToolbarGroup AriaLabel="其他操作">
                <MenuButton Size="Size.Small" Label="更多" Items="MoreItems" OnItemSelected="HandleMenu" />
            </ToolbarGroup>
        </Toolbar>
        """;

    private const string StateCode = """
        <Toolbar Orientation="Orientation.Vertical" Disabled="IsReadOnly" AriaLabel="文档操作">
            <ToolbarGroup AriaLabel="文件">
                <IconButton Size="Size.Small" Icon="CheckIcon" AriaLabel="保存" Loading="IsSaving" />
            </ToolbarGroup>
        </Toolbar>
        """;

    private bool _vertical, _rtl, _disabled, _itemDisabled, _loading, _reverse;
    private bool _visible = true, _extra = true;
    private string _basicLast = "无";
    private string _groupLast = "无";
    private string _last = "无";

    private readonly string[] _actions = ["撤销", "重做"];
    private readonly IReadOnlyList<MenuGroup> _menu = [new MenuGroup("more", "更多操作", [new MenuItem("export", "导出"), new MenuItem("print", "打印")])];

    private static readonly IconDefinition FolderOpenIcon = FontAwesomeIcons.Solid.FolderOpen;
    private static readonly IconDefinition CheckIcon = FontAwesomeIcons.Solid.Check;
    private static readonly IconDefinition UndoIcon = FontAwesomeIcons.Solid.RotateLeft;
    private static readonly IconDefinition RedoIcon = FontAwesomeIcons.Solid.RotateRight;
    private static readonly IconDefinition PrintIcon = FontAwesomeIcons.Solid.Print;

    private void Save() => _last = "保存";
}
