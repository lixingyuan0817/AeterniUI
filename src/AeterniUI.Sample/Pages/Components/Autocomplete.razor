@page "/components/autocomplete"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Autocomplete</PageTitle>

<ComponentPage AnchorId="autocomplete"
               Category="表单组件"
               Title="Autocomplete"
               ComponentName="Autocomplete&lt;TItem&gt;"
               Description="带候选列表的单行输入：候选由宿主按输入过滤后提供，组件只负责键盘、浮层与选中语义。"
               Related="@AutocompleteRelated">
    <WhenToUse>
        <p>用户知道要输入什么、但需要提示时使用：组件名、城市、标签。选项有限且必须择一时用 <code>ComboBox</code>，不需要候选列表的纯检索用 <code>Search</code>。</p>
        <p>建议项由宿主提供：组件不请求远程数据、不做缓存，也不按输入筛选；示例在宿主侧过滤后把结果作为 <code>Items</code> 传入。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="autocomplete-basic"
                  Title="基础用法"
                  Description="Items 是宿主按当前输入过滤后的建议快照；选中后回调选项本身，输入框内容仍由宿主绑定值决定。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <FormField Label="组件建议" Description="输入“Input”“Button”等关键词试试。">
                        <Autocomplete TItem="string"
                                      Items="@FilteredComponents"
                                      Value="@_query"
                                      ValueChanged="HandleQueryChanged"
                                      OnItemSelected="HandleItemSelected"
                                      TextSelector="@(item => item)"
                                      Placeholder="输入组件名称…"
                                      AriaLabel="组件建议" />
                    </FormField>
                    <span class="preview-feedback" role="status">@_status</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="autocomplete-loading"
                  Title="加载态与交互开关"
                  Description="Loading 只在建议区显示忙碌状态（Spinner + 文案），输入、清除和弹层开合保持可用；OpenOnFocus 决定获得焦点即展开候选。"
                  Code="@LoadingCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <Autocomplete TItem="string"
                                  Items="@FilteredComponents"
                                  Value="@_query"
                                  ValueChanged="HandleQueryChanged"
                                  OnItemSelected="HandleItemSelected"
                                  TextSelector="@(item => item)"
                                  Size="@_size"
                                  Clearable="@_clearable"
                                  OpenOnFocus="@_openOnFocus"
                                  Loading="@_loading"
                                  Placeholder="@_placeholder"
                                  AriaLabel="加载态建议" />
                    <span class="preview-feedback" role="status">@_status</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <label for="autocomplete-placeholder">Placeholder</label>
                    <input id="autocomplete-placeholder" @bind="_placeholder" />
                </div>
                <div class="control-field">
                    <span>Size</span>
                    <ShowcaseSelect TValue="Size" Id="autocomplete-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_clearable">Clearable</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_openOnFocus">OpenOnFocus</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_loading">Loading</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="autocomplete-states"
                  Title="状态与整宽"
                  Description="禁用态关闭输入与候选；无效态与必填态随字段继承，整宽时输入与候选列表同宽。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <FormField Label="组件建议" Description="字段状态同时影响输入与候选列表。"
                               Disabled="@_disabled" Invalid="@_invalid">
                        <Autocomplete TItem="string"
                                      Items="@FilteredStateComponents"
                                      Value="@_stateQuery"
                                      ValueChanged="HandleStateQueryChanged"
                                      TextSelector="@(item => item)"
                                      FullWidth="@_fullWidth"
                                      Placeholder="输入组件名称…"
                                      AriaLabel="状态演示建议" />
                    </FormField>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_disabled">Disabled</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_fullWidth">FullWidth</Checkbox>
            </Controls>
        </DemoCard>
        <DemoCard Id="autocomplete-layer"
                  Title="弹层方位与只读"
                  Description="Placement 决定建议层的首选方位，空间不足时仍由共享浮层翻转；ReadOnly 时输入可聚焦、文本可复制，但不会展开建议也不会改值。"
                  Code="@PlacementCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <Autocomplete TItem="string"
                                  Items="@FilteredPlacementComponents"
                                  Value="@_placementQuery"
                                  ValueChanged="HandlePlacementQueryChanged"
                                  TextSelector="@(item => item)"
                                  Placement="@_placement"
                                  ReadOnly="@_readOnly"
                                  Clearable
                                  Placeholder="输入组件名称…"
                                  AriaLabel="方位与只读演示" />
                    <span class="preview-feedback" role="status">当前输入：@(string.IsNullOrEmpty(_placementQuery) ? "（空）" : _placementQuery)</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Placement</span>
                    <ShowcaseSelect TValue="PopupPlacement" Id="autocomplete-placement" AriaLabel="Placement" Options="@(Enum.GetValues<PopupPlacement>())" @bind-Value="_placement" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_readOnly">ReadOnly</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>键盘模型与 <code>ComboBox</code> 一致：方向键移动、Enter 选中、Escape 关闭；输入框保持编辑焦点，活动项通过 <code>aria-activedescendant</code> 表达。</span>
        <span>过滤是宿主职责：组件不按输入筛选 <code>Items</code>；示例在宿主侧用 <code>Contains(..., OrdinalIgnoreCase)</code> 过滤后把结果作为 <code>Items</code> 传入，空输入时传全量。异步建议在 <code>ValueChanged</code> 里发起请求并替换 <code>Items</code>，<code>Loading</code> 只把建议区换成忙碌状态，输入与清除仍可用。</span>
        <span>选择建议不改变绑定值语义：<code>OnItemSelected</code> 报告被选中项，输入框文本仍由 <code>Value</code> 决定。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] AutocompleteRelated =
    [
        new("ComboBox", "/components/combobox"),
        new("Search", "/components/search"),
        new("MultiSelect", "/components/multi-select")
    ];

    private const string BasicCode = """
        <Autocomplete TItem="string"
                      Items="FilteredComponents"
                      Value="Query"
                      ValueChanged="HandleQueryChanged"
                      TextSelector="@(item => item)"
                      OnItemSelected="HandleSelected" />

        @code {
            // 过滤是宿主职责：Items 是当前输入下的建议快照，组件不会再筛一遍。
            private IReadOnlyList<string> FilteredComponents =>
                string.IsNullOrWhiteSpace(Query)
                    ? Components
                    : Components.Where(item => item.Contains(Query, StringComparison.OrdinalIgnoreCase)).ToArray();
        }
        """;

    private const string LoadingCode = """
        <Autocomplete TItem="string" Items="FilteredComponents" Value="Query" ValueChanged="OnQueryChanged"
                      Loading="IsLoading" OpenOnFocus Clearable />
        """;

    private const string StateCode = """
        <FormField Label="组件建议" Invalid>
            <Autocomplete TItem="string" Items="FilteredComponents" Value="Query" ValueChanged="OnQueryChanged"
                          TextSelector="@(item => item)" FullWidth />
        </FormField>
        """;

    private const string PlacementCode = """
        <Autocomplete TItem="string" Items="FilteredComponents" Value="Query" ValueChanged="OnQueryChanged"
                      TextSelector="@(item => item)"
                      Placement="PopupPlacement.TopStart"
                      ReadOnly="@ReadOnly" />
        """;

    private static readonly string[] _components =
    [
        "Input", "InputNumber", "Textarea", "Search", "Autocomplete",
        "ComboBox", "MultiSelect", "Checkbox", "Switch", "Radio"
    ];

    /// <summary>
    /// 每个 demo 的绑定值各自过滤同一份组件名单：空输入（含纯空白）返回全量，
    /// 否则按 OrdinalIgnoreCase 做宿主侧过滤。Autocomplete 只渲染传入的快照。
    /// </summary>
    private IReadOnlyList<string> FilteredComponents => Filter(_query);

    private IReadOnlyList<string> FilteredStateComponents => Filter(_stateQuery);

    private IReadOnlyList<string> FilteredPlacementComponents => Filter(_placementQuery);

    private static IReadOnlyList<string> Filter(string? query)
    {
        var needle = query?.Trim();
        if (string.IsNullOrEmpty(needle))
        {
            return _components;
        }

        return _components
            .Where(item => item.Contains(needle, StringComparison.OrdinalIgnoreCase))
            .ToArray();
    }

    private string? _query;
    private string _status = "尚未选择建议";
    private string _placeholder = "输入组件名称…";
    private Size _size = Size.Default;
    private bool _clearable = true;
    private bool _openOnFocus = true;
    private bool _loading;

    private string? _stateQuery;
    private bool _disabled;
    private bool _invalid;
    private bool _fullWidth;

    private string? _placementQuery;
    private PopupPlacement _placement = PopupPlacement.BottomStart;
    private bool _readOnly;

    private Task HandleQueryChanged(string? value)
    {
        _query = value;
        return Task.CompletedTask;
    }

    private Task HandleItemSelected(string item)
    {
        _status = $"已选择建议：{item}";
        return Task.CompletedTask;
    }

    private Task HandleStateQueryChanged(string? value)
    {
        _stateQuery = value;
        return Task.CompletedTask;
    }

    private Task HandlePlacementQueryChanged(string? value)
    {
        _placementQuery = value;
        return Task.CompletedTask;
    }
}
