@page "/components/autocomplete"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Autocomplete</PageTitle>

<ComponentPage AnchorId="autocomplete"
               Category="表单组件"
               Title="Autocomplete"
               ComponentName="Autocomplete&lt;TItem&gt;"
               Description="带候选列表的单行输入：输入即过滤宿主提供的建议项。"
               Related="@AutocompleteRelated">
    <WhenToUse>
        <p>用户知道要输入什么、但需要提示时使用：组件名、城市、标签。选项集合有限且必须择一时用 <code>ComboBox</code>，不需要候选列表的纯检索用 <code>Search</code>。</p>
        <p>建议项由宿主提供：组件不请求远程数据、不做缓存，输入过滤与异步加载都由宿主决定何时替换 <code>Items</code>。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="autocomplete-basic"
                  Title="基础用法"
                  Description="Items 是当前建议快照；选中后回调选项本身，输入框内容仍由宿主绑定值决定。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <FormField Label="组件建议" Description="输入“Input”“Button”等关键词试试。">
                        <Autocomplete TItem="string"
                                      Items="@_components"
                                      Value="@_query"
                                      ValueChanged="HandleQueryChanged"
                                      OnItemSelected="HandleItemSelected"
                                      TextSelector="@(item => item)"
                                      Placeholder="输入组件名称…"
                                      AriaLabel="组件建议" />
                    </FormField>
                    <span class="preview-feedback" role="status">@_status</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="autocomplete-loading"
                  Title="加载态与交互开关"
                  Description="Loading 表示宿主正在取数据（不改变输入框可用性）；OpenOnFocus 决定获得焦点即展开候选。"
                  Code="@LoadingCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <Autocomplete TItem="string"
                                  Items="@_components"
                                  Value="@_query"
                                  ValueChanged="HandleQueryChanged"
                                  OnItemSelected="HandleItemSelected"
                                  TextSelector="@(item => item)"
                                  Size="@_size"
                                  Clearable="@_clearable"
                                  OpenOnFocus="@_openOnFocus"
                                  Loading="@_loading"
                                  Placeholder="@_placeholder"
                                  AriaLabel="加载态建议" />
                    <span class="preview-feedback" role="status">@_status</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <label for="autocomplete-placeholder">Placeholder</label>
                    <input id="autocomplete-placeholder" @bind="_placeholder" />
                </div>
                <div class="control-field">
                    <span>Size</span>
                    <ShowcaseSelect TValue="Size" Id="autocomplete-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_clearable">Clearable</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_openOnFocus">OpenOnFocus</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_loading">Loading</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="autocomplete-states"
                  Title="状态与整宽"
                  Description="禁用态关闭输入与候选；无效态与必填态随字段继承，整宽时输入与候选列表同宽。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <FormField Label="组件建议" Description="字段状态同时影响输入与候选列表。"
                               Disabled="@_disabled" Invalid="@_invalid">
                        <Autocomplete TItem="string"
                                      Items="@_components"
                                      Value="@_stateQuery"
                                      ValueChanged="HandleStateQueryChanged"
                                      TextSelector="@(item => item)"
                                      FullWidth="@_fullWidth"
                                      Placeholder="输入组件名称…"
                                      AriaLabel="状态演示建议" />
                    </FormField>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_disabled">Disabled</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_fullWidth">FullWidth</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>建议列表的键盘模型与 <code>ComboBox</code> 一致：方向键移动、Enter 选中、Escape 关闭；输入框保持编辑焦点，活动项通过 <code>aria-activedescendant</code> 表达。</span>
        <span>组件不做输入过滤：<code>Items</code> 是宿主给的当前快照。异步建议请在宿主的 <code>ValueChanged</code> 里发起请求并替换 <code>Items</code>，<code>Loading</code> 用于表示这段时间。</span>
        <span>选择建议不会改变绑定值语义：<code>OnItemSelected</code> 报告被选中的项，输入框文本仍由 <code>Value</code> 决定，需要"选中即写入文本"时在回调里同时更新绑定值。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] AutocompleteRelated =
    [
        new("ComboBox", "/components/combobox"),
        new("Search", "/components/search"),
        new("MultiSelect", "/components/multi-select")
    ];

    private const string BasicCode = """
        <Autocomplete TItem="string"
                      Items="Components"
                      Value="Query"
                      ValueChanged="HandleQueryChanged"
                      TextSelector="@(item => item)"
                      OnItemSelected="HandleSelected" />
        """;

    private const string LoadingCode = """
        <Autocomplete TItem="string" Items="Components" Value="Query" ValueChanged="OnQueryChanged"
                      Loading="IsLoading" OpenOnFocus Clearable />
        """;

    private const string StateCode = """
        <FormField Label="组件建议" Invalid>
            <Autocomplete TItem="string" Items="Components" Value="Query" ValueChanged="OnQueryChanged"
                          TextSelector="@(item => item)" FullWidth />
        </FormField>
        """;

    private static readonly string[] _components =
    [
        "Input", "InputNumber", "Textarea", "Search", "Autocomplete",
        "ComboBox", "MultiSelect", "Checkbox", "Switch", "Radio"
    ];

    private string? _query;
    private string _status = "尚未选择建议";
    private string _placeholder = "输入组件名称…";
    private Size _size = Size.Default;
    private bool _clearable = true;
    private bool _openOnFocus = true;
    private bool _loading;

    private string? _stateQuery;
    private bool _disabled;
    private bool _invalid;
    private bool _fullWidth;

    private Task HandleQueryChanged(string? value)
    {
        _query = value;
        return Task.CompletedTask;
    }

    private Task HandleItemSelected(string item)
    {
        _status = $"已选择建议：{item}";
        return Task.CompletedTask;
    }

    private Task HandleStateQueryChanged(string? value)
    {
        _stateQuery = value;
        return Task.CompletedTask;
    }
}
