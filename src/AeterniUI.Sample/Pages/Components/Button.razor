@page "/components/button"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons
@using AeterniUI.Models.Dialog
@using AeterniUI.Services.Impl

<PageTitle>Aeterni UI · Button</PageTitle>

<ComponentPreview AnchorId="button"
                  Category="基础组件"
                  Title="Button"
                  ComponentName="Button"
                  Description="用于触发动作的原生按钮，统一承载类型、变体、尺寸、图标、加载和禁用状态。"
                  Parameters="@ButtonParameters"
                  Events="@ButtonEvents">
    <Preview>
        <div class="preview-stack">
            <Button Variant="@_buttonVariant"
                    Intent="@_buttonIntent"
                    Size="@_buttonSize"
                    Type="@_buttonType"
                    Loading="@_buttonLoading"
                    Disabled="@_buttonDisabled"
                    FullWidth="@_buttonFullWidth"
                    StartIcon="@ButtonIcon"
                    OnClick="MarkInteraction">
                @_buttonText
            </Button>
            <span class="preview-feedback" role="status">@_interactionNote</span>
        </div>
        <div class="preview-state-row" aria-label="Loading 状态在各变体下的对照">
            <Button Variant="ButtonVariant.Solid" Loading="true">Solid</Button>
            <Button Variant="ButtonVariant.Outline" Loading="true">Outline</Button>
            <Button Variant="ButtonVariant.Soft" Loading="true">Soft</Button>
            <Button Variant="ButtonVariant.Ghost" Loading="true">Ghost</Button>
            <Button Variant="ButtonVariant.Link" Loading="true">Link</Button>
        </div>
        <div class="preview-state-row" aria-label="按钮类型对照">
            <Button Intent="ButtonIntent.Default">Default</Button>
            <Button Intent="ButtonIntent.Neutral">Neutral</Button>
            <Button Intent="ButtonIntent.Warning">Warning</Button>
            <Button Intent="ButtonIntent.Danger">Danger</Button>
        </div>
    </Preview>
    <Controls>
        <div class="control-field">
            <label for="button-text">按钮文本</label>
            <input id="button-text" @bind="_buttonText" />
        </div>
        <div class="control-grid">
            <div class="control-field">
                <span>Variant</span>
                <ShowcaseSelect TValue="ButtonVariant" Id="button-variant" AriaLabel="Variant" Options="@(Enum.GetValues<ButtonVariant>())" @bind-Value="_buttonVariant" />
            </div>
            <div class="control-field">
                <span>Intent</span>
                <ShowcaseSelect TValue="ButtonIntent" Id="button-intent" AriaLabel="Intent" Options="@(Enum.GetValues<ButtonIntent>())" @bind-Value="_buttonIntent" />
            </div>
            <div class="control-field">
                <span>Size</span>
                <ShowcaseSelect TValue="Size" Id="button-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_buttonSize" />
            </div>
            <div class="control-field">
                <span>Type</span>
                <ShowcaseSelect TValue="ButtonType" Id="button-type" AriaLabel="Type" Options="@(Enum.GetValues<ButtonType>())" @bind-Value="_buttonType" />
            </div>
        </div>
        <Checkbox Size="Size.Small" @bind-Value="_buttonLoading">Loading</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_buttonDisabled">Disabled</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_buttonFullWidth">FullWidth</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_buttonHasIcon">显示起始图标</Checkbox>
    </Controls>
    <Notes>
        <span>点击预览按钮会触发 <code>OnClick</code>，加载状态会同时输出 <code>aria-busy</code> 并阻止交互。</span>
        <span>按钮类型由 <code>Intent</code> 表达，视觉形式由 <code>Variant</code> 表达，两者职责分离。</span>
        <span>禁用状态会随 <code>Variant</code> 和 <code>Intent</code> 保留层级与语义底色，不使用透明背景。</span>
        <span>加载状态在五种变体下保持尺寸稳定，并通过 <code>aria-busy</code> 表达忙碌状态。</span>
    </Notes>
</ComponentPreview>

@code {
    private string _buttonText = "保存更改";

    private ButtonVariant _buttonVariant = ButtonVariant.Solid;

    private ButtonIntent _buttonIntent = ButtonIntent.Default;

    private Size _buttonSize = Size.Medium;

    private ButtonType _buttonType = ButtonType.Button;

    private bool _buttonLoading;

    private bool _buttonDisabled;

    private bool _buttonFullWidth;

    private bool _buttonHasIcon = true;

    private static readonly ShowcaseParameter[] ButtonParameters =
    [
        new("Variant", "ButtonVariant", "按钮视觉变体：Solid、Outline、Soft、Ghost、Link。", "Solid"),
        new("Intent", "ButtonIntent", "按钮语义类型：Default、Neutral、Warning、Danger。", "Default"),
        new("Size", "Size", "按钮尺寸。", "Default"),
        new("Type", "ButtonType", "原生 button 类型。", "Button"),
        new("Icon", "RenderFragment?", "兼容旧 API 的起始图标。"),
        new("StartIcon", "RenderFragment?", "按钮左侧图标。"),
        new("EndIcon", "RenderFragment?", "按钮右侧图标。"),
        new("ChildContent", "RenderFragment?", "按钮文本或自定义内容。"),
        new("AriaLabel", "string?", "无障碍名称。"),
        new("Loading", "bool", "加载状态。", "false"),
        new("FullWidth", "bool", "是否占满父容器。", "false")
    ];

    private static readonly ShowcaseEvent[] ButtonEvents =
    [new("OnClick", "EventCallback<MouseEventArgs>", "按钮被点击时触发。")];

    private RenderFragment? ButtonIcon => _buttonHasIcon ? CheckIcon : null;

    private RenderFragment CheckIcon => @<Icon Definition="@FontAwesomeIcons.Solid.Check" />;
}
