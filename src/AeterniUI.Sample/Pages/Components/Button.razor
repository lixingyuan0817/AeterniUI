@page "/components/button"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · Button</PageTitle>

<ComponentPage AnchorId="button"
               Category="基础组件"
               Title="Button"
               ComponentName="Button"
               Description="动作按钮：变体、语意色、尺寸、加载与图标。"
               Related="@ButtonRelated">
    <WhenToUse>
        <p>执行一个动作时使用：提交、保存、删除。跳转用链接，切换状态用 <code>Switch</code>，只有图标没有文字用 <code>IconButton</code>。</p>
        <p>一屏里主次分明：一个主要动作（<code>Solid</code> + 默认语意），其余用 <code>Outline</code>、<code>Soft</code> 或 <code>Ghost</code>；危险动作才用 <code>Danger</code>。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="button-basic"
                  Title="基础用法"
                  Description="变体决定强调层级，Intent 决定语意色；Type 映射到原生 button 类型（默认 Button，不会误提交表单）。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-action-row">
                    <Button Variant="ButtonVariant.Solid" OnClick="MarkInteraction">保存</Button>
                    <Button Variant="ButtonVariant.Outline" OnClick="MarkInteraction">另存为</Button>
                    <Button Variant="ButtonVariant.Ghost" OnClick="MarkInteraction">取消</Button>
                    <Button Variant="ButtonVariant.Soft" Intent="ButtonIntent.Danger" OnClick="MarkInteraction">删除</Button>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="button-variants"
                  Title="变体与语意对照"
                  Description="同一语意色在五个变体下的表现一致；加载态不改变变体的墨色，只把内容换成忙碌指示。"
                  Code="@VariantCode">
            <Preview>
                <div class="preview-stack preview-matrix">
                    <div class="preview-matrix-row">
                        <span class="preview-matrix-caption">变体</span>
                        <div class="preview-state-row" aria-label="变体对照">
                            <Button Variant="ButtonVariant.Solid">Solid</Button>
                            <Button Variant="ButtonVariant.Outline">Outline</Button>
                            <Button Variant="ButtonVariant.Soft">Soft</Button>
                            <Button Variant="ButtonVariant.Ghost">Ghost</Button>
                            <Button Variant="ButtonVariant.Link">Link</Button>
                        </div>
                    </div>
                    <div class="preview-matrix-row">
                        <span class="preview-matrix-caption">语意</span>
                        <div class="preview-state-row" aria-label="语意对照">
                            <Button Intent="ButtonIntent.Default">Default</Button>
                            <Button Intent="ButtonIntent.Neutral">Neutral</Button>
                            <Button Intent="ButtonIntent.Warning">Warning</Button>
                            <Button Intent="ButtonIntent.Danger">Danger</Button>
                        </div>
                    </div>
                    <div class="preview-matrix-row">
                        <span class="preview-matrix-caption">加载</span>
                        <div class="preview-state-row" aria-label="加载态对照">
                            <Button Variant="ButtonVariant.Solid" Loading="true">Solid</Button>
                            <Button Variant="ButtonVariant.Outline" Loading="true">Outline</Button>
                            <Button Variant="ButtonVariant.Soft" Loading="true">Soft</Button>
                            <Button Variant="ButtonVariant.Ghost" Loading="true">Ghost</Button>
                        </div>
                    </div>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="button-states"
                  Title="尺寸、图标与状态"
                  Description="三档尺寸、两端图标、加载与禁用；右侧控件即时生效。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-stack">
                    <Button Variant="@_variant"
                            Intent="@_intent"
                            Size="@_size"
                            Type="@_type"
                            Loading="@_loading"
                            Disabled="@_disabled"
                            FullWidth="@_fullWidth"
                            StartIcon="@(_hasIcon ? CheckIcon : null)"
                            OnClick="MarkInteraction">@_text</Button>
                    <span class="preview-feedback" role="status">@_interactionNote</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <label for="button-text">文本</label>
                    <input id="button-text" @bind="_text" />
                </div>
                <div class="control-grid">
                    <div class="control-field">
                        <span>变体</span>
                        <ShowcaseSelect TValue="ButtonVariant" Id="button-variant" AriaLabel="变体" Options="@(Enum.GetValues<ButtonVariant>())" @bind-Value="_variant" />
                    </div>
                    <div class="control-field">
                        <span>意图</span>
                        <ShowcaseSelect TValue="ButtonIntent" Id="button-intent" AriaLabel="意图" Options="@(Enum.GetValues<ButtonIntent>())" @bind-Value="_intent" />
                    </div>
                    <div class="control-field">
                        <span>尺寸</span>
                        <ShowcaseSelect TValue="Size" Id="button-size" AriaLabel="尺寸" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                    </div>
                    <div class="control-field">
                        <span>类型</span>
                        <ShowcaseSelect TValue="ButtonType" Id="button-type" AriaLabel="类型" Options="@(Enum.GetValues<ButtonType>())" @bind-Value="_type" />
                    </div>
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_loading">加载</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_disabled">禁用</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_fullWidth">占满宽度</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_hasIcon">起始图标</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="button-content-alignment"
                  Title="行内内容对齐"
                  Description="ContentAlignment=Start 让图标与文字从左侧起排并填满内容行，用于侧栏「新会话」这类整行动作。它只改变内容行的排布，按钮宽度仍由 FullWidth 决定，按钮自身的对齐契约不变。"
                  Code="@AlignmentCode">
            <Preview>
                <div class="preview-stack" style="max-width: 16rem;">
                    <Button ContentAlignment="ButtonContentAlignment.Start"
                            FullWidth
                            StartIcon="@CheckIcon"
                            OnClick="MarkInteraction">新会话</Button>
                    <Button ContentAlignment="ButtonContentAlignment.Start"
                            FullWidth
                            Variant="ButtonVariant.Outline"
                            OnClick="MarkInteraction">导入项目</Button>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="button-form"
                  Title="表单提交"
                  Description="需要提交表单时显式给 Type=Submit；默认的 Button 类型不会触发提交，避免误提交。"
                  Code="@FormCode">
            <Preview>
                <form method="post" @onsubmit="HandleSubmit" @onsubmit:preventDefault>
                    <div class="preview-action-row">
                        <Button Type="ButtonType.Submit">提交</Button>
                        <Button Type="ButtonType.Reset" Variant="ButtonVariant.Outline">重置</Button>
                    </div>
                </form>
                <span class="preview-feedback" role="status">@_interactionNote</span>
            </Preview>
        </DemoCard>
    </Demos>
    <Notes>
        <span>渲染为原生 <code>button</code>：Enter/空格激活，禁用态同时输出 <code>disabled</code> 与 <code>aria-disabled</code>。</span>
        <span><code>Type</code> 默认是 <code>Button</code> 而不是浏览器默认的 <code>submit</code>：放进表单也不会误提交。</span>
        <span>加载态只把内容换成忙碌指示并输出 <code>aria-busy</code>，不改变按钮墨色。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] ButtonRelated =
    [
        new("IconButton", "/components/icon-button"),
        new("MenuButton", "/components/menu-button"),
        new("SplitButton", "/components/split-button"),
        new("ButtonGroup", "/components/button-group")
    ];

    private const string BasicCode = """
        <Button Variant="ButtonVariant.Solid" OnClick="Save">保存</Button>
        <Button Variant="ButtonVariant.Outline">另存为</Button>
        <Button Variant="ButtonVariant.Ghost">取消</Button>
        """;

    private const string VariantCode = """
        <Button Variant="ButtonVariant.Soft" Intent="ButtonIntent.Warning" Loading="IsSaving">提交</Button>
        """;

    private const string StateCode = """
        <Button Variant="ButtonVariant.Solid" Size="Size.Large" StartIcon="CheckIcon" FullWidth>
            保存更改
        </Button>
        """;

    private const string AlignmentCode = """
        <Button ContentAlignment="ButtonContentAlignment.Start" FullWidth StartIcon="CheckIcon">
            新会话
        </Button>
        """;

    private const string FormCode = """
        <form method="post" @onsubmit="HandleSubmit">
            <Button Type="ButtonType.Submit">提交</Button>
            <Button Type="ButtonType.Reset" Variant="ButtonVariant.Outline">重置</Button>
        </form>
        """;

    private string _text = "保存更改";
    private ButtonVariant _variant = ButtonVariant.Solid;
    private ButtonIntent _intent = ButtonIntent.Default;
    private Size _size = Size.Medium;
    private ButtonType _type = ButtonType.Button;
    private bool _loading;
    private bool _disabled;
    private bool _fullWidth;
    private bool _hasIcon = true;

    private RenderFragment? CheckIcon => @<Icon Definition="@AeterniIcons.Check" />;

    private void HandleSubmit() => MarkInteraction(new MouseEventArgs());
}
