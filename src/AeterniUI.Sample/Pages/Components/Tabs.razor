@page "/components/tabs"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons

<PageTitle>Aeterni UI · Tabs</PageTitle>

<ComponentPage AnchorId="tabs"
               Category="导航组件"
               Title="Tabs / Tab"
               ComponentName="Tabs / Tab"
               Description="标签页导航：tablist / tab / tabpanel 三件套、roving tabindex、方向键自动激活与窄屏横向滚动。"
               Related="@TabsRelated">
    <WhenToUse>
        <p>同一区域的内容需要按视图切换时使用：详情页的概览 / 接口 / 历史。只切换一个值、内容不变时用 <code>Segmented</code>。</p>
        <p>Tabs 是内容控件，自身不提供表面（嵌在卡片里再套一层底会出现双层底），放进 <code>Surface</code> 或 <code>Card</code> 等宿主容器使用。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="tabs-basic"
                  Title="基础用法"
                  Description="每个 Tab 自己渲染按钮与面板，Value 是受控标识；禁用标签不可点、不可选中，也不进入方向键循环。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-stack preview-stack--fill">
                    <Surface Variant="SurfaceVariant.Elevated" Bordered>
                        <Tabs @bind-Value="_tabValue" AriaLabel="组件信息示例">
                            <Tab Value="overview">
                                <Header>概览</Header>
                                <ChildContent>
                                    <p class="preview-tab-text">概览面板：标签栏渲染在与面板分离的 <code>tablist</code> 里，面板由每个 <code>Tab</code> 自己渲染。</p>
                                </ChildContent>
                            </Tab>
                            <Tab Value="api">
                                <Header>接口</Header>
                                <ChildContent>
                                    <p class="preview-tab-text">接口面板：按钮 id 与面板 id 由注册顺序派生，<code>aria-controls</code> 与 <code>aria-labelledby</code> 自动成对。</p>
                                </ChildContent>
                            </Tab>
                            <Tab Value="keyboard">
                                <Header>键盘</Header>
                                <ChildContent>
                                    <p class="preview-tab-text">键盘面板：<code>ArrowLeft</code> / <code>ArrowRight</code> 与 <code>Home</code> / <code>End</code> 会同时移动焦点并切换选中项。</p>
                                </ChildContent>
                            </Tab>
                            <Tab Value="soon" Disabled>
                                <Header>禁用</Header>
                                <ChildContent>
                                    <p class="preview-tab-text">禁用面板：禁用标签不可点、不可选中，也不进入方向键循环。</p>
                                </ChildContent>
                            </Tab>
                        </Tabs>
                    </Surface>
                    <span class="preview-feedback" role="status">当前标签：@(_tabValue ?? "（未设置）")</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="tabs-header"
                  Title="Header 自定义内容"
                  Description="Header 是按钮里的自由内容：图标、计数或短标签都能放进去，面板内容仍由 ChildContent 决定。"
                  Code="@HeaderCode">
            <Preview>
                <div class="preview-stack preview-stack--fill">
                    <Surface Variant="SurfaceVariant.Elevated" Bordered>
                        <Tabs @bind-Value="_iconTabValue" AriaLabel="带图标的标签">
                            <Tab Value="overview">
                                <Header><Icon Definition="@AeterniIcons.Info" Size="Size.Small" /> 概览</Header>
                                <ChildContent>
                                    <p class="preview-tab-text">Header 只影响按钮内容，选中逻辑仍由 <code>Value</code> 决定。</p>
                                </ChildContent>
                            </Tab>
                            <Tab Value="checks">
                                <Header><Icon Definition="@AeterniIcons.Check" Size="Size.Small" /> 校验</Header>
                                <ChildContent>
                                    <p class="preview-tab-text">图标与文字一起参与按钮的可访问名称，不需要额外的 AriaLabel。</p>
                                </ChildContent>
                            </Tab>
                        </Tabs>
                    </Surface>
                    <span class="preview-feedback" role="status">当前标签：@(_iconTabValue ?? "（未设置）")</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="tabs-options"
                  Title="受控 Value 与可调属性"
                  Description="Value 由使用方持有：输入一个不存在的标识时组件按首个可用标签渲染，但不会改写 Value；右侧控件即时生效。"
                  Code="@OptionCode">
            <Preview>
                <div class="preview-stack preview-stack--fill">
                    <Surface Variant="SurfaceVariant.Elevated" Bordered>
                        <Tabs @bind-Value="_optionTabValue" AriaLabel="可调属性标签">
                            <Tab Value="overview" Visible="@(!_hideOverview)">
                                <Header>概览</Header>
                                <ChildContent>
                                    <p class="preview-tab-text">取消勾选「隐藏概览」后该标签与面板一起退出渲染。</p>
                                </ChildContent>
                            </Tab>
                            <Tab Value="api">
                                <Header>接口</Header>
                                <ChildContent>
                                    <p class="preview-tab-text">把 Value 改成 <code>api</code> 之外的任意值都不会报错：受控标识保持原样。</p>
                                </ChildContent>
                            </Tab>
                        </Tabs>
                    </Surface>
                    <span class="preview-feedback" role="status">当前标签：@(_optionTabValue ?? "（未设置）")</span>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_hideOverview">隐藏概览</Checkbox>
                <div class="control-field">
                    <label for="tabs-value">Value</label>
                    <input id="tabs-value" @bind="_optionTabValue" />
                </div>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>点击标签或使用方向键切换；禁用的标签同时退出点击、选中和方向键循环，键盘用户不会停在不可用的标签上。</span>
        <span>把 <code>Value</code> 清空或填一个不存在的标识时，组件默认把首个可用标签当作选中项渲染，但不会改写 <code>Value</code>：受控标识始终由使用方持有。</span>
        <span>窄屏下标签栏横向滚动而不是换行；组件不自带表面，只给标签栏一条 <code>--aeterni-separator</code> 底部分界线。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] TabsRelated =
    [
        new("Segmented", "/components/segmented"),
        new("Menu", "/components/menu"),
        new("Accordion", "/components/accordion"),
        new("Stepper", "/components/stepper")
    ];

    private const string BasicCode = """
        <Tabs @bind-Value="TabValue" AriaLabel="组件信息">
            <Tab Value="overview">
                <Header>概览</Header>
                <ChildContent>概览面板</ChildContent>
            </Tab>
            <Tab Value="api">
                <Header>接口</Header>
                <ChildContent>接口面板</ChildContent>
            </Tab>
            <Tab Value="soon" Disabled>
                <Header>禁用</Header>
                <ChildContent>禁用面板</ChildContent>
            </Tab>
        </Tabs>
        """;

    private const string HeaderCode = """
        <Tab Value="checks">
            <Header><Icon Definition="AeterniIcons.Check" Size="Size.Small" /> 校验</Header>
            <ChildContent>校验面板</ChildContent>
        </Tab>
        """;

    private const string OptionCode = """
        <Tabs Value="TabValue" ValueChanged="HandleTabChanged" AriaLabel="组件信息">
            <Tab Value="overview" Visible="ShowOverview">
                <Header>概览</Header>
                <ChildContent>概览面板</ChildContent>
            </Tab>
        </Tabs>
        """;

    private string? _tabValue = "overview";
    private string? _iconTabValue = "checks";
    private string? _optionTabValue = "overview";
    private bool _hideOverview;
}
