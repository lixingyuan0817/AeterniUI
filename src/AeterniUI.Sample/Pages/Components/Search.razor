@page "/components/search"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums
@using AeterniUI.Icons
@using AeterniUI.Models.Dialog
@using AeterniUI.Services.Impl

<PageTitle>Aeterni UI · Search</PageTitle>

<ComponentPreview AnchorId="search"
                  Category="表单组件"
                  Title="Search"
                  ComponentName="Search"
                  Description="关键词查询入口，输入框内置清除与搜索图标按钮，支持 Enter 提交和受控加载状态；不渲染建议列表或查询结果。">
    <Preview>
        <div class="preview-form-control preview-form-control--fill">
            <FormField Label="组件查询"
                       Description="输入关键词后按 Enter 或点击输入框内的搜索按钮。"
                       Disabled="@_disabled"
                       Invalid="@_invalid">
                <Search @bind-Value="_query"
                        Size="@_size"
                        Placeholder="@_placeholder"
                        Clearable="@_clearable"
                        Loading="@_loading"
                        SubmitOnEnter="@_submitOnEnter"
                        FullWidth="@_fullWidth"
                        AriaLabel="组件查询"
                        OnSearch="HandleSearchAsync"
                        OnClear="HandleClearAsync" />
            </FormField>
            <span class="preview-feedback" role="status">@_status</span>
        </div>
    </Preview>
    <Controls>
        <div class="control-field">
            <label for="search-placeholder">Placeholder</label>
            <input id="search-placeholder" @bind="_placeholder" />
        </div>
        <div class="control-grid">
            <div class="control-field">
                <span>Size</span>
                <ShowcaseSelect TValue="Size" Id="search-size" AriaLabel="Search Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
            </div>
        </div>
        <Checkbox Size="Size.Small" @bind-Value="_clearable">Clearable</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_submitOnEnter">SubmitOnEnter</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_loading">Loading</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_disabled">Disabled</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
        <Checkbox Size="Size.Small" @bind-Value="_fullWidth">FullWidth</Checkbox>
    </Controls>
    <Notes>
        <span>Search 内置搜索图标按钮，只负责关键词输入和提交；不内置建议列表、远程数据源或查询结果，需要输入建议时使用 Autocomplete。</span>
        <span>Loading 会暂时禁用输入、清除和搜索操作，阻止重复提交并输出 aria-busy；输入值仍由宿主通过标准绑定持有。</span>
    </Notes>
</ComponentPreview>

@code {
    private string? _query;
    private string _placeholder = "搜索组件名称…";
    private string _status = "尚未提交查询";
    private Size _size = Size.Default;
    private bool _clearable = true;
    private bool _submitOnEnter = true;
    private bool _loading;
    private bool _disabled;
    private bool _invalid;
    private bool _fullWidth;

    private Task HandleSearchAsync(string? value)
    {
        _status = string.IsNullOrWhiteSpace(value)
            ? "已提交空查询"
            : $"最近查询：{value}";
        return Task.CompletedTask;
    }

    private Task HandleClearAsync()
    {
        _status = "已清除查询";
        return Task.CompletedTask;
    }
}
