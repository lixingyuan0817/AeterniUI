@page "/components/search"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · Search</PageTitle>

<ComponentPage AnchorId="search"
               Category="表单组件"
               Title="Search"
               ComponentName="Search"
               Description="带提交与清空动作的关键词输入：把查询的两种动作固定在控件内部。"
               Related="@SearchRelated">
    <WhenToUse>
        <p>列表或站点的关键词检索入口用它：输入、回车或点按钮提交、一键清空。输入即筛选（无提交动作）的场景用 <code>Input</code> 配合自己的防抖。</p>
        <p>需要边输入边提示候选词时用 <code>Autocomplete</code>；<code>Search</code> 只负责把词交给宿主。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="search-basic"
                  Title="基础用法"
                  Description="SubmitOnEnter 决定回车是否提交；提交与清空分别回调目标宿主。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <FormField Label="组件查询"
                               Description="输入关键词后按 Enter 或点击输入框内的搜索按钮。">
                        <Search @bind-Value="_query"
                                Placeholder="搜索组件名称…"
                                OnSearch="HandleSearchAsync"
                                OnClear="HandleClearAsync"
                                AriaLabel="组件查询" />
                    </FormField>
                    <span class="preview-feedback" role="status">@_status</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="search-loading"
                  Title="提交、清空与加载"
                  Description="Loading 让按钮进入忙碌态并阻止重复提交；Clearable 提供清空动作，清空同样会回调宿主。"
                  Code="@LoadingCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <Search @bind-Value="_loadingQuery"
                            Size="@_size"
                            Clearable="@_clearable"
                            Loading="@_loading"
                            SubmitOnEnter="@_submitOnEnter"
                            OnSearch="HandleLoadingSearchAsync"
                            OnClear="HandleLoadingClearAsync"
                            AriaLabel="带状态的搜索" />
                    <span class="preview-feedback" role="status">@_loadingStatus</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Size</span>
                    <ShowcaseSelect TValue="Size" Id="search-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_size" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_clearable">Clearable</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_loading">Loading</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_submitOnEnter">SubmitOnEnter</Checkbox>
            </Controls>
        </DemoCard>

        <DemoCard Id="search-states"
                  Title="状态与整宽"
                  Description="禁用与无效状态由字段或参数驱动；FullWidth 让输入框撑满容器，动作按钮仍贴在输入框内部。"
                  Code="@StateCode">
            <Preview>
                <div class="preview-form-control preview-form-control--fill">
                    <FormField Label="组件查询"
                               Description="字段状态同时影响输入框与动作按钮。"
                               Disabled="@_disabled"
                               Invalid="@_invalid">
                        <Search @bind-Value="_stateQuery"
                                Placeholder="搜索组件名称…"
                                FullWidth="@_fullWidth"
                                AriaLabel="状态演示搜索" />
                    </FormField>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_disabled">Disabled</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_invalid">Invalid</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_fullWidth">FullWidth</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>组件只报告「提交」与「清空」两个动作，不发起查询、不缓存结果。</span>
        <span>提交按钮与清空按钮各自有独立焦点与无障碍名称，名称取文案表的 <code>SearchSubmitLabel</code> / <code>SearchClearLabel</code>。</span>
        <span><code>Loading</code> 只让提交动作忙碌，输入框仍可编辑——需要整体禁用请用 <code>Disabled</code>。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] SearchRelated =
    [
        new("Input", "/components/input"),
        new("Autocomplete", "/components/autocomplete"),
        new("Button", "/components/button")
    ];

    private const string BasicCode = """
        <Search @bind-Value="Query" Placeholder="搜索组件名称…"
                OnSearch="RunQuery" OnClear="ResetQuery" />
        """;

    private const string LoadingCode = """
        <Search @bind-Value="Query" Loading="IsLoading" Clearable="false" SubmitOnEnter
                OnSearch="RunQuery" />
        """;

    private const string StateCode = """
        <FormField Label="组件查询" Invalid>
            <Search @bind-Value="Query" FullWidth />
        </FormField>
        """;

    private string? _query;
    private string _status = "尚未提交查询";

    private string? _loadingQuery;
    private string _loadingStatus = "尚未提交查询";
    private Size _size = Size.Default;
    private bool _clearable = true;
    private bool _loading;
    private bool _submitOnEnter = true;

    private string? _stateQuery;
    private bool _disabled;
    private bool _invalid;
    private bool _fullWidth;

    private Task HandleSearchAsync(string? value)
    {
        _status = string.IsNullOrWhiteSpace(value) ? "没有关键词。" : $"已提交查询：{value}";
        return Task.CompletedTask;
    }

    private Task HandleClearAsync()
    {
        _status = "已清空关键词。";
        return Task.CompletedTask;
    }

    private Task HandleLoadingSearchAsync(string? value)
    {
        _loadingStatus = string.IsNullOrWhiteSpace(value) ? "没有关键词。" : $"正在检索：{value}";
        return Task.CompletedTask;
    }

    private Task HandleLoadingClearAsync()
    {
        _loadingStatus = "已清空关键词。";
        return Task.CompletedTask;
    }
}
