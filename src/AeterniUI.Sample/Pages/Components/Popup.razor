@page "/components/popup"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · PopupHost / Popover</PageTitle>

<ComponentPage AnchorId="popup"
               Category="通知组件"
               Title="PopupHost / Popover"
               ComponentName="PopupHost / Popover"
               Description="浮层组合：PopupHost 提供定位上下文，Popover 承载 region / dialog 语义与关闭策略。"
               Related="@PopupRelated">
    <WhenToUse>
        <p>内容需要贴着触发元素出现、且不必离开当前页面时使用：补充说明、快捷操作、小型表单。整页级的模态任务用 <code>Dialog</code>，纯文字提示用 <code>Tooltip</code>。</p>
        <p><code>PopupHost</code> 只提供相对定位的锚点容器，浮层本身是 <code>Popover</code>，两者成对使用；<code>Open</code> 始终由使用方持有。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="popup-basic"
                  Title="基础浮层"
                  Description="非模态浮层输出 region 语义：Escape 与点击外部都会请求关闭，但不会抢走页面焦点、也不锁背景滚动。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-overlay-demo">
                    <PopupHost>
                        <div class="preview-overlay-demo__anchor">
                            <span class="preview-overlay-demo__label">触发元素</span>
                            <Button Variant="ButtonVariant.Outline"
                                    AriaLabel='@(_basicOpen ? "关闭 Popover 浮层" : "打开 Popover 浮层")'
                                    aria-expanded='@(_basicOpen ? "true" : "false")'
                                    OnClick="ToggleBasic">@(_basicOpen ? "关闭 Popover" : "打开 Popover")</Button>
                        </div>
                        <Popover Open="@_basicOpen"
                                 OpenChanged="HandleBasicOpenChanged"
                                 Placement="PopupPlacement.BottomStart"
                                 AriaLabel="基础浮层">
                            <Header>
                                <div class="preview-overlay-demo__popover-title">
                                    <strong>浮层标题</strong>
                                    <span>Popover · region</span>
                                </div>
                            </Header>
                            <ChildContent>
                                <div class="preview-overlay-demo__popover-body">
                                    <p>这是一个有标题、说明文字和操作内容的基础浮层。</p>
                                    <ul>
                                        <li>点击「打开 Popover」显示内容</li>
                                        <li>Escape 或点击浮层外部收起</li>
                                        <li>空间不足时翻转到另一侧，并贴住视口边缘</li>
                                    </ul>
                                    <div class="preview-overlay-demo__popover-actions">
                                        <Button Size="Size.Small" OnClick="PreviewPopoverAction">了解更多</Button>
                                        <Button Size="Size.Small" Variant="ButtonVariant.Ghost" OnClick="CloseBasic">关闭浮层</Button>
                                    </div>
                                </div>
                            </ChildContent>
                        </Popover>
                    </PopupHost>
                    <p class="preview-overlay-demo__hint" role="status">@_basicNote</p>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="popup-modal"
                  Title="模态浮层"
                  Description="Modal 额外提供遮罩、aria-modal、Tab 焦点陷阱与背景滚动锁，关闭后把焦点还给触发元素。"
                  Code="@ModalCode">
            <Preview>
                <div class="preview-overlay-demo">
                    <PopupHost>
                        <div class="preview-overlay-demo__anchor">
                            <span class="preview-overlay-demo__label">触发元素</span>
                            <Button Variant="ButtonVariant.Outline"
                                    AriaLabel='@(_modalOpen ? "关闭模态浮层" : "打开模态浮层")'
                                    aria-expanded='@(_modalOpen ? "true" : "false")'
                                    OnClick="ToggleModal">@(_modalOpen ? "关闭模态浮层" : "打开模态浮层")</Button>
                        </div>
                        <Popover Open="@_modalOpen"
                                 OpenChanged="HandleModalOpenChanged"
                                 Placement="PopupPlacement.BottomStart"
                                 Modal
                                 RestoreFocusOnClose
                                 AriaLabel="模态浮层">
                            <Header>
                                <div class="preview-overlay-demo__popover-title">
                                    <strong>删除这条记录？</strong>
                                    <span>Popover · dialog</span>
                                </div>
                            </Header>
                            <ChildContent>
                                <div class="preview-overlay-demo__popover-body">
                                    <p>模态形态把注意力锁在浮层里：Tab 在浮层内循环，遮罩与 Escape 都会请求关闭。</p>
                                    <div class="preview-overlay-demo__popover-actions">
                                        <Button Size="Size.Small" Intent="ButtonIntent.Danger" OnClick="ConfirmModal">确认删除</Button>
                                        <Button Size="Size.Small" Variant="ButtonVariant.Ghost" OnClick="CloseModal">取消</Button>
                                    </div>
                                </div>
                            </ChildContent>
                        </Popover>
                    </PopupHost>
                    <p class="preview-overlay-demo__hint" role="status">@_modalNote</p>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="popup-options"
                  Title="方位与关闭策略"
                  Description="Placement 给出四个起始方位，越界时自动翻转；MinWidth / Width 控制浮层宽度，四个关闭开关与焦点恢复都能单独切换。"
                  Code="@OptionCode">
            <Preview>
                <div class="preview-overlay-demo">
                    <PopupHost>
                        <div class="preview-overlay-demo__anchor">
                            <span class="preview-overlay-demo__label">触发元素</span>
                            <Button Variant="ButtonVariant.Outline"
                                    AriaLabel='@(_optionsOpen ? "关闭可调浮层" : "打开可调浮层")'
                                    aria-expanded='@(_optionsOpen ? "true" : "false")'
                                    OnClick="ToggleOptions">@(_optionsOpen ? "关闭可调浮层" : "打开可调浮层")</Button>
                        </div>
                        <Popover Open="@_optionsOpen"
                                 OpenChanged="HandleOptionsOpenChanged"
                                 Placement="@_placement"
                                 MinWidth="@OptionsMinWidth"
                                 Width="@OptionsWidth"
                                 Modal="_optionsModal"
                                 CloseOnEscape="_optionsCloseOnEscape"
                                 CloseOnOutsideClick="_optionsCloseOnOutsideClick"
                                 CloseOnScroll="_optionsCloseOnScroll"
                                 RestoreFocusOnClose="_optionsRestoreFocus"
                                 AriaLabel="可调浮层">
                            <Header>
                                <div class="preview-overlay-demo__popover-title">
                                    <strong>浮层标题</strong>
                                    <span>Popover · region</span>
                                </div>
                            </Header>
                            <ChildContent>
                                <div class="preview-overlay-demo__popover-body">
                                    <p>当前方位：<code>@_placement</code>；右侧控件即时生效。</p>
                                </div>
                            </ChildContent>
                        </Popover>
                    </PopupHost>
                    <p class="preview-overlay-demo__hint" role="status">@_optionsNote</p>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>Placement</span>
                    <ShowcaseSelect TValue="PopupPlacement" Id="popover-placement" AriaLabel="Placement" Options="@(Enum.GetValues<PopupPlacement>())" @bind-Value="_placement" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_optionsModal">Modal</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_optionsNarrow">窄最小宽度（10rem 档）</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_optionsFixedWidth">固定宽度（24rem）</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_optionsCloseOnEscape">CloseOnEscape</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_optionsCloseOnOutsideClick">CloseOnOutsideClick</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_optionsCloseOnScroll">CloseOnScroll</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_optionsRestoreFocus">RestoreFocusOnClose</Checkbox>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>浮层定位在 <code>PopupHost</code>（<code>position: relative</code>）内：空间不足时翻到另一侧并把内容贴回视口，<code>Placement</code> 只决定起始方位。</span>
        <span><code>Escape</code>、点击外部、<code>Modal</code> 遮罩与页面滚动都只通过 <code>OpenChanged</code> 请求关闭，配合 <code>@@bind-Open</code> 使用。</span>
        <span><code>Modal</code> 额外提供遮罩、<code>aria-modal</code>、焦点陷阱与背景滚动锁；非模态形态只输出 <code>region</code> 语义，不抢焦点也不锁滚动。</span>
        <span><code>MinWidth</code> / <code>Width</code> 接受任意 CSS 长度，写进根 <code>style</code> 的 <code>--aeterni-popover-min-width</code> / <code>--aeterni-popover-width</code>，和宿主自己的 <code>Style</code> 声明互不覆盖；菜单型弹层默认使用更窄的 <code>--aeterni-overlay-min-width-xs</code>。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] PopupRelated =
    [
        new("Tooltip", "/components/tooltip"),
        new("Dialog / Confirm / Alert / Toast", "/components/feedback"),
        new("Drawer", "/components/drawer"),
        new("MenuButton", "/components/menu-button")
    ];

    private const string BasicCode = """
        <PopupHost>
            <Button AriaLabel="打开浮层" OnClick="Toggle">打开浮层</Button>
            <Popover Open="IsOpen"
                     OpenChanged="HandleOpenChanged"
                     Placement="PopupPlacement.BottomStart"
                     AriaLabel="示例浮层">
                <Header><strong>浮层标题</strong></Header>
                <ChildContent>浮层内容</ChildContent>
            </Popover>
        </PopupHost>
        """;

    private const string ModalCode = """
        <Popover Open="IsOpen"
                 OpenChanged="HandleOpenChanged"
                 Modal
                 RestoreFocusOnClose
                 AriaLabel="模态浮层">
            <ChildContent>模态内容</ChildContent>
        </Popover>
        """;

    private const string OptionCode = """
        <Popover Open="IsOpen"
                 OpenChanged="HandleOpenChanged"
                 Placement="PopupPlacement.TopEnd"
                 MinWidth="var(--aeterni-overlay-min-width-xs)"
                 Width="24rem"
                 CloseOnEscape="CloseOnEscape"
                 CloseOnOutsideClick="CloseOnOutsideClick"
                 CloseOnScroll="CloseOnScroll"
                 AriaLabel="示例浮层">
            <ChildContent>浮层内容</ChildContent>
        </Popover>
        """;

    private bool _basicOpen;
    private string _basicNote = "浮层当前为关闭状态，点击「打开 Popover」查看内容。";

    private bool _modalOpen;
    private string _modalNote = "模态浮层当前为关闭状态，打开后 Tab 会困在浮层内。";

    private bool _optionsOpen;
    private PopupPlacement _placement = PopupPlacement.BottomStart;
    private bool _optionsModal;
    private bool _optionsNarrow;
    private bool _optionsFixedWidth;
    private bool _optionsCloseOnEscape = true;
    private bool _optionsCloseOnOutsideClick = true;
    private bool _optionsCloseOnScroll;
    private bool _optionsRestoreFocus = true;
    private string _optionsNote = "浮层当前为关闭状态，切换右侧属性后再打开查看。";

    // Width parameters are CSS length values; null keeps the popover defaults so the
    // demo can show both the stock and the overridden width without fake markup.
    private string? OptionsMinWidth => _optionsNarrow ? "var(--aeterni-overlay-min-width-xs)" : null;

    private string? OptionsWidth => _optionsFixedWidth ? "24rem" : null;

    private void HandleBasicOpenChanged(bool open)
    {
        _basicOpen = open;
        _basicNote = open ? "浮层已打开；按 Escape 或点外部可以关闭。" : "浮层已由 Escape 或外部点击关闭。";
    }

    private void ToggleBasic(MouseEventArgs _)
    {
        _basicOpen = !_basicOpen;
        _basicNote = _basicOpen
            ? "浮层已打开：内容以 region 语义展示在触发元素下方。"
            : "浮层已关闭：内容通过 hidden 移除。";
    }

    private void CloseBasic(MouseEventArgs _)
    {
        _basicOpen = false;
        _basicNote = "浮层已关闭：内容通过 hidden 移除。";
    }

    private void PreviewPopoverAction(MouseEventArgs _) => _basicNote = "「了解更多」已触发示例动作，浮层保持打开。";

    private void HandleModalOpenChanged(bool open)
    {
        _modalOpen = open;
        _modalNote = open ? "模态浮层已打开：Tab 在浮层内循环，背景滚动被锁。" : "模态浮层已关闭，焦点回到触发按钮。";
    }

    private void ToggleModal(MouseEventArgs _)
    {
        _modalOpen = !_modalOpen;
        _modalNote = _modalOpen ? "模态浮层已打开：遮罩、焦点陷阱与滚动锁同时生效。" : "模态浮层已关闭，焦点回到触发按钮。";
    }

    private void ConfirmModal(MouseEventArgs _)
    {
        _modalOpen = false;
        _modalNote = "已确认删除：宿主在回调里执行动作，并把 Open 置回 false。";
    }

    private void CloseModal(MouseEventArgs _)
    {
        _modalOpen = false;
        _modalNote = "已取消：浮层关闭，焦点回到触发按钮。";
    }

    private void HandleOptionsOpenChanged(bool open)
    {
        _optionsOpen = open;
        _optionsNote = open ? $"浮层已打开，方位 {_placement}。" : "浮层已按当前策略关闭。";
    }

    private void ToggleOptions(MouseEventArgs _)
    {
        _optionsOpen = !_optionsOpen;
        _optionsNote = _optionsOpen ? $"浮层已打开，方位 {_placement}。" : "浮层已关闭。";
    }
}
