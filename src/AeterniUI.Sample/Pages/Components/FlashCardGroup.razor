@page "/components/flash-card-group"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · FlashCardGroup</PageTitle>

<ComponentPage AnchorId="flash-card-group"
               Category="基础组件"
               Title="FlashCardGroup"
               ComponentName="FlashCardGroup"
               Description="把多张闪卡收拢成牌堆，悬浮或键盘聚焦时展开成扇形。"
               Related="@FlashCardGroupRelated">
    <WhenToUse>
        <p>多张闪卡需要以牌堆的形式介绍、体验或抽取时使用：卡牌游戏、皮肤墙、礼包预览。单张图片卡用 <code>FlashCard</code>，普通卡片列表用 <code>Card</code>。</p>
        <p>组件只负责叠放与扇形展开：翻面、抽到哪张以及抽取结果都由宿主持有。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="flash-card-group-deck"
                  Title="收拢的牌堆"
                  Description="默认保持收拢，指针悬浮或组内卡片获得焦点时展开成扇形；展开后当前卡片会继续从扇形中抽出，方便看完整卡面。"
                  Code="@DeckCode">
            <Preview>
                <div class="preview-flash-card-group-demo">
                    <div class="preview-flash-card-group-stage">
                        <FlashCardGroup AriaLabel="魔法卡牌堆" HoverExpand="true" CardWidth="220" ExpandedSpacing="72">
                            @foreach (var card in DeckCards)
                            {
                                <FlashCard @key="card.Id"
                                           ImageSrc="@CoverImage"
                                           ImageAlt="@card.Alt"
                                           Title="@card.Title"
                                           Description="@card.Description"
                                           Sheen="@card.Sheen"
                                           AriaLabel="@card.Title" />
                            }
                        </FlashCardGroup>
                    </div>
                    <span class="preview-feedback" role="status">牌堆收拢，悬浮或 Tab 到任意卡片即展开</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="flash-card-group-expanded"
                  Title="固定展开"
                  Description="HoverExpand 关闭后展开只由 Expanded 决定，牌堆稳定停在扇形上；CardWidth 与 ExpandedSpacing 决定每张卡的宽度与水平间距。"
                  Code="@ExpandedCode">
            <Preview>
                <div class="preview-flash-card-group-demo">
                    <div class="preview-flash-card-group-stage">
                        <FlashCardGroup AriaLabel="固定展开的牌堆"
                                        Expanded="true"
                                        HoverExpand="false"
                                        CardWidth="180"
                                        ExpandedSpacing="48">
                            @foreach (var card in CompactCards)
                            {
                                <FlashCard @key="card.Id"
                                           ImageSrc="@CoverImage"
                                           ImageAlt="@card.Alt"
                                           Title="@card.Title"
                                           Description="@card.Description"
                                           Sheen="@card.Sheen"
                                           AriaLabel="@card.Title" />
                            }
                        </FlashCardGroup>
                    </div>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="flash-card-group-tuning"
                  Title="抽卡与尺寸调节"
                  Description="抽卡只是宿主重新排列牌堆内容，组件负责叠放与展开；右侧控件即时生效。"
                  Code="@TuningCode">
            <Preview>
                <div class="preview-flash-card-group-demo">
                    <div class="preview-flash-card-group-stage">
                        <FlashCardGroup AriaLabel="魔法卡牌堆"
                                        Expanded="@_expanded"
                                        HoverExpand="@_hoverExpand"
                                        Disabled="@_disabled"
                                        CardWidth="@_cardWidth"
                                        ExpandedSpacing="@_expandedSpacing">
                            @foreach (var card in Cards)
                            {
                                <FlashCard @key="card.Id"
                                           ImageSrc="@CoverImage"
                                           ImageAlt="@card.Alt"
                                           Title="@card.Title"
                                           Description="@card.Description"
                                           Sheen="@card.Sheen"
                                           AriaLabel="@card.Title" />
                            }
                        </FlashCardGroup>
                    </div>
                    <span class="preview-feedback" role="status">@_status</span>
                </div>
            </Preview>
            <Controls>
                <Button Variant="ButtonVariant.Outline" OnClick="DrawRandomCard">抽一张卡</Button>
                <Checkbox Size="Size.Small" @bind-Value="_hoverExpand">悬浮/聚焦展开</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_expanded">保持展开</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_disabled">禁用牌堆</Checkbox>
                <div class="control-field">
                    <span>CardWidth</span>
                    <ShowcaseSelect TValue="double" Id="flash-card-group-width" AriaLabel="CardWidth" Options="@Widths" TextSelector="@(value => $"{value}px")" @bind-Value="_cardWidth" />
                </div>
                <div class="control-field">
                    <span>ExpandedSpacing</span>
                    <ShowcaseSelect TValue="double" Id="flash-card-group-spacing" AriaLabel="ExpandedSpacing" Options="@Spacings" TextSelector="@(value => $"{value}px")" @bind-Value="_expandedSpacing" />
                </div>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>键盘用户通过组内 <code>FlashCard</code> 的 Tab 停留点触发展开；<code>prefers-reduced-motion: reduce</code> 下保留牌堆布局、取消展开过渡。</span>
        <span><code>Disabled</code> 的牌堆输出 <code>aria-disabled</code> 并带上 <code>inert</code>，整堆卡片同时退出指针与键盘交互。</span>
        <span><code>CollapsedOffset</code> 控制收拢时每张卡的垂直错位。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] FlashCardGroupRelated =
    [
        new("FlashCard", "/components/flash-card"),
        new("Card", "/components/card"),
        new("Surface", "/components/surface")
    ];

    private const string DeckCode = """
        <FlashCardGroup AriaLabel="魔法卡牌堆" HoverExpand="true" CardWidth="220" ExpandedSpacing="72">
            <FlashCard ImageSrc="images/flash-card/card-art.svg" ImageAlt="抽象渐变卡面" Title="火焰法阵" />
            <FlashCard ImageSrc="images/flash-card/card-art.svg" ImageAlt="抽象渐变卡面" Title="月影咒语" Sheen="FlashCardSheen.Shine" />
        </FlashCardGroup>
        """;

    private const string ExpandedCode = """
        <FlashCardGroup Expanded="true" HoverExpand="false" CardWidth="180" ExpandedSpacing="48">
            <FlashCard ImageSrc="images/flash-card/card-art.svg" ImageAlt="抽象渐变卡面" Title="星尘秘术" />
        </FlashCardGroup>
        """;

    private const string TuningCode = """
        <FlashCardGroup Expanded="Expanded"
                        HoverExpand="HoverExpand"
                        Disabled="Disabled"
                        CardWidth="220"
                        ExpandedSpacing="72">
            @foreach (var card in Cards)
            {
                <FlashCard @key="card.Id"
                           ImageSrc="images/flash-card/card-art.svg"
                           ImageAlt="@card.Alt"
                           Title="@card.Title"
                           Description="@card.Description"
                           Sheen="@card.Sheen" />
            }
        </FlashCardGroup>
        """;

    private const string CoverImage = "images/flash-card/card-art.svg";

    private bool _hoverExpand = true;
    private bool _expanded;
    private bool _disabled;
    private double _cardWidth = 220;
    private double _expandedSpacing = 72;
    private string _status = "牌堆已收拢，悬浮任意卡片抽出查看";
    private int _drawOffset;

    private static readonly double[] Widths = [180, 220, 260];
    private static readonly double[] Spacings = [48, 72, 96];

    private static readonly IReadOnlyList<DeckCard> DeckCards =
    [
        new("fire", "火焰法阵", "稀有 · 火焰", "抽象渐变卡面", FlashCardSheen.Holo),
        new("moon", "月影咒语", "史诗 · 月影", "抽象渐变卡面", FlashCardSheen.Shine),
        new("storm", "风暴召唤", "传说 · 风暴", "抽象渐变卡面", FlashCardSheen.Holo),
        new("star", "星尘秘术", "稀有 · 星尘", "抽象渐变卡面", FlashCardSheen.Shine),
        new("unknown", "未知奖励", "普通 · 未鉴定", "抽象渐变卡面", FlashCardSheen.Holo)
    ];

    private static readonly IReadOnlyList<DeckCard> CompactCards =
    [
        new("fire", "火焰法阵", "稀有 · 火焰", "抽象渐变卡面", FlashCardSheen.Holo),
        new("moon", "月影咒语", "史诗 · 月影", "抽象渐变卡面", FlashCardSheen.Shine),
        new("storm", "风暴召唤", "传说 · 风暴", "抽象渐变卡面", FlashCardSheen.None)
    ];

    private IReadOnlyList<DeckCard> Cards
    {
        get
        {
            var cards = DeckCards;
            return Enumerable.Range(0, cards.Count)
                .Select(index => cards[(index + _drawOffset) % cards.Count])
                .ToArray();
        }
    }

    private void DrawRandomCard()
    {
        _drawOffset = (_drawOffset + 1) % DeckCards.Count;
        _status = $"抽到：{Cards[0].Title} · 当前牌堆共 {Cards.Count} 张";
        _expanded = true;
    }

    private sealed record DeckCard(string Id, string Title, string Description, string Alt, FlashCardSheen Sheen);
}
