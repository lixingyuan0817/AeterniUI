@page "/components/virtual-list"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · VirtualList</PageTitle>

<ComponentPage AnchorId="virtual-list"
               Category="导航组件"
               Title="VirtualList"
               ComponentName="VirtualList&lt;TItem&gt;"
               Description="只渲染视口附近的固定行高项目，适合大数据量的内存集合。"
               Related="@VirtualListRelated">
    <WhenToUse>
        <p>内存里已有成百上千条同质记录、需要滚动查看或选中时使用。条目少或行高不定时用 <code>List</code>；需要可折叠分组的层级导航用 <code>Menu</code>。</p>
        <p>行高是固定值（<code>ItemSize</code>，单位 CSS px），组件据此换算总高度与可见区间；每行内容必须等高，否则滚动位置会漂移。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="virtual-list-basic"
                  Title="大数据量与单选"
                  Description="250 条记录只渲染视口附近的行；SelectionMode 打开后与 List 一样输出 listbox 语义，SelectedValue 拿到的是项目本身。右侧控件改的是视口高度、固定行高与选择模式。"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-list-wrap">
                    <VirtualList Items="@_rows"
                                 Height="@_listHeight"
                                 ItemSize="@_itemSize"
                                 OverscanCount="6"
                                 SelectionMode="@_selectionMode"
                                 @bind-SelectedValue="_selected"
                                 ItemKeySelector="row => row.Id"
                                 AriaLabel="虚拟项目列表">
                        <ItemTemplate Context="row">
                            <span>@row.Id</span>
                            <span class="preview-value">@row.Label</span>
                        </ItemTemplate>
                    </VirtualList>
                    <span class="preview-feedback" role="status">模式 @_selectionMode：当前值 @(_selected?.ToString() ?? "未选择")，共 @_rows.Count 条</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-grid">
                    <div class="control-field">
                        <span>Height</span>
                        <ShowcaseSelect TValue="string" Id="virtual-list-height" AriaLabel="Height" Options="@ListHeights" @bind-Value="_listHeight" />
                    </div>
                    <div class="control-field">
                        <span>SelectionMode</span>
                        <ShowcaseSelect TValue="SelectionMode" Id="virtual-list-mode" AriaLabel="SelectionMode" Options="@SelectionModes" @bind-Value="_selectionMode" />
                    </div>
                    <div class="control-field">
                        <label for="virtual-list-item-size">ItemSize</label>
                        <input id="virtual-list-item-size" type="number" min="24" max="48" step="4" @bind="_itemSize" />
                    </div>
                </div>
            </Controls>
        </DemoCard>

        <DemoCard Id="virtual-list-loadmore"
                  Title="触底加载更多"
                  Description="滚动接近底部时触发 OnLoadMore，宿主追加项目并把 HasMoreItems 与 LoadingMore 写回；组件只负责判断阈值。"
                  Code="@LoadMoreCode">
            <Preview>
                <div class="preview-list-wrap">
                    <VirtualList Items="@_moreRows"
                                 Height="280px"
                                 ItemSize="32"
                                 LoadMoreThreshold="96"
                                 HasMoreItems="@_hasMoreItems"
                                 LoadingMore="@_loadingMore"
                                 OnLoadMore="LoadMoreAsync"
                                 ItemKeySelector="row => row.Id"
                                 AriaLabel="触底加载更多">
                        <ItemTemplate Context="row">
                            <span>@row.Id</span>
                            <span class="preview-value">@row.Label</span>
                        </ItemTemplate>
                    </VirtualList>
                    <span class="preview-feedback" role="status">@_loadMoreNote</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="virtual-list-options"
                  Title="多选、禁用行与空集合"
                  Description="多选沿用 SelectedValues，DisabledSelector 按项目禁用；集合为空时由 EmptyContent 接管视口，不再渲染行。"
                  Code="@OptionsCode">
            <Preview>
                <div class="preview-list-wrap">
                    <VirtualList Items="@_rows"
                                 Height="200px"
                                 ItemSize="32"
                                 SelectionMode="SelectionMode.Multiple"
                                 DisabledSelector="IsRowDisabled"
                                 SelectedValues="@_multiSelected"
                                 SelectedValuesChanged="HandleMultiChanged"
                                 ItemKeySelector="row => row.Id"
                                 AriaLabel="虚拟项目多选">
                        <ItemTemplate Context="row">
                            <span>@row.Id</span>
                            <span class="preview-value">@row.Label</span>
                        </ItemTemplate>
                    </VirtualList>
                    <VirtualList Items="@_emptyRows"
                                 Height="120px"
                                 ItemSize="32"
                                 AriaLabel="空集合">
                        <EmptyContent>
                            <span class="preview-value">没有可显示的记录</span>
                        </EmptyContent>
                    </VirtualList>
                    <span class="preview-feedback" role="status">已选 @_multiSelected.Count 项</span>
                </div>
            </Preview>
        </DemoCard>
    </Demos>
    <Notes>
        <span>视口只渲染可见区间加上 <code>OverscanCount</code> 条预渲染行；<code>Height</code> 是滚动视口高度，<code>ItemSize</code> 是固定行高。</span>
        <span>选择语义与 <code>List</code> 一致：<code>Single</code> 用 <code>SelectedValue</code>（配合 <code>AllowClear</code> 可再次点击取消），<code>Multiple</code> 用 <code>SelectedValues</code>；<code>ItemKeySelector</code> 的稳定 key 决定行在追加数据后的身份。</span>
        <span>触底加载由宿主驱动：组件只在距底部 <code>LoadMoreThreshold</code> 像素时触发一次 <code>OnLoadMore</code>，请求与分页游标由宿主写回 <code>HasMoreItems</code> 与 <code>LoadingMore</code>。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] VirtualListRelated =
    [
        new("List", "/components/list"),
        new("MultiSelect", "/components/multi-select"),
        new("ComboBox", "/components/combobox"),
        new("Menu", "/components/menu")
    ];

    private const string BasicCode = """
        <VirtualList Items="Rows"
                     Height="280px"
                     ItemSize="32"
                     ItemKeySelector="row => row.Id"
                     SelectionMode="SelectionMode.Single"
                     @bind-SelectedValue="Selected">
            <ItemTemplate Context="row">
                <span>@row.Id</span>
                <span>@row.Label</span>
            </ItemTemplate>
        </VirtualList>
        """;

    private const string LoadMoreCode = """
        <VirtualList Items="Rows"
                     Height="280px"
                     ItemSize="32"
                     LoadMoreThreshold="96"
                     HasMoreItems="HasMoreItems"
                     LoadingMore="IsLoadingMore"
                     OnLoadMore="LoadMoreAsync" />
        """;

    private const string OptionsCode = """
        <VirtualList Items="Rows"
                     Height="200px"
                     ItemSize="32"
                     SelectionMode="SelectionMode.Multiple"
                     DisabledSelector="IsRowDisabled"
                     @bind-SelectedValues="Selected" />

        <VirtualList Items="EmptyRows" Height="120px" ItemSize="32">
            <EmptyContent>没有可显示的记录</EmptyContent>
        </VirtualList>
        """;

    private readonly System.Collections.Generic.List<VirtualRow> _rows = Enumerable.Range(1, 250)
        .Select(index => new VirtualRow(index, $"项目 {index:00000}"))
        .ToList();

    private readonly System.Collections.Generic.List<VirtualRow> _moreRows = Enumerable.Range(1, 250)
        .Select(index => new VirtualRow(index, $"项目 {index:00000}"))
        .ToList();

    private readonly IReadOnlyList<VirtualRow> _emptyRows = [];

    private object? _selected;
    private IReadOnlyList<object?> _multiSelected = [];
    private bool _hasMoreItems = true;
    private bool _loadingMore;
    private string _loadMoreNote = "滚到列表底部会追加 250 条。";
    private double _itemSize = 32;
    private string _listHeight = "280px";
    private SelectionMode _selectionMode = SelectionMode.Single;

    private static readonly string[] ListHeights = ["200px", "280px", "360px"];
    private static readonly SelectionMode[] SelectionModes = [SelectionMode.None, SelectionMode.Single];

    private sealed record VirtualRow(int Id, string Label);

    private static bool IsRowDisabled(VirtualRow row) => row.Id % 5 == 0;

    private async Task LoadMoreAsync()
    {
        if (_loadingMore || !_hasMoreItems) return;

        _loadingMore = true;
        _loadMoreNote = "正在加载更多项目…";
        await InvokeAsync(StateHasChanged);
        await Task.Delay(180);

        var start = _moreRows.Count + 1;
        _moreRows.AddRange(Enumerable.Range(start, 250)
            .Select(index => new VirtualRow(index, $"项目 {index:00000}")));
        _hasMoreItems = _moreRows.Count < 1_000;
        _loadingMore = false;
        _loadMoreNote = _hasMoreItems ? $"已加载 {_moreRows.Count} 条，还可继续。" : $"已加载全部 {_moreRows.Count} 条。";
        await InvokeAsync(StateHasChanged);
    }

    private Task HandleMultiChanged(IReadOnlyList<object?> values)
    {
        _multiSelected = values;
        return Task.CompletedTask;
    }
}
