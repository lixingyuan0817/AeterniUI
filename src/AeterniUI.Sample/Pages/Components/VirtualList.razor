@page "/components/virtual-list"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · VirtualList</PageTitle>

<ComponentPreview AnchorId="virtual-list"
                  Category="导航组件"
                  Title="VirtualList"
                  ComponentName="VirtualList&lt;TItem&gt;"
                  Description="只渲染视口附近的固定行高项目，适合大数据量内存集合。"
                  Parameters="@Parameters">
    <Preview>
        <div class="preview-list-wrap">
            <VirtualList Items="@_rows"
                         Height="280px"
                         ItemSize="32"
                         OverscanCount="6"
                         SelectionMode="SelectionMode.Single"
                         @bind-SelectedValue="_selected"
                         ItemKeySelector="row => row.Id"
                         AriaLabel="虚拟项目列表">
                <ItemTemplate Context="row">
                    <span>@row.Id</span>
                    <span class="preview-value">@row.Label</span>
                </ItemTemplate>
            </VirtualList>
            <span class="preview-feedback" role="status">当前值：@(_selected?.ToString() ?? "未选择")，共 @_rows.Count 条</span>
        </div>
    </Preview>
    <Notes>
        <span>示例包含 10,000 条数据，但 DOM 只保留视口附近的行。第一版使用固定 ItemSize，不包含远程数据源和可变高度项目。</span>
    </Notes>
</ComponentPreview>

@code {
    private readonly IReadOnlyList<VirtualRow> _rows = Enumerable.Range(1, 10_000)
        .Select(index => new VirtualRow(index, $"项目 {index:00000}"))
        .ToArray();

    private object? _selected;

    private static readonly ShowcaseParameter[] Parameters =
    [
        new("Items", "IReadOnlyList<TItem>", "固定内存数据源。"),
        new("ItemTemplate", "RenderFragment<TItem>?", "可见行模板。"),
        new("Height", "string", "滚动视口高度。", "320px"),
        new("ItemSize", "double", "固定行高，单位为 CSS px。", "32"),
        new("OverscanCount", "int", "视口外预渲染行数。", "5"),
        new("ItemKeySelector", "Func<TItem, object?>?", "稳定且唯一的项目 key。"),
        new("SelectionMode", "SelectionMode", "无选择、单选或多选。", "None")
    ];

    private sealed record VirtualRow(int Id, string Label);
}
