@page "/components/virtual-list"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · VirtualList</PageTitle>

<ComponentPreview AnchorId="virtual-list"
                  Category="导航组件"
                  Title="VirtualList"
                  ComponentName="VirtualList&lt;TItem&gt;"
                  Description="只渲染视口附近的固定行高项目，适合大数据量内存集合。">
    <Preview>
        <div class="preview-list-wrap">
            <VirtualList Items="@_rows"
                         Height="280px"
                         ItemSize="32"
                         OverscanCount="6"
                         HasMoreItems="@_hasMoreItems"
                         LoadingMore="@_loadingMore"
                         OnLoadMore="LoadMoreAsync"
                         SelectionMode="SelectionMode.Single"
                         @bind-SelectedValue="_selected"
                         ItemKeySelector="row => row.Id"
                         AriaLabel="虚拟项目列表">
                <ItemTemplate Context="row">
                    <span>@row.Id</span>
                    <span class="preview-value">@row.Label</span>
                </ItemTemplate>
            </VirtualList>
            <span class="preview-feedback" role="status">当前值：@(_selected?.ToString() ?? "未选择")，共 @_rows.Count 条</span>
        </div>
    </Preview>
    <Notes>
        <span>示例按触底分批追加数据，DOM 只保留视口附近的行。触底阈值由组件负责判断，数据请求与是否还有更多项目由宿主控制。</span>
    </Notes>
</ComponentPreview>

@code {
    private readonly System.Collections.Generic.List<VirtualRow> _rows = Enumerable.Range(1, 250)
        .Select(index => new VirtualRow(index, $"项目 {index:00000}"))
        .ToList();

    private object? _selected;
    private bool _hasMoreItems = true;
    private bool _loadingMore;

    private async Task LoadMoreAsync()
    {
        if (_loadingMore || !_hasMoreItems) return;

        _loadingMore = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(180);

        var start = _rows.Count + 1;
        _rows.AddRange(Enumerable.Range(start, 250)
            .Select(index => new VirtualRow(index, $"项目 {index:00000}")));
        _hasMoreItems = _rows.Count < 1_000;
        _loadingMore = false;
        await InvokeAsync(StateHasChanged);
    }

    private sealed record VirtualRow(int Id, string Label);
}
