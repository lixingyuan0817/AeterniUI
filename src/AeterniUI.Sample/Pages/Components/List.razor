@page "/components/list"
@layout ComponentsLayout
@inherits ShowcasePageBase
@using AeterniUI.Enums

<PageTitle>Aeterni UI · List + ListItem</PageTitle>

<ComponentPage AnchorId="list"
               Category="导航组件"
               Title="List + ListItem"
               ComponentName="List / ListItem"
               Description="可组合的选项列表：无选择、单选、多选、卡片外壳与长列表滚动。"
               Related="@ListRelated">
    <WhenToUse>
        <p>一组同质条目需要被查看或选中时使用：设置项、候选标签、提交记录。条目数量大且行高固定时换用 <code>VirtualList</code>；需要可折叠分组的层级导航用 <code>Menu</code>。</p>
        <p><code>SelectionMode</code> 决定语义：<code>None</code> 只展示内容，<code>Single</code> 与 <code>Multiple</code> 才渲染 <code>listbox</code> 与选项角色，并接管方向键。</p>
    </WhenToUse>
    <Demos>
        <DemoCard Id="list-basic"
                  Title="基础用法"
                  Description="@("ChildContent 声明选项，ListItem 给出值；单选配合 @bind-SelectedItem，AllowClear 允许再次点击清除。")"
                  Code="@BasicCode">
            <Preview>
                <div class="preview-list-wrap">
                    <List TItem="string"
                          SelectionMode="SelectionMode.Single"
                          AllowClear
                          @bind-SelectedItem="_basicSelected"
                          AriaLabel="列表单选预览">
                        <ListItem Value="@DesignValue">设计</ListItem>
                        <ListItem Value="@DevelopmentValue">开发</ListItem>
                        <ListItem Value="@ProductValue">产品</ListItem>
                        <ListItem Value="@OperationsValue" Disabled>运营（禁用）</ListItem>
                    </List>
                    <span class="preview-feedback" role="status">当前值：@(_basicSelected ?? "未选择")</span>
                </div>
            </Preview>
        </DemoCard>

        <DemoCard Id="list-items"
                  Title="泛型 Items 与卡片"
                  Description="Items 自动推断类型，模板只提供内容、外壳由组件负责；字符串无需模板，卡片模式没有 CardTemplate 时回退为文本。"
                  Code="@ItemsCode">
            <Preview>
                <div class="preview-list-wrap">
                    <List Items="@_names"
                          CardMode="@_cardMode"
                          Disabled="@_itemsDisabled"
                          SelectionMode="SelectionMode.Single"
                          @bind-SelectedItem="_itemSelected"
                          AriaLabel="字符串列表" />
                    <List Items="@_models" CardMode="@_cardMode">
                        <ItemTemplate><strong>@context.Name</strong> · @context.Description</ItemTemplate>
                        <CardTemplate Context="item">
                            <strong>@item.Name</strong>
                            <span class="preview-value">@item.Description</span>
                        </CardTemplate>
                    </List>
                    <span class="preview-feedback" role="status">当前值：@(_itemSelected ?? "未选择")</span>
                </div>
            </Preview>
            <Controls>
                <Checkbox Size="Size.Small" @bind-Value="_cardMode">CardMode</Checkbox>
                <Checkbox Size="Size.Small" @bind-Value="_itemsDisabled">Disabled</Checkbox>
                <Button Size="Size.Small" Variant="ButtonVariant.Outline" OnClick="ReplaceItems">替换 / 恢复 Items</Button>
            </Controls>
        </DemoCard>

        <DemoCard Id="list-selection"
                  Title="选择模式与长列表"
                  Description="SelectionMode 在无选择、单选与多选之间切换；MaxHeight 让列表自己拥有滚动条，方向键按画面顺序移动。隐藏「开发」不会清空已选值——选中值归宿主，组件不会因为某一行不渲染就改写它。"
                  Code="@SelectionCode">
            <Preview>
                <div class="preview-list-wrap">
                    @if (_selectionMode == SelectionMode.Multiple)
                    {
                        <List TItem="string"
                              SelectionMode="@_selectionMode"
                              CardMode="@_cardMode"
                              SelectedItems="@_selectedRows"
                              SelectedItemsChanged="HandleMultipleChanged"
                              MaxHeight="220px"
                              AriaLabel="列表多选预览">
                            @foreach (var row in Rows)
                            {
                                <ListItem @key="row" Value="@row" Visible="@(!_hideDevelopment || row != "开发")">@row</ListItem>
                            }
                        </List>
                    }
                    else
                    {
                        <List TItem="string"
                              SelectionMode="@_selectionMode"
                              CardMode="@_cardMode"
                              AllowClear="@_allowClear"
                              SelectedItem="@_selectedRow"
                              SelectedItemChanged="HandleSingleChanged"
                              MaxHeight="220px"
                              AriaLabel="列表单选预览">
                            @foreach (var row in Rows)
                            {
                                <ListItem @key="row" Value="@row" Visible="@(!_hideDevelopment || row != "开发")">@row</ListItem>
                            }
                        </List>
                    }
                    <span class="preview-feedback" role="status">@_selectionNote</span>
                </div>
            </Preview>
            <Controls>
                <div class="control-field">
                    <span>SelectionMode</span>
                    <ShowcaseSelect TValue="SelectionMode" Id="list-mode" AriaLabel="SelectionMode" Options="@(Enum.GetValues<SelectionMode>())" @bind-Value="_selectionMode" />
                </div>
                <Checkbox Size="Size.Small" @bind-Value="_cardMode">CardMode</Checkbox>
                @if (_selectionMode != SelectionMode.Multiple)
                {
                    <Checkbox Size="Size.Small" @bind-Value="_allowClear">AllowClear</Checkbox>
                }
                <Checkbox Size="Size.Small" @bind-Value="_hideDevelopment">隐藏「开发」</Checkbox>
                <Button Size="Size.Small" Variant="ButtonVariant.Outline" OnClick="ReverseRows">反转顺序</Button>
            </Controls>
        </DemoCard>
    </Demos>
    <Notes>
        <span>只有 <code>Single</code> / <code>Multiple</code> 才输出 <code>listbox</code> 与选项角色；<code>AllowClear</code> 只在单选下允许再次点击清除。</span>
        <span><code>CardMode</code> 只换外壳：普通行与卡片共用同一套选中底色、字重与悬停反馈。选择列表里不要再嵌可聚焦操作控件，否则行与内部控件的键盘语义会互相打架。</span>
        <span><code>Home</code>/<code>End</code> 按画面顺序移动，<code>Visible</code> 为 false 的选项不可选也不进入移动范围；允许清空时方向键只移动活动项，<code>Enter</code> 与空格才真正切换。<code>MaxHeight</code> 为空时列表按内容自适应，设置后由 List 自己拥有滚动条。</span>
        <span>选中归宿主：<code>Items</code> 变化（筛选、隐藏、换页）不会自动清除 <code>SelectedItem</code>/<code>SelectedItems</code>；被移出快照的已选值只是不再有对应行。确实删除数据时由宿主把该值从自己的选中状态里移除，组件不会代劳。</span>
        <span>类型化选中用 <code>SelectedItem</code>/<code>SelectedItems</code>（<code>@@bind-SelectedItem</code> / <code>@@bind-SelectedItems</code>）；旧的 <code>SelectedValue</code>/<code>SelectedValues</code> 仍可用但已标 <code>Obsolete</code>，只建议留给 <code>ListItem.Value</code> 无法转成 <code>TItem</code> 的声明式场景。<code>ListItem.Value</code> 仍是 <code>object?</code>，声明式列表请让值与 <code>TItem</code> 兼容（如 <code>TItem="string"</code> 时传字符串）：绑定类型化回调后，不可表示的值会直接抛错而不是悄悄变成默认值。</span>
    </Notes>
</ComponentPage>

@code {
    private static readonly ShowcaseRelatedLink[] ListRelated =
    [
        new("VirtualList", "/components/virtual-list"),
        new("Menu", "/components/menu"),
        new("ComboBox", "/components/combobox"),
        new("Segmented", "/components/segmented")
    ];

    private const string BasicCode = """
        <List TItem="string" SelectionMode="SelectionMode.Single" AllowClear @bind-SelectedItem="Selected">
            <ListItem Value="设计">设计</ListItem>
            <ListItem Value="开发">开发</ListItem>
            <ListItem Value="运营" Disabled>运营（禁用）</ListItem>
        </List>
        """;

    private const string ItemsCode = """
        <List Items="Names" SelectionMode="SelectionMode.Single" @bind-SelectedItem="Selected" />

        <List Items="Rows" CardMode>
            <ItemTemplate><strong>@context.Name</strong> · @context.Description</ItemTemplate>
            <CardTemplate Context="item">
                <strong>@item.Name</strong>
                <span>@item.Description</span>
            </CardTemplate>
        </List>
        """;

    private const string SelectionCode = """
        <List TItem="string"
              SelectionMode="SelectionMode.Single"
              CardMode
              AllowClear
              @bind-SelectedItem="Selected"
              MaxHeight="220px">
            <ListItem Value="设计">设计</ListItem>
            <ListItem Value="开发">开发</ListItem>
        </List>
        """;

    private const string DesignValue = "设计";
    private const string DevelopmentValue = "开发";
    private const string ProductValue = "产品";
    private const string OperationsValue = "运营";

    private string? _basicSelected = "开发";
    private string? _itemSelected = "开发";
    private string[] _names = ["设计", "开发", "产品"];
    private bool _cardMode;
    private bool _itemsDisabled;

    private readonly string[] _rows = ["设计", "开发", "产品", "运营", "测试", "发布", "回滚", "监控", "审计", "归档"];
    private SelectionMode _selectionMode = SelectionMode.Single;
    private bool _allowClear = true;
    private bool _hideDevelopment;
    private bool _reversed;
    private string? _selectedRow;
    private IReadOnlyList<string> _selectedRows = ["设计"];
    private string _selectionNote = "在列表里选择或清除，反馈会显示在这里。";

    private readonly DemoItem[] _models =
    [
        new("设计", "类型化模板与默认 context"),
        new("开发", "卡片模板使用 Context 别名")
    ];

    private sealed record DemoItem(string Name, string Description);

    private string[] Rows => _reversed ? [.. _rows.Reverse()] : _rows;

    private void ReplaceItems() => _names = _names.Length == 3 ? ["新项目", "开发"] : ["设计", "开发", "产品"];

    private void ReverseRows()
    {
        _reversed = !_reversed;
        _selectionNote = _reversed ? "列表按反转后的画面顺序渲染。" : "列表恢复原始顺序。";
    }

    private Task HandleSingleChanged(string? value)
    {
        _selectedRow = value;
        _selectionNote = value is null ? "单选已清除。" : $"单选值：{value}。";
        return Task.CompletedTask;
    }

    private Task HandleMultipleChanged(IReadOnlyList<string> values)
    {
        _selectedRows = values;
        _selectionNote = values.Count == 0 ? "多选为空。" : $"多选值：{string.Join("、", values)}。";
        return Task.CompletedTask;
    }
}
