    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += HandleThemeChanged;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _selectedComponent = string.IsNullOrWhiteSpace(ComponentId) ? "install" : ComponentId.ToLowerInvariant();
    }

    private static string ModeText(ThemeMode mode) => mode switch
    {
        ThemeMode.System => "跟随系统",
        ThemeMode.Light => "浅色",
        _ => "深色"
    };

    private static string FeedbackSeverityText(Severity severity) =>
        FeedbackSeverities.First(option => option.Severity == severity).Label;

    private void HandleThemeChanged(object? sender, EventArgs args) => _ = InvokeAsync(StateHasChanged);

    private void MarkInteraction(MouseEventArgs _)
    {
        _interactionNote = $"已触发 OnClick：{DateTime.Now:HH:mm:ss}。";
    }

    private void MarkCardInteraction()
    {
        _cardNote = $"卡片 OnClick 已触发：{DateTime.Now:HH:mm:ss}。";
    }

    private void HandleCheckboxChange(ChangeEventArgs _)
    {
        _checkboxNote = $"OnChange 已触发，当前值为 {_checkboxValue}。";
    }

    private void HandleSwitchChange(ChangeEventArgs _)
    {
        _switchNote = $"OnChange 已触发，当前值为 {_switchValue}。";
    }

    private void DismissTag()
    {
        _tagRemoved = true;
    }

    private void RestoreTag(MouseEventArgs _)
    {
        _tagRemoved = false;
    }

    private void TogglePopoverPreview(MouseEventArgs _)
    {
        _popoverOpen = !_popoverOpen;
        _popoverNote = _popoverOpen
            ? "浮层已打开：内容以 region 语义展示在触发元素下方，可再次点击触发按钮或「关闭浮层」收起。"
            : "浮层已关闭：内容通过 hidden 移除。";
    }

    private void ClosePopoverPreview(MouseEventArgs _)
    {
        _popoverOpen = false;
        _popoverNote = "浮层已关闭：内容通过 hidden 移除。";
    }

    private void PreviewPopoverAction(MouseEventArgs _)
    {
        _popoverNote = "「了解更多」按钮已触发示例动作，当前浮层保持打开。";
    }

    private Task HandleListSingleChanged(object? value)
    {
        _listSelectedValue = value;
        _listNote = value is null ? "单选已清除。" : $"单选值：{value}。";
        return Task.CompletedTask;
    }

    private Task HandleListMultipleChanged(IReadOnlyList<object?> values)
    {
        _listSelectedValues = values;
        _listNote = values.Count == 0 ? "多选为空。" : $"多选值：{string.Join("、", values)}。";
        return Task.CompletedTask;
    }

    private Task HandleRatingChanged(int value)
    {
        _ratingValue = value;
        return Task.CompletedTask;
    }

    private Task HandleCityChanged(string? value)
    {
        _cityValue = value;
        return Task.CompletedTask;
    }

    private async Task HandleThemeModeChanged(ThemeMode mode)
    {
        _feedbackNote = $"主题模式已切换为 {ModeText(mode)}。";
        await InvokeAsync(StateHasChanged);
    }

    private async Task ShowPreviewAlert(MouseEventArgs _)
    {
        await DialogService.AlertAsync(
            "这是一条来自组件展示库的 Alert。",
            _feedbackPosition,
            new AlertOptions { Title = "Alert 预览", Severity = _feedbackSeverity });
        _feedbackNote = "Alert 已关闭。";
    }

    private async Task ShowPreviewConfirm(MouseEventArgs _)
    {
        var confirmed = await DialogService.ConfirmAsync(
            "确认使用当前选项继续吗？",
            new ConfirmOptions { Title = "Confirm 预览", Severity = _feedbackSeverity });
        _feedbackNote = confirmed ? "Confirm 返回 true。" : "Confirm 返回 false。";
    }

    private void ShowPreviewToast(MouseEventArgs _)
    {
        DialogService.ShowToast(
            "这是一条来自组件展示库的 Toast。",
            _feedbackPosition,
            new ToastOptions { Title = "Toast 预览", Severity = _feedbackSeverity });
        _feedbackNote = $"Toast 已发送到 {_feedbackPosition}。";
    }

    public void Dispose()
    {
        ThemeService.ThemeChanged -= HandleThemeChanged;
    }

    private RenderFragment CheckIcon => @<Icon Definition="@FontAwesomeIcons.Solid.Check" />;

    private RenderFragment ArrowLeftIcon => @<Icon Definition="@FontAwesomeIcons.Solid.ArrowLeft" />;

    private RenderFragment ArrowRightIcon => @<Icon Definition="@FontAwesomeIcons.Solid.ArrowRight" />;


