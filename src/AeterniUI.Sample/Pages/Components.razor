                            </div>
                            <div class="control-field">
                                <span>ToastPosition</span>
                                <ShowcaseSelect TValue="ToastPosition" Id="feedback-position" AriaLabel="ToastPosition" Options="@(Enum.GetValues<ToastPosition>())" @bind-Value="_feedbackPosition" />
                            </div>
                        </Controls>
                        <Notes>
                            <span>Alert 和 Toast 使用 <code>Duration</code> 控制自动关闭；设置为 <code>TimeSpan.Zero</code> 时保持持久显示。</span>
                        </Notes>
                    </ComponentPreview>
                    break;
                }
            </div>
        </main>
    </div>

@code {
