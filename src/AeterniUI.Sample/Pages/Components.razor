                            <Checkbox Size="Size.Small" @bind-Value="_menuControlled">受控 OpenKeys</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_menuDisabledGroup">禁用第二个分组</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_menuHiddenItem">隐藏一个菜单项</Checkbox>
                        </Controls>
                        <Notes>
                            <span>Tab 按原生顺序移动，<code>↑</code>/<code>↓</code> 在可达节点间循环，<code>Home</code>/<code>End</code> 到首尾，<code>←</code>/<code>→</code> 折叠或展开当前分组（RTL 自动互换），禁用项不参与移动。</span>
                        </Notes>
                    </ComponentPreview>
                    break;

                case "rating":
                    <ComponentPreview AnchorId="rating"
                                      Category="表单组件"
