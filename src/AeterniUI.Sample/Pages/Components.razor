                case "menu":
                    <ComponentPreview AnchorId="menu"
                                      Category="导航组件"
                                      Title="Menu"
                                      ComponentName="Menu"
                                      Description="分组可折叠的菜单导航，支持链接项、图标与描述、手风琴、受控展开状态和完整键盘操作。"
                                      Parameters="@MenuParameters"
                                      Events="@MenuEvents"
                                      Contracts="@MenuContracts">
