@page "/components"
@page "/components/{ComponentId}"
@using AeterniUI.Enums
@using AeterniUI.Icons
@using AeterniUI.Models.Dialog
@using AeterniUI.Services.Impl
@inject ThemeService ThemeService
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@implements IDisposable

<PageTitle>Aeterni UI · 组件文档</PageTitle>

<div class="showcase-layout" id="showcase">
        <aside class="showcase-sidebar">
            <div class="showcase-nav">
                <Menu Items="MenuGroups" SelectedId="@_selectedComponent" Accordion AriaLabel="组件导航" />
            </div>
        </aside>

        <main class="showcase-main">
            <div class="showcase-preview-host" @key="_selectedComponent">
                @switch (_selectedComponent)
                {
                case "install":
                    <section class="showcase-install" aria-labelledby="install-title">
                        <p class="component-preview__eyebrow">开始使用</p>
                        <h1 id="install-title">安装 AeterniUI</h1>
                        <p class="showcase-install__lead">一套基于语义 Token 的 Blazor 组件库，覆盖 Server、WebAssembly 与 Tauri 桌面宿主。</p>
                        <div class="showcase-install__steps">
                            <section><span>01</span><h2><Icon Definition="@FontAwesomeIcons.Solid.Plug" Color="Color.Primary" /> 添加服务</h2><pre><code>builder.Services.AddAeterniUI();</code></pre></section>
                            <section><span>02</span><h2><Icon Definition="@FontAwesomeIcons.Solid.Link" Color="Color.Primary" /> 引入样式</h2><pre><code>&lt;link rel="stylesheet" href="_content/AeterniUI/css/aeterni_ui.css" /&gt;</code></pre></section>
                            <section><span>03</span><h2><Icon Definition="@FontAwesomeIcons.Solid.Gear" Color="Color.Primary" /> 注册 Provider</h2><pre><code>&lt;ThemeProvider /&gt;
&lt;DialogProvider /&gt;</code></pre></section>
                            <section>
                                <span>04</span>
                                <h2><Icon Definition="@FontAwesomeIcons.Solid.Paintbrush" Color="Color.Primary" /> 预渲染主题</h2>
                                <pre><code>&lt;script&gt;
  const m = localStorage.getItem('aeterni.theme.mode');
  const t = m === 'dark' || m === 'light'
    ? m
    : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
  document.documentElement.dataset.theme = t;
  document.documentElement.style.colorScheme = t;
&lt;/script&gt;</code></pre>
                            </section>
                        </div>
                        <p class="showcase-install__note">从左侧选择组件查看实时预览、参数、事件与接口说明。</p>
                    </section>
                    break;
                case "colors":
                    <section class="showcase-colors" aria-labelledby="colors-title">
                        <p class="component-preview__eyebrow">设计基础</p>
                        <h1 id="colors-title">色彩与语义</h1>
                        <p class="showcase-install__lead">每个色族提供三种形态：填充（<code>--aeterni-color-*-default</code>）、文字/描边（<code>--aeterni-color-*-text</code>）和柔和底（<code>--aeterni-color-*-soft</code>）。填充档只用于实心表面，不能当文字或图标使用。</p>

                        <div class="showcase-colors__matrix">
                            <div class="showcase-colors__head" aria-hidden="true">
                                <span>色族</span>
                                <span>实心（填充 + 字色）</span>
                                <span>描边（文字形态）</span>
                                <span>Tag（浅底深字）</span>
                                <span>Icon（文字形态）</span>
                                <span>Progress（文字形态 + 色相轨道）</span>
                            </div>
                            @foreach (var family in ColorFamilies)
                            {
                                <div class="showcase-colors__row">
                                    <span class="showcase-colors__name">@family.Label</span>
                                    <Button Color="family.Color">@family.Label</Button>
                                    <Button Variant="ButtonVariant.Outline" Color="family.Color">Outline</Button>
                                    <span class="showcase-colors__chips">
                                        <Tag Color="family.Color">Tag</Tag>
                                        <Tag Color="family.Color" Variant="TagVariant.Outline">Outline</Tag>
                                    </span>
                                    <span class="showcase-colors__icons">
                                        <Icon Definition="FontAwesomeIcons.Solid.CircleCheck" Color="family.Color" Size="Size.Large" />
                                    </span>
                                    <Progress Value="62" Color="family.Color" />
                                </div>
                            }
                        </div>

                        <h2 class="showcase-colors__subtitle">语意通知</h2>
                        <p class="showcase-install__note">Alert 和 Toast 的卡片底色、徽标底色与进度环取填充档，徽标内的图标取文字形态。</p>
                        <div class="preview-action-row">
                            @foreach (var family in SeverityFamilies)
                            {
                                <Button Variant="ButtonVariant.Ghost"
                                        Color="family.Color"
                                        OnClick="@(args => ShowColorAlertAsync(family))">
                                    @family.Label Alert
                                </Button>
                            }
                        </div>

                        <h2 class="showcase-colors__subtitle">中性容器表面</h2>
                        <p class="showcase-install__note">大面积容器表面一律无色（R = G = B）；带 +2 以上的彩偏移在侧边栏、卡片和磨砂面板上会被读成品牌色底，而且磨砂层的 <code>saturate()</code> 会再放大它。文字允许约 +4 的冷偏移，这是「冷中性」名称的来源。</p>
                        <div class="showcase-colors__surfaces">
                            <div class="showcase-colors__surface showcase-colors__surface--page">
                                <span>页面</span>
                                <code>--aeterni-bg</code>
                            </div>
                            <div class="showcase-colors__surface showcase-colors__surface--secondary">
                                <span>次级底</span>
                                <code>--aeterni-bg-secondary</code>
                            </div>
                            <div class="showcase-colors__surface showcase-colors__surface--tertiary">
                                <span>三级底 / 轨道</span>
                                <code>--aeterni-bg-tertiary</code>
                            </div>
                            <div class="showcase-colors__surface showcase-colors__surface--elevated">
                                <span>磨砂层</span>
                                <code>--aeterni-bg-elevated</code>
                            </div>
                            <div class="showcase-colors__surface showcase-colors__surface--soft">
                                <span>叠色次级底</span>
                                <code>--aeterni-surface-soft</code>
                            </div>
                            <div class="showcase-colors__surface showcase-colors__surface--hover">
                                <span>交互悬停（有意带色）</span>
                                <code>--aeterni-state-background-hover</code>
                            </div>
                        </div>

                        <h2 class="showcase-colors__subtitle">文字色阶</h2>
                        <p class="showcase-install__note">文字用一个墨色加不透明度（Apple 的 label 模型）：同一色相、随表面自动调和。正文到图标级依次变浅，各司其职；<code>tertiary</code> 只用于图标与装饰。</p>
                        <div class="showcase-colors__type">
                            <div class="showcase-colors__type-row">
                                <code>--aeterni-text-primary</code>
                                <span class="showcase-colors__type-primary">正文 / 标题 · 11.7:1</span>
                            </div>
                            <div class="showcase-colors__type-row">
                                <code>--aeterni-text-secondary</code>
                                <span class="showcase-colors__type-secondary">标签 / 导航 / 说明 · 6.2:1</span>
                            </div>
                            <div class="showcase-colors__type-row">
                                <code>--aeterni-text-placeholder</code>
                                <span class="showcase-colors__type-placeholder">输入占位符 · 4.9:1</span>
                            </div>
                            <div class="showcase-colors__type-row">
                                <code>--aeterni-text-tertiary</code>
                                <span class="showcase-colors__type-tertiary">仅图标与装饰 · 4.3:1</span>
                            </div>
                            <div class="showcase-colors__type-row">
                                <code>--aeterni-text-disabled</code>
                                <span class="showcase-colors__type-disabled">禁用态 · 2.5:1（WCAG 豁免）</span>
                            </div>
                        </div>

                        <h2 class="showcase-colors__subtitle">对比度基线（按 Token 数值计算）</h2>
                        <div class="showcase-colors__table">
                            <div class="showcase-colors__table-row showcase-colors__table-row--head">
                                <span>用法</span><span>浅色主题</span><span>深色主题</span><span>要求</span>
                            </div>
                            @foreach (var check in ContrastChecks)
                            {
                                <div class="showcase-colors__table-row">
                                    <span>@check.Usage</span>
                                    <span>@check.Light</span>
                                    <span>@check.Dark</span>
                                    <span>@check.Requirement</span>
                                </div>
                            }
                        </div>
                        <p class="showcase-install__note">
                            切换主题可以对照同一组组件在两种主题下的结果；具体数值来自 Token 十六进制值按 WCAG 2.1 相对亮度公式计算，验收时仍需实测确认。
                        </p>
                    </section>
                    break;
                case "button":
                    <ComponentPreview AnchorId="button"
                                      Category="基础组件"
                                      Title="Button"
                                      ComponentName="Button"
                                      Description="用于触发动作的原生按钮，统一承载变体、语义色、尺寸、图标、加载和禁用状态。"
                                      Parameters="@ButtonParameters"
                                      Events="@ButtonEvents">
                        <Preview>
                            <div class="preview-stack">
                                <Button Variant="@_buttonVariant"
                                        Color="@_buttonColor"
                                        Size="@_buttonSize"
                                        Type="@_buttonType"
                                        Loading="@_buttonLoading"
                                        Disabled="@_buttonDisabled"
                                        FullWidth="@_buttonFullWidth"
                                        StartIcon="@ButtonIcon"
                                        OnClick="MarkInteraction">
                                    @_buttonText
                                </Button>
                                <span class="preview-feedback" role="status">@_interactionNote</span>
                            </div>
                            <div class="preview-state-row" aria-label="Loading 状态在各变体下的对照">
                                <Button Variant="ButtonVariant.Default" Loading="true">Default</Button>
                                <Button Variant="ButtonVariant.Outline" Loading="true">Outline</Button>
                                <Button Variant="ButtonVariant.Ghost" Loading="true">Ghost</Button>
                                <Button Variant="ButtonVariant.Text" Loading="true">Text</Button>
                                <Button Variant="ButtonVariant.Link" Loading="true">Link</Button>
                            </div>
                            <div class="preview-state-row" aria-label="实心语义色对照">
                                <Button Color="Color.Primary">Primary</Button>
                                <Button Color="Color.Success">Success</Button>
                                <Button Color="Color.Warning">Warning</Button>
                                <Button Color="Color.Danger">Danger</Button>
                                <Button Color="Color.Info">Info</Button>
                            </div>
                        </Preview>
                        <Controls>
                            <div class="control-field">
                                <label for="button-text">按钮文本</label>
                                <input id="button-text" @bind="_buttonText" />
                            </div>
                            <div class="control-grid">
                                <div class="control-field">
                                    <span>Variant</span>
                                    <ShowcaseSelect TValue="ButtonVariant" Id="button-variant" AriaLabel="Variant" Options="@(Enum.GetValues<ButtonVariant>())" @bind-Value="_buttonVariant" />
                                </div>
                                <div class="control-field">
                                    <span>Color</span>
                                    <ShowcaseSelect TValue="Color" Id="button-color" AriaLabel="Color" Options="@(Enum.GetValues<Color>())" @bind-Value="_buttonColor" />
                                </div>
                                <div class="control-field">
                                    <span>Size</span>
                                    <ShowcaseSelect TValue="Size" Id="button-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_buttonSize" />
                                </div>
                                <div class="control-field">
                                    <span>Type</span>
                                    <ShowcaseSelect TValue="ButtonType" Id="button-type" AriaLabel="Type" Options="@(Enum.GetValues<ButtonType>())" @bind-Value="_buttonType" />
                                </div>
                            </div>
                            <Checkbox Size="Size.Small" @bind-Value="_buttonLoading">Loading</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_buttonDisabled">Disabled</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_buttonFullWidth">FullWidth</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_buttonHasIcon">显示起始图标</Checkbox>
                        </Controls>
                        <Notes>
                            <span>点击预览按钮会触发 <code>OnClick</code>，加载状态会同时输出 <code>aria-busy</code> 并阻止交互。</span>
                            <span>禁用状态会随 <code>Variant</code> 和 <code>Color</code> 保留层级与语意底色，不使用透明背景。</span>
                            <span>第一行为 <code>Loading</code> 对照：透明变体只叠加自身语意色的半透明遮罩，不会变成实心按钮。</span>
                            <span>第二行为实心语义色对照：前景使用 <code>--aeterni-color-on-semantic</code>，请在浅色与深色主题下各核对一次对比度。</span>
                        </Notes>
                    </ComponentPreview>
                    break;

                case "button-group":
                    <ComponentPreview AnchorId="button-group"
                                      Category="基础组件"
                                      Title="ButtonGroup"
                                      ComponentName="ButtonGroup"
                                      Description="将多个 Button 组合为水平或垂直的操作组，并通过级联上下文传递禁用状态。"
                                      Parameters="@ButtonGroupParameters">
                        <Preview>
            <ButtonGroup Orientation="@_buttonGroupOrientation"
                         Connected="@_buttonGroupConnected"
                         FullWidth="@_buttonGroupFullWidth"
                         Disabled="@_buttonGroupDisabled"
                         AriaLabel="按钮组预览">
                                <Button StartIcon="@ArrowLeftIcon" OnClick="MarkInteraction">上一页</Button>
                                <Button OnClick="MarkInteraction">当前页</Button>
                                <Button EndIcon="@ArrowRightIcon" OnClick="MarkInteraction">下一页</Button>
                            </ButtonGroup>
                        </Preview>
                        <Controls>
                            <div class="control-grid">
                                <div class="control-field">
                                    <span>Orientation</span>
                                    <ShowcaseSelect TValue="Orientation" Id="group-orientation" AriaLabel="Orientation" Options="@(Enum.GetValues<Orientation>())" @bind-Value="_buttonGroupOrientation" />
                                </div>
                                <div class="control-field">
                                    <span>Connected</span>
                                    <ShowcaseSelect TValue="bool" Id="group-connected" AriaLabel="Connected" Options="@BooleanOptions" @bind-Value="_buttonGroupConnected" />
                                </div>
                            </div>
                            <Checkbox Size="Size.Small" @bind-Value="_buttonGroupFullWidth">FullWidth</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_buttonGroupDisabled">禁用整个组</Checkbox>
                        </Controls>
                        <Notes>
                            <span>按钮组的 <code>Disabled</code> 会通过级联上下文作用到内部 Button。</span>
                        </Notes>
                    </ComponentPreview>
                    break;

                case "surface":
                    <ComponentPreview AnchorId="surface"
                                      Category="基础组件"
                                      Title="Surface"
                                      ComponentName="Surface"
                                      Description="不携带内容结构的视觉容器，用于统一处理背景、边框、阴影、圆角和内边距。"
                                      Parameters="@SurfaceParameters">
                        <Preview>
                            <Surface Variant="@_surfaceVariant"
                                     Elevation="@_surfaceElevation"
                                     Padding="@_surfacePadding"
                                     Radius="@_surfaceRadius"
                                     Bordered="@_surfaceBordered"
                                     FullWidth="@_surfaceFullWidth">
                                <div class="preview-surface-content">
                                    <span class="preview-label">Surface preview</span>
                                    <strong>统一的表面容器</strong>
                                    <span>调整右侧属性查看视觉变化。</span>
                                </div>
                            </Surface>
                        </Preview>
                        <Controls>
                            <div class="control-grid">
                                <div class="control-field">
                                    <span>Variant</span>
                                    <ShowcaseSelect TValue="SurfaceVariant" Id="surface-variant" AriaLabel="Variant" Options="@(Enum.GetValues<SurfaceVariant>())" @bind-Value="_surfaceVariant" />
                                </div>
                                <div class="control-field">
                                    <span>Elevation</span>
                                    <ShowcaseSelect TValue="SurfaceElevation" Id="surface-elevation" AriaLabel="Elevation" Options="@(Enum.GetValues<SurfaceElevation>())" @bind-Value="_surfaceElevation" />
                                </div>
                                <div class="control-field">
                                    <span>Padding</span>
                                    <ShowcaseSelect TValue="SurfacePadding" Id="surface-padding" AriaLabel="Padding" Options="@(Enum.GetValues<SurfacePadding>())" @bind-Value="_surfacePadding" />
                                </div>
                                <div class="control-field">
                                    <span>Radius</span>
                                    <ShowcaseSelect TValue="SurfaceRadius" Id="surface-radius" AriaLabel="Radius" Options="@(Enum.GetValues<SurfaceRadius>())" @bind-Value="_surfaceRadius" />
                                </div>
                            </div>
                            <Checkbox Size="Size.Small" @bind-Value="_surfaceBordered">Bordered</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_surfaceFullWidth">FullWidth</Checkbox>
                        </Controls>
                    </ComponentPreview>
                    break;

                case "card":
                    <ComponentPreview AnchorId="card"
                                      Category="基础组件"
                                      Title="Card"
                                      ComponentName="Card"
                                      Description="带有 Header、主体和 Footer 内容区域的结构化容器，也可以切换为整卡交互。"
                                      Parameters="@CardParameters"
                                      Events="@CardEvents">
                        <Preview>
                            <Card Variant="@_cardVariant"
                                  Elevation="@_cardElevation"
                                  Padding="@_cardPadding"
                                  Bordered="@_cardBordered"
                                  Interactive="@_cardInteractive"
                                  AriaLabel="预览卡片"
                                  OnClick="MarkCardInteraction">
                                <Header><span class="preview-label">Card / Header</span></Header>
                                <ChildContent>
                                    <h3 class="preview-card-title">一张可组合的卡片</h3>
                                    <p class="preview-card-copy">主体内容可以是任意 RenderFragment。</p>
                                </ChildContent>
                                <Footer><span class="preview-card-footer">Card / Footer</span></Footer>
                            </Card>
                        </Preview>
                        <Controls>
                            <div class="control-grid">
                                <div class="control-field">
                                    <span>Variant</span>
                                    <ShowcaseSelect TValue="SurfaceVariant" Id="card-variant" AriaLabel="Variant" Options="@(Enum.GetValues<SurfaceVariant>())" @bind-Value="_cardVariant" />
                                </div>
                                <div class="control-field">
                                    <span>Elevation</span>
                                    <ShowcaseSelect TValue="SurfaceElevation" Id="card-elevation" AriaLabel="Elevation" Options="@(Enum.GetValues<SurfaceElevation>())" @bind-Value="_cardElevation" />
                                </div>
                                <div class="control-field">
                                    <span>Padding</span>
                                    <ShowcaseSelect TValue="SurfacePadding" Id="card-padding" AriaLabel="Padding" Options="@(Enum.GetValues<SurfacePadding>())" @bind-Value="_cardPadding" />
                                </div>
                            </div>
                            <Checkbox Size="Size.Small" @bind-Value="_cardBordered">Bordered</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_cardInteractive">Interactive</Checkbox>
                            <span class="control-status" role="status">@_cardNote</span>
                        </Controls>
                    </ComponentPreview>
                    break;

                case "icon":
                    <ComponentPreview AnchorId="icon"
                                      Category="基础组件"
                                      Title="Icon"
                                      ComponentName="Icon"
                                      Description="渲染供应商无关的 SVG 图标定义，并通过语义颜色、尺寸和无障碍名称接入其他组件。"
                                      Parameters="@IconParameters">
                        <Preview>
                            <div class="preview-icon-wrap">
                                <Icon Definition="@FontAwesomeIcons.Solid.Sun"
                                      Size="@_iconSize"
                                      Color="@_iconColor"
                                      AriaLabel="@(_iconAccessible ? "装饰图标" : null)"
                                      Title="@(_iconTitle ? "Icon title" : null)" />
                            </div>
                        </Preview>
                        <Controls>
                            <div class="control-grid">
                                <div class="control-field">
                                    <span>Size</span>
                                    <ShowcaseSelect TValue="Size" Id="icon-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_iconSize" />
                                </div>
                                <div class="control-field">
                                    <span>Color</span>
                                    <ShowcaseSelect TValue="Color" Id="icon-color" AriaLabel="Color" Options="@(Enum.GetValues<Color>())" @bind-Value="_iconColor" />
                                </div>
                            </div>
                            <Checkbox Size="Size.Small" @bind-Value="_iconAccessible">提供 AriaLabel</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_iconTitle">提供 Title</Checkbox>
                        </Controls>
                        <Notes>
                            <span>没有 <code>AriaLabel</code> 时，Icon 会输出 <code>aria-hidden="true"</code>；核心库只接收 <code>IconDefinition</code>。</span>
                        </Notes>
                    </ComponentPreview>
                    break;

                case "input":
                    <ComponentPreview AnchorId="input"
                                      Category="表单组件"
                                      Title="Input"
                                      ComponentName="Input"
                                      Description="单行原生输入控件，支持标准绑定、HTML 输入语义、校验状态、事件和 FormField 级联。"
                                      Parameters="@InputParameters"
                                      Events="@InputEvents">
                        <Preview>
                            <div class="preview-form-control">
                                <Input @bind-Value="_inputValue"
                                       Type="@_inputType"
                                       Size="@_inputSize"
                                       Placeholder="@_inputPlaceholder"
                                       ReadOnly="@_inputReadOnly"
                                       Required="@_inputRequired"
                                       Invalid="@_inputInvalid"
                                       Disabled="@_inputDisabled"
                                       FullWidth="@_inputFullWidth"
                                       AriaLabel="预览输入框" />
                                <code class="preview-value">Value: @_inputValue</code>
                            </div>
                        </Preview>
                        <Controls>
                            <div class="control-field">
                                <label for="input-placeholder">Placeholder</label>
                                <input id="input-placeholder" @bind="_inputPlaceholder" />
                            </div>
                            <div class="control-grid">
                                <div class="control-field">
                                    <span>Type</span>
                                    <ShowcaseSelect TValue="InputType" Id="input-type" AriaLabel="Type" Options="@(Enum.GetValues<InputType>())" @bind-Value="_inputType" />
                                </div>
                                <div class="control-field">
                                    <span>Size</span>
                                    <ShowcaseSelect TValue="Size" Id="input-size" AriaLabel="Size" Options="@(Enum.GetValues<Size>())" @bind-Value="_inputSize" />
                                </div>
                            </div>
                            <Checkbox Size="Size.Small" @bind-Value="_inputReadOnly">ReadOnly</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_inputRequired">Required</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_inputInvalid">Invalid</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_inputDisabled">Disabled</Checkbox>
                            <Checkbox Size="Size.Small" @bind-Value="_inputFullWidth">FullWidth</Checkbox>
                        </Controls>
                    </ComponentPreview>
                    break;

                case "textarea":
                    <ComponentPreview AnchorId="textarea"
                                      Category="表单组件"
                                      Title="Textarea"
                                      ComponentName="Textarea"
                                      Description="多行原生文本控件，复用 Input 的绑定、校验、禁用、只读和无障碍语义。"
                                      Parameters="@TextareaParameters"
                                      Events="@TextareaEvents">
                        <Preview>
                            <div class="preview-form-control">
                                <Textarea @bind-Value="_textareaValue"
                                          Rows="@_textareaRows"
                                          Resize="@_textareaResize"
                                          Placeholder="@_textareaPlaceholder"
                                          ReadOnly="@_textareaReadOnly"
                                          Required="@_textareaRequired"
                                          Invalid="@_textareaInvalid"
                                          Disabled="@_textareaDisabled"
                                          FullWidth="@_textareaFullWidth"
                                          AriaLabel="预览文本域" />
                                <code class="preview-value">Value: @_textareaValue</code>
                            </div>
                        </Preview>
                        <Controls>
                            <div class="control-field">
                                <label for="textarea-placeholder">Placeholder</label>
                                <input id="textarea-placeholder" @bind="_textareaPlaceholder" />
                            </div>
                            <div class="control-grid">
                                <div class="control-field">
                                    <label for="textarea-rows">Rows</label>
