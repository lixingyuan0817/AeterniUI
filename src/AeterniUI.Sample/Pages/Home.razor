@page "/"

<PageTitle>Aeterni UI · Blazor 组件库</PageTitle>

<main class="doc-home">
    <div class="doc-home__bg" aria-hidden="true">
        <span class="doc-home__orb doc-home__orb--brand"></span>
        <span class="doc-home__orb doc-home__orb--info"></span>
        <span class="doc-home__orb doc-home__orb--success"></span>
    </div>
    <div class="doc-home__grid">
        <section class="doc-intro" aria-labelledby="doc-title">
            <p class="doc-intro__eyebrow">Aeterni UI · Blazor 组件库</p>
            <h1 id="doc-title" tabindex="-1">
                一致、可主题化的<br />
                <span class="doc-intro__accent">Blazor 组件库</span>
            </h1>
            <p class="doc-intro__lead">
                基于语义 Token 的 Blazor 组件库：覆盖 Server、WebAssembly 与 Tauri
                桌面宿主，浅色/深色主题与无障碍、键盘行为开箱即用。
            </p>

            <ul class="doc-features">
                <li>一套代码覆盖三类宿主，无需改写业务层</li>
                <li>System / Light / Dark 主题由语义 Token 统一驱动</li>
                <li>原生语义、焦点管理与表单校验状态开箱即用</li>
            </ul>

            <div class="doc-intro__cta">
                <a class="doc-cta" href="/components">
                    浏览组件
                    <span class="doc-cta__arrow" aria-hidden="true">→</span>
                </a>
                <span class="doc-intro__cta-hint">每个组件都附预览、参数、事件与接口说明</span>
            </div>
        </section>

        <section class="doc-code" aria-labelledby="doc-code-title">
            <h2 id="doc-code-title" class="doc-code__kicker">基础使用</h2>
            <div class="doc-code__window">
                <div class="doc-code__bar">
                    <span class="doc-code__dot" aria-hidden="true"></span>
                    <span class="doc-code__dot" aria-hidden="true"></span>
                    <span class="doc-code__dot" aria-hidden="true"></span>
                    <span class="doc-code__file">Program.cs · 布局 · 使用示例</span>
                </div>
                <pre class="doc-code__body"><code><span class="tok-c">// 1. 注册服务（Program.cs）</span>
builder.Services.<span class="tok-fn">AddAeterniUI</span>();

<span class="tok-c">// 2. 引入样式（wwwroot/index.html）</span>
&lt;link rel=<span class="tok-str">"stylesheet"</span>
      href=<span class="tok-str">"_content/AeterniUI/css/aeterni_ui.css"</span> /&gt;

<span class="tok-c">// 3. 根布局放置 Provider（MainLayout.razor）</span>
&lt;<span class="tok-tag">ThemeProvider</span> /&gt;
&lt;<span class="tok-tag">DialogProvider</span> /&gt;

<span class="tok-c">// 4. 使用组件</span>
&lt;<span class="tok-tag">Button</span> Color=<span class="tok-str">"Color.Primary"</span>
        OnClick=<span class="tok-str">"SaveChanges"</span>&gt;保存更改&lt;/<span class="tok-tag">Button</span>&gt;

&lt;<span class="tok-tag">Input</span> @@bind-Value=<span class="tok-str">"name"</span>
       Placeholder=<span class="tok-str">"请输入姓名"</span> /&gt;

&lt;<span class="tok-tag">ThemeSwitch</span> AriaLabel=<span class="tok-str">"主题模式"</span> /&gt;</code></pre>
            </div>
        </section>
    </div>
</main>
