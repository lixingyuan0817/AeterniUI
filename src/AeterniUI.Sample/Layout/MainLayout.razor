@inherits LayoutComponentBase
@using AeterniUI.Enums

<ThemeProvider />
<DialogProvider />

<div class="sample-page">
    <header class="sample-header">
        <Surface Variant="SurfaceVariant.Glass"
                 Padding="SurfacePadding.None"
                 Radius="SurfaceRadius.ExtraLarge">
            <div class="sample-header__bar">
                <a class="brand" href="/" aria-label="Aeterni UI 首页">
                    <span class="brand-mark" aria-hidden="true">A</span>
                    <span class="brand-name">Aeterni<span>UI</span></span>
                </a>

                <nav class="app-nav" aria-label="主导航">
                    <NavLink class="app-nav__link" href="/" Match="NavLinkMatch.All">
                        <Icon Definition="@FontAwesomeIcons.Solid.House" />
                        <span>首页</span>
                    </NavLink>
                    <NavLink class="app-nav__link" href="/components">
                        <Icon Definition="@FontAwesomeIcons.Solid.Cubes" />
                        <span>组件</span>
                    </NavLink>
                    <NavLink class="app-nav__link" href="/icons">
                        <Icon Definition="@FontAwesomeIcons.Solid.Star" />
                        <span>图标</span>
                    </NavLink>
                </nav>

                <ThemeSwitch Size="Size.Small" Class="header-theme-switch" AriaLabel="主题模式" />
            </div>
        </Surface>
    </header>

    @Body
</div>
