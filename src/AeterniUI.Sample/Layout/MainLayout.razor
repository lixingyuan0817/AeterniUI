@inherits LayoutComponentBase
@implements IDisposable
@using AeterniUI.Enums
@inject NavigationManager NavigationManager

<ThemeProvider />
<DialogProvider />

<div class="sample-page">
    @* 跳转链接：键盘用户第一次 Tab 就能越过固定页头直达正文。默认移出视口，
       只有获得焦点时才落回左上角（样式见 MainLayout.razor.css）。 *@
    <a class="sample-skip-link" href="#main-content">跳到主内容</a>

    @* 页面底只有中性暗角：彩色光斑会把整页底色染成有彩灰，和「容器与页面背景
       只能是无彩色或统一玻璃配方」的规则冲突，也让规格页里列出的中性表面无法复现。 *@
    <div class="sample-page__ambient" aria-hidden="true"></div>

    <header class="sample-header">
        @* 两个下拉的浮层不再挂在这张玻璃卡片里（见下面的页面级宿主）：卡片自己的
           `backdrop-filter` 会成为最近的 backdrop root，浮层自身的模糊就只采样卡片内部那张
           透明的背景，看起来完全没有模糊。浮层搬走之后，也用不着再为让开裁剪给 Surface 传
           `Style="overflow: visible"`。 *@
        <Surface Variant="SurfaceVariant.Glass"
                 Padding="SurfacePadding.None"
                 Radius="SurfaceRadius.ExtraLarge">
            <div class="sample-header__bar">
                <a class="brand" href="/" aria-label="Aeterni UI 首页">
                    <span class="brand-mark" aria-hidden="true">A</span>
                    <span class="brand-name">Aeterni<span>UI</span></span>
                </a>

                @* 版本入口：只读版本号，指向 GitHub 发布列表，给读者一个"我现在看的是哪一版、
                   去哪看变更"的确定去处。 *@
                <a class="app-version"
                   href="@ShowcaseCatalog.ReleasesUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="版本 @ShowcaseCatalog.Version，查看发布记录">v@(ShowcaseCatalog.Version)</a>

                <nav class="app-nav" aria-label="主导航">
                    <NavLink class="app-nav__link" href="/" Match="NavLinkMatch.All">
                        <Icon Definition="@FontAwesomeIcons.Solid.House" />
                        <span>首页</span>
                    </NavLink>
                    @* 「组件」按整段前缀高亮：文档页都挂在 /components/* 下，而入口指向总览页。
                        NavLink 的 Prefix 匹配只认 "/components/overview" 这一段，所以这里按
                       当前路径前缀自己算 active 与 aria-current。 *@
                    <a class="app-nav__link @(IsComponentsActive ? "active" : null)"
                       href="/components/overview"
                       aria-current="@(IsComponentsActive ? "page" : null)">
                        <Icon Definition="@FontAwesomeIcons.Solid.Cubes" />
                        <span>组件</span>
                    </a>
                    <NavLink class="app-nav__link" href="/icons">
                        <Icon Definition="@FontAwesomeIcons.Solid.Star" />
                        <span>图标</span>
                    </NavLink>
                </nav>

                @* 全局搜索在左、设置入口在右：搜索是页头里唯一会随输入变宽的控件，让它占住
                   剩余空间，两个图标类入口就不会被挤着走。 *@
                <div class="sample-header__actions">
                    <ShowcaseSearchBox />
                    <ShowcaseSettings />
                </div>
            </div>
        </Surface>
    </header>

    @* 页头两个下拉的浮层：它们的 PopupHost 留在这里——页头玻璃卡片之外、仍是页面里的元素，
       因此浮层的 `backdrop-filter` 采样整页而不是那张卡片。触发元素照旧在页头卡片里，浮层用
       `Popover.Anchor` 锚定到它们，渲染位置与锚点就此解耦；两个宿主都只承载固定定位的浮层，
       不贡献盒尺寸，页面布局与改动前一致。 *@
    <ShowcaseSearchLayer />
    <ShowcaseSettingsLayer />

    @* 内容区包一层：页脚用 margin-top:auto 落在视口底部，短页面（404）不会
       把页脚吊在半空；长页面上这层只是占满剩余高度，不改变内部布局。 *@
    <div class="sample-page__content" id="main-content" tabindex="-1">
        @Body
    </div>

    @* 站点页脚：三个页面（首页 / 组件 / 图标）共用同一个收束动作，给出仓库、发布与许可的
       确定去处；大屏页用自己的布局，不会被这张页脚带出站点导航。 *@
    <footer class="sample-footer">
        <p class="sample-footer__brand">AeterniUI <span>v@(ShowcaseCatalog.Version)</span></p>
        <nav class="sample-footer__links" aria-label="页脚导航">
            <a href="/components/overview">组件</a>
            <a href="/icons">图标</a>
            <a href="@ShowcaseCatalog.ReleasesUrl" target="_blank" rel="noopener noreferrer">发布记录</a>
            <a href="@ShowcaseCatalog.IssuesUrl" target="_blank" rel="noopener noreferrer">问题反馈</a>
            <a href="https://github.com/lixingyuan0817/AeterniUI" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
        <p class="sample-footer__note">MIT License · 面向 .NET 10 的 Blazor 组件库</p>
    </footer>
</div>

@code {
    /// <summary>
    /// 文档页都挂在 <c>/components</c> 下，页头「组件」入口指向总览页，但高亮要覆盖整段前缀。
    /// </summary>
    private bool IsComponentsActive
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            return path.StartsWith("components", StringComparison.OrdinalIgnoreCase);
        }
    }

    protected override void OnInitialized() => NavigationManager.LocationChanged += HandleLocationChanged;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => NavigationManager.LocationChanged -= HandleLocationChanged;
}
