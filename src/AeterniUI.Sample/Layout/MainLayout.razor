@inherits LayoutComponentBase
@implements IDisposable
@using AeterniUI.Enums

<ThemeProvider />
<DialogProvider />

<div class="@PageClass" dir="@(Preview.Rtl ? "rtl" : null)">
    <div class="sample-page__ambient" aria-hidden="true">
        <span class="sample-page__orb sample-page__orb--brand"></span>
        <span class="sample-page__orb sample-page__orb--info"></span>
        <span class="sample-page__orb sample-page__orb--success"></span>
    </div>

    <header class="sample-header">
        @* 两个下拉的浮层不再挂在这张玻璃卡片里（见下面的页面级宿主）：卡片自己的
           `backdrop-filter` 会成为最近的 backdrop root，浮层自身的模糊就只采样卡片内部那张
           透明的背景，看起来完全没有模糊。浮层搬走之后，也用不着再为让开裁剪给 Surface 传
           `Style="overflow: visible"`。 *@
        <Surface Variant="SurfaceVariant.Glass"
                 Padding="SurfacePadding.None"
                 Radius="SurfaceRadius.ExtraLarge">
            <div class="sample-header__bar">
                <a class="brand" href="/" aria-label="Aeterni UI 首页">
                    <span class="brand-mark" aria-hidden="true">A</span>
                    <span class="brand-name">Aeterni<span>UI</span></span>
                </a>

                @* 版本入口：只读版本号，指向 GitHub 发布列表，给读者一个"我现在看的是哪一版、
                   去哪看变更"的确定去处。 *@
                <a class="app-version"
                   href="@ShowcaseCatalog.ReleasesUrl"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="版本 @ShowcaseCatalog.Version，查看发布记录">v@(ShowcaseCatalog.Version)</a>

                <nav class="app-nav" aria-label="主导航">
                    <NavLink class="app-nav__link" href="/" Match="NavLinkMatch.All">
                        <Icon Definition="@FontAwesomeIcons.Solid.House" />
                        <span>首页</span>
                    </NavLink>
                    <NavLink class="app-nav__link" href="/components">
                        <Icon Definition="@FontAwesomeIcons.Solid.Cubes" />
                        <span>组件</span>
                    </NavLink>
                    <NavLink class="app-nav__link" href="/icons">
                        <Icon Definition="@FontAwesomeIcons.Solid.Star" />
                        <span>图标</span>
                    </NavLink>
                </nav>

                @* 全局搜索在左、设置入口在右：搜索是页头里唯一会随输入变宽的控件，让它占住
                   剩余空间，两个图标类入口就不会被挤着走。 *@
                <div class="sample-header__actions">
                    <ShowcaseSearchBox />
                    <ShowcaseSettings />
                </div>
            </div>
        </Surface>
    </header>

    @* 页头两个下拉的浮层：它们的 PopupHost 留在这里——页头玻璃卡片之外、仍是页面里的元素，
       因此浮层的 `backdrop-filter` 采样整页而不是那张卡片。触发元素照旧在页头卡片里，浮层用
       `Popover.Anchor` 锚定到它们，渲染位置与锚点就此解耦；两个宿主都只承载固定定位的浮层，
       不贡献盒尺寸，页面布局与改动前一致。 *@
    <ShowcaseSearchLayer />
    <ShowcaseSettingsLayer />

    @Body
</div>

@code {
    [Inject]
    private ShowcasePreviewModel Preview { get; set; } = default!;

    /// <summary>
    /// 外壳修饰类：窄屏与减少动效按开关叠加，RTL 单独走 <c>dir</c> 属性而不是类。
    /// 不输出无意义的默认修饰类。
    /// </summary>
    private string PageClass => (Preview.Narrow, Preview.ReducedMotion) switch
    {
        (true, true) => "sample-page is-narrow is-reduced-motion",
        (true, _) => "sample-page is-narrow",
        (_, true) => "sample-page is-reduced-motion",
        _ => "sample-page"
    };

    protected override void OnInitialized() => Preview.Changed += HandlePreviewChanged;

    private void HandlePreviewChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Preview.Changed -= HandlePreviewChanged;
}
