@namespace AeterniUI.Sample.Components.Showcase
@using AeterniUI.Enums

@* 居中搜索面板：渲染在页头玻璃卡片之外——面板自己的 `backdrop-filter` 才能采样整页而不是
   卡片内部那张透明背景。遮罩与面板是兄弟，点遮罩即关闭，面板自己不需要再挡事件。

   面板在打开时才进入 DOM：`role="dialog"` + `aria-modal` 表达模态语义，`tabindex="-1"` 给焦点
   陷阱一个兜底落点；滚动锁与 Tab 循环由库内 `aeterni_floating.js` 提供（见 `ShowcaseSearchModel`
   的互操作入口），这里只声明结构。 *@
@if (Model.Open)
{
    <div class="showcase-search-modal">
        <div class="showcase-search-modal__backdrop" @onclick="() => Model.ClosePanel()"></div>

        <section class="showcase-search-modal__panel"
                 @ref="_panel"
                 role="dialog"
                 aria-modal="true"
                 aria-label="搜索组件文档"
                 tabindex="-1"
                 @onkeydown="HandlePanelKeyDown">
            <div class="showcase-search-modal__field">
                <span class="showcase-search-modal__icon" aria-hidden="true">
                    <Icon Definition="@FontAwesomeIcons.Solid.MagnifyingGlass" />
                </span>
                @* 输入框是库内 Input：字段外观、禁用/无效状态与焦点环都归它，这里只补 combobox
                   的 ARIA 契约（与库内 Autocomplete 传给自己的 Input 的那一组一致）。 *@
                <Input Id="@ShowcaseSearchModel.InputId"
                       Size="Size.Small"
                       FullWidth="true"
                       Value="@Model.Query"
                       ValueChanged="HandleQueryChanged"
                       Placeholder="搜索组件或段落…"
                       AriaLabel="搜索组件或段落"
                       OnKeyDown="HandleInputKeyDown"
                       AdditionalAttributes="@InputAttributes" />
                <Button Variant="ButtonVariant.Ghost"
                        Intent="ButtonIntent.Neutral"
                        Size="Size.Small"
                        AriaLabel="关闭搜索"
                        OnClick="@(_ => Model.ClosePanel())"
                        StartIcon="@CloseIcon" />
            </div>

            @* 结果容器始终存在（面板打开期间）：`aria-controls` 指向的 id 不能随结果出现或消失；
               没有命中时用容器内的文案说明，而不是把列表整个拿掉。 *@
            <div id="@ShowcaseSearchModel.ListboxId" class="showcase-search-modal__list" role="listbox" aria-label="搜索结果">
                @if (Model.Matches.Count == 0)
                {
                    <p class="showcase-search-modal__empty">没有匹配的组件或段落。试试“选择”“日期”或“表单”。</p>
                }
                else
                {
                    @for (var index = 0; index < Model.Matches.Count; index++)
                    {
                        var match = Model.Matches[index];
                        <div id="@ShowcaseSearchModel.OptionId(index)"
                             role="option"
                             aria-selected="@(index == Model.ActiveIndex ? "true" : "false")"
                             class="@OptionClass(index)"
                             @onclick="() => Model.Pick(match)">
                            <span class="showcase-search-modal__option-title">@match.SectionTitle</span>
                            <span class="showcase-search-modal__option-meta">@ShowcaseSearchModel.MetaOf(match)</span>
                        </div>
                    }
                }
            </div>

            <p class="showcase-search-modal__hint">↑↓ 选择 · Enter 跳转 · Esc 关闭</p>
        </section>
    </div>
}

@code {
    private static readonly RenderFragment CloseIcon = @<Icon Definition="@FontAwesomeIcons.Solid.Xmark" />;
}
