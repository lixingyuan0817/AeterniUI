@namespace AeterniUI.Sample.Components.Showcase
@using AeterniUI.Enums

@* 居中搜索面板：渲染在页头玻璃卡片之外。面板自己是一个不透明的内容表面（与 Dialog/Drawer
   同一档 `--aeterni-bg-surface`），不叠玻璃、不写 `backdrop-filter`，因此不会出现「灰玻璃面板
   里套白输入框」的层级反转。遮罩与面板是兄弟，点遮罩即关闭，面板自己不需要再挡事件。

   面板在打开时才进入 DOM：`role="dialog"` + `aria-modal` 表达模态语义，`tabindex="-1"` 给焦点
   陷阱一个兜底落点；滚动锁与 Tab 循环由库内 `aeterni_floating.js` 提供（见 `ShowcaseSearchModel`
   的互操作入口），这里只声明结构。 *@
@if (Model.Open)
{
    <div class="showcase-search-modal">
        <div class="showcase-search-modal__backdrop" @onclick="() => Model.ClosePanel()"></div>

        <section class="showcase-search-modal__panel"
                 @ref="_panel"
                 role="dialog"
                 aria-modal="true"
                 aria-label="搜索组件文档"
                 tabindex="-1"
                 @onkeydown="HandlePanelKeyDown">
            <div class="showcase-search-modal__field">
                <span class="showcase-search-modal__icon" aria-hidden="true">
                    <Icon Definition="@FontAwesomeIcons.Solid.MagnifyingGlass" />
                </span>
                @* 输入框是库内 Input：字段外观、禁用/无效状态与焦点环都归它，这里只补 combobox
                   的 ARIA 契约（与库内 Autocomplete 传给自己的 Input 的那一组一致）。 *@
                <Input Id="@ShowcaseSearchModel.InputId"
                       Size="Size.Small"
                       FullWidth="true"
                       Value="@Model.Query"
                       ValueChanged="HandleQueryChanged"
                       Placeholder="搜索组件或段落…"
                       AriaLabel="搜索组件或段落"
                       OnKeyDown="HandleInputKeyDown"
                       AdditionalAttributes="@InputAttributes" />
                <Button Variant="ButtonVariant.Ghost"
                        Intent="ButtonIntent.Neutral"
                        Size="Size.Small"
                        AriaLabel="关闭搜索"
                        OnClick="@(_ => Model.ClosePanel())"
                        StartIcon="@CloseIcon" />
            </div>

            @* 命中数：结果区自己的读数。查询为空（引导态）时不显示，避免"0 条结果"被读成搜索失败。 *@
            @if (!string.IsNullOrWhiteSpace(Model.Query))
            {
                <p class="showcase-search-modal__summary" role="status">
                    @Model.MatchCount 条结果 · @Model.MatchGroups.Count 个页面
                </p>
            }

            @* 结果容器始终存在（面板打开期间）：`aria-controls` 指向的 id 不能随结果出现或消失。
               查询为空时给引导而不是"没有匹配"——初始态不是空结果，读者还没开始搜。 *@
            <div id="@ShowcaseSearchModel.ListboxId" class="showcase-search-modal__list" role="listbox" aria-label="搜索结果">
                @if (string.IsNullOrWhiteSpace(Model.Query))
                {
                    <p class="showcase-search-modal__prompt">输入组件名、分类或段落，例如「日期」「校验」「表单」。</p>
                }
                else if (Model.Matches.Count == 0)
                {
                    <p class="showcase-search-modal__empty">没有匹配的组件或段落。试试“选择”“日期”或“表单”。</p>
                }
                else
                {
                    var optionIndex = 0;

                    @* 同页结果聚成一组并插一行页面标题：泛化词（“组件”“时间”）的命中原本会
                       在多个页面间交错，读者分不清哪几条属于同一页。组内条目仍是 role=option，
                       页面标题行只做分组标签（role=group + aria-labelledby），不进入键盘序列。 *@
                    @foreach (var group in Model.MatchGroups)
                    {
                        var groupId = ShowcaseSearchModel.GroupId(group.PageId);
                        <div id="@groupId"
                             class="showcase-search-modal__group"
                             role="group"
                             aria-labelledby="@($"{groupId}-title")">
                            <p class="showcase-search-modal__group-title" id="@($"{groupId}-title")">
                                <span class="showcase-search-modal__group-page">@Highlight(group.PageTitle, Model.Query)</span>
                                <span class="showcase-search-modal__group-category">@group.Category</span>
                                <span class="showcase-search-modal__group-count">@group.Entries.Count 条</span>
                            </p>
                            @foreach (var match in group.Entries)
                            {
                                var index = optionIndex++;
                                <div id="@ShowcaseSearchModel.OptionId(index)"
                                     role="option"
                                     aria-selected="@(index == Model.ActiveIndex ? "true" : "false")"
                                     class="@OptionClass(index)"
                                     @onclick="() => Model.Pick(match)">
                                    <span class="showcase-search-modal__option-title">@Highlight(match.SectionTitle, Model.Query)</span>
                                    <span class="showcase-search-modal__option-meta">@Highlight(ShowcaseSearchModel.MetaOf(match), Model.Query)</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>

            <p class="showcase-search-modal__hint">↑↓ 选择 · Enter 跳转 · Esc 关闭</p>
        </section>
    </div>
}

@code {
    private static readonly RenderFragment CloseIcon = @<Icon Definition="@FontAwesomeIcons.Solid.Xmark" />;

    /// <summary>
    /// 命中词高亮。返回 <see cref="RenderFragment" /> 而不是拼接 HTML 字符串：文本经
    /// <c>AddContent</c> 编码，用户输入只会被当作要匹配的字面量，永远不会进入标记。
    /// </summary>
    private static RenderFragment Highlight(string? text, string? query)
    {
        var value = text ?? string.Empty;
        var needle = query?.Trim() ?? string.Empty;

        return builder =>
        {
            if (needle.Length == 0 || value.Length == 0)
            {
                builder.AddContent(0, value);
                return;
            }

            var position = 0;
            var sequence = 0;

            while (position < value.Length)
            {
                var index = value.IndexOf(needle, position, StringComparison.OrdinalIgnoreCase);
                if (index < 0)
                {
                    builder.AddContent(sequence++, value[position..]);
                    break;
                }

                if (index > position)
                {
                    builder.AddContent(sequence++, value[position..index]);
                }

                builder.OpenElement(sequence++, "mark");
                builder.AddAttribute(sequence++, "class", "showcase-search-modal__mark");
                builder.AddContent(sequence++, value.Substring(index, needle.Length));
                builder.CloseElement();

                position = index + needle.Length;
            }
        };
    }
}
