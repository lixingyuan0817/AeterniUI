@namespace AeterniUI.Sample.Components.Showcase

@* 组件页骨架。按市面组件文档的页面模板组织：标题区 → 何时使用 → 多段演示 → API →
   相关组件 → 说明与边界。段号不再硬编码：卡片化的页面里"第几段"靠右栏 TOC 与锚点表达，
   给 demo 编号只会和卡片标题打架。 *@
@* 页骨架外面套一层两列栅格：正文 + 右栏目录。目录只列本页真实存在的段，数据来自
   DemoCard 的登记（ShowcaseSectionRegistry）与骨架自己知道的固定段，因此不会出现死链。 *@
<div class="component-page">
    <CascadingValue Value="_sections" IsFixed="true">
<article class="component-preview" id="@AnchorId">
    @* 页头在容器内部：名称、"在 GitHub 编辑"与类型名都随卡片一起排版，卡片左右边界因此与
       侧栏对齐；放在布局层会让卡片比侧栏内缩一截。 *@
    <header class="component-preview__header">
        <div>
            <p class="component-preview__eyebrow">@Category</p>
            @* tabindex="-1"：标题是跳转链接的落点，也给了浏览器测试一个确定的 Tab 起点。
               它本身不进入 Tab 序，因此不改变键盘用户的路径。 *@
            <h1 tabindex="-1">@Title</h1>
            <p class="component-preview__description">@Description</p>
        </div>
        @* 页头右侧只留"在 GitHub 编辑"：类型名徽标在标题区已有同样的信息，两个并排反而让步
           头右侧显得空。 *@
        <div class="component-preview__meta">
            <ShowcaseEditLink AnchorId="@AnchorId" />
        </div>
    </header>

    @if (WhenToUse is not null)
    {
        <section class="component-page__when" aria-labelledby="@($"{AnchorId}-when-title")">
            <h2 id="@($"{AnchorId}-when-title")">何时使用</h2>
            @WhenToUse
        </section>
    }

    <div class="component-page__demos">@Demos</div>

    @if (HasApi)
    {
        <section class="component-preview__api" aria-labelledby="@($"{AnchorId}-api-title")">
            <div class="component-preview__section-heading">
                <div>
                    <span class="component-preview__section-kicker">API</span>
                    <h3 id="@($"{AnchorId}-api-title")">参数、事件与接口</h3>
                </div>
                <span class="component-preview__hint">公共 API</span>
            </div>
            <ShowcaseApiTable AnchorId="@AnchorId" />
        </section>
    }

    @if (Related is { Count: > 0 })
    {
        <section class="component-page__related" aria-labelledby="@($"{AnchorId}-related-title")">
            <h2 id="@($"{AnchorId}-related-title")">相关组件</h2>
            <ul>
                @foreach (var link in Related)
                {
                    <li><a href="@link.Href">@link.Label</a></li>
                }
            </ul>
        </section>
    }

    @if (Notes is not null)
    {
        <section class="component-page__section" aria-labelledby="@($"{AnchorId}-notes-title")">
            <h2 id="@($"{AnchorId}-notes-title")">说明与边界</h2>
            <div class="component-preview__notes">
                <span class="component-preview__notes-mark" aria-hidden="true">i</span>
                <div>@Notes</div>
            </div>
        </section>
    }

    @* 反馈闭环放在正文最末：不是文档段，不进入 TOC/搜索索引，只是每个页面的固定出口。 *@
    <ShowcaseFeedback AnchorId="@AnchorId" Title="@Title" />
</article>
    </CascadingValue>

    @if (TocEntries.Count > 0)
    {
        <aside class="component-page__toc" aria-label="本页目录">
            <p class="component-page__toc-title">本页目录</p>
            <ul>
                @foreach (var entry in TocEntries)
                {
                    <li>
                        <a class="component-page__toc-link" href="@SectionHref(entry.Id)">@entry.Title</a>
                    </li>
                }
            </ul>
        </aside>
    }
</div>

@code {
    // 目录链接必须是"当前页 + 片段"的完整地址：只写 `#upload-basic` 时浏览器按文档基准
    // （index.html 里的 `<base href="/" />`）解析成 `/#upload-basic`，Blazor 的路由于是认为
    // 目标不是本页，单击目录就跳到首页路由了。
    // NavigationManager 没有现成的"带片段地址"API（.NET 10 只有 GetUriWithQueryParameter(s)），
    // 所以按当前地址拼：去掉已有片段再接新片段，站点挂在子路径下（Pages 部署）时同样成立。
    [Inject]
    private NavigationManager NavigationManager { get; set; } = default!;

    private string SectionHref(string sectionId)
    {
        var current = NavigationManager.Uri;
        var hash = current.IndexOf('#');
        return hash >= 0 ? $"{current[..hash]}#{sectionId}" : $"{current}#{sectionId}";
    }

    /// <summary>Page id: sidebar key, API table key and the page anchor.</summary>
    [Parameter, EditorRequired]
    public string AnchorId { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Category { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string ComponentName { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>The demo cards, in reading order.</summary>
    [Parameter, EditorRequired]
    public RenderFragment Demos { get; set; } = default!;

    /// <summary>
    /// When to reach for this component, and when to reach for a different one. Market docs
    /// put this before the first demo because "which component do I want" is the reader's
    /// first question.
    /// </summary>
    [Parameter]
    public RenderFragment? WhenToUse { get; set; }

    [Parameter]
    public RenderFragment? Notes { get; set; }

    [Parameter]
    public IReadOnlyList<ShowcaseRelatedLink>? Related { get; set; }

    private readonly ShowcaseSectionRegistry _sections = new();

    protected override void OnInitialized() => _sections.OnChanged(RequestStateHasChanged);

    private void RequestStateHasChanged() => _ = InvokeAsync(StateHasChanged);

    /// <summary>
    /// 目录条目：固定段（何时使用、API、相关组件、说明与边界）+ 登记的 demo 段，按页面里的
    /// 实际顺序排列。没有内容的段不会出现。
    /// </summary>
    private IReadOnlyList<ShowcaseSection> TocEntries
    {
        get
        {
            var entries = new System.Collections.Generic.List<ShowcaseSection>();
            if (WhenToUse is not null)
            {
                entries.Add(new ShowcaseSection($"{AnchorId}-when-title", "何时使用"));
            }

            entries.AddRange(_sections.Sections);

            if (HasApi)
            {
                entries.Add(new ShowcaseSection($"{AnchorId}-api-title", "参数与事件"));
            }

            if (Related is { Count: > 0 })
            {
                entries.Add(new ShowcaseSection($"{AnchorId}-related-title", "相关组件"));
            }

            if (Notes is not null)
            {
                entries.Add(new ShowcaseSection($"{AnchorId}-notes-title", "说明与边界"));
            }

            return entries;
        }
    }

    private bool HasApi =>
        ShowcaseApiReference.ByPage.ContainsKey(AnchorId)
        || ShowcaseApiReference.Contracts.ContainsKey(AnchorId);
}
