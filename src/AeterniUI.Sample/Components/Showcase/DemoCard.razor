@namespace AeterniUI.Sample.Components.Showcase
@implements IDisposable
@using Microsoft.AspNetCore.Components.Web

@* 一段演示：标题、说明、实时预览、可选属性控件、可复制代码。市面组件文档的 demo 卡片
   就是这个形状。id 是这段演示的锚点——右栏 TOC 与分享链接都指向它。 *@
<section class="component-demo" id="@Id" aria-labelledby="@($"{Id}-title")">
    <header class="component-demo__header">
        <h3 id="@($"{Id}-title")">@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="component-demo__description">@Description</p>
        }
    </header>

    @* 预览与代码用 tab 切换，代码默认折叠：读者先看效果，需要时再看写法。折叠态是真正的
       不渲染（panel 带 hidden），不是用样式藏起来——否则读屏与搜索仍会读到隐藏内容。 *@
    <div class="component-demo__toolbar" role="tablist" aria-label="@($"{Title}视图")">
        <button type="button"
                role="tab"
                id="@($"{Id}-preview-tab")"
                aria-controls="@($"{Id}-preview")"
                aria-selected="@(_showCode ? "false" : "true")"
                tabindex="@(_showCode ? "-1" : "0")"
                class="@TabClass(!_showCode)"
                @onclick="() => Select(false)"
                @onkeydown="HandleTabKeyDown">预览</button>
        @if (!string.IsNullOrWhiteSpace(Code))
        {
            <button type="button"
                    role="tab"
                    id="@($"{Id}-code-tab")"
                    aria-controls="@($"{Id}-code")"
                    aria-selected="@(_showCode ? "true" : "false")"
                    tabindex="@(_showCode ? "0" : "-1")"
                    class="@TabClass(_showCode)"
                    @onclick="() => Select(true)"
                    @onkeydown="HandleTabKeyDown">代码</button>
        }
    </div>

    <div role="tabpanel"
         id="@($"{Id}-preview")"
         aria-labelledby="@($"{Id}-preview-tab")"
         hidden="@(_showCode ? true : null)">
        <div class="component-preview__canvas">@Preview</div>
        @if (Controls is not null)
        {
            <div class="component-demo__controls">@Controls</div>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(Code))
    {
        <div role="tabpanel"
             id="@($"{Id}-code")"
             aria-labelledby="@($"{Id}-code-tab")"
             hidden="@(_showCode ? null : true)">
            <ShowcaseCode Id="@($"{Id}-code-block")" Code="@Code" Label="@Title" />
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private ShowcaseSectionRegistry? Sections { get; set; }

    /// <summary>Anchor for this demo; also the prefix of its code block id.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment Preview { get; set; } = default!;

    /// <summary>Optional attribute controls. A demo that only shows one state needs none.</summary>
    [Parameter]
    public RenderFragment? Controls { get; set; }

    /// <summary>The snippet a consumer copies; the shape, not a transcript of the demo.</summary>
    [Parameter]
    public string? Code { get; set; }

    private bool _showCode;

    // 段在首次渲染前登记，目录因此与卡片同时出现；卡片被移除时注销，目录不会留下死链。
    protected override void OnInitialized() => Sections?.Register(new ShowcaseSection(Id, Title));

    public void Dispose() => Sections?.Unregister(Id);

    private string TabClass(bool active) => active ? "component-demo__tab is-active" : "component-demo__tab";

    private void Select(bool showCode) => _showCode = showCode;

    /// <summary>
    /// 两个 tab 之间用方向键切换（Home/End 也走同一套），焦点跟着选中项走——这是 tab 模式
    /// 的键盘约定：一组 tab 只有一个 Tab 停留点。
    /// </summary>
    private void HandleTabKeyDown(KeyboardEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(Code))
        {
            return;
        }

        switch (args.Key)
        {
            case "ArrowRight":
            case "ArrowLeft":
            case "Home":
            case "End":
                _showCode = !_showCode;
                break;
        }
    }
}
