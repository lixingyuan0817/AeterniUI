@namespace AeterniUI.Sample.Components.Showcase
@implements IDisposable
@using AeterniUI.Enums

@* 一段演示：标题、说明、实时预览、可选属性控件、可复制代码。市面组件文档的 demo 卡片
   就是这个形状。id 是这段演示的锚点——右栏 TOC 与分享链接都指向它。 *@
<section class="component-demo" id="@Id" aria-labelledby="@($"{Id}-title")">
    <header class="component-demo__header">
        <h3 id="@($"{Id}-title")">@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="component-demo__description">@Description</p>
        }
    </header>

    @* 预览与代码用库内 Segmented 切换，代码默认折叠：读者先看效果，需要时再看写法。
       折叠态是真正的不渲染（面板带 hidden），不是用样式藏起来——否则读屏与搜索仍会
       读到隐藏内容。分段控件是原生 radio，单选语义、方向键与"整组一个 Tab 停留点"
       都由浏览器提供，示例因此不再自己维护一套 tab 键盘模型。 *@
    @if (HasCode)
    {
        <div class="component-demo__toolbar">
            <Segmented TValue="bool"
                       Id="@($"{Id}-view")"
                       Items="@ViewItems"
                       Value="@_showCode"
                       ValueChanged="ShowCodeChanged"
                       TextSelector="@ViewText"
                       Size="Size.Small"
                       AriaLabel="@($"{Title}视图")" />
        </div>
    }

    <div class="component-demo__panel component-demo__panel--preview"
         id="@($"{Id}-preview")"
         hidden="@(_showCode ? true : null)">
        <div class="component-preview__canvas">@Preview</div>
        @if (Controls is not null)
        {
            @* 可调参数是「演示的一部分」，不是调试面板：给一行标题与一条分隔线，
               读者才知道这些字段可以动，而不是组件默认样式。 *@
            <div class="component-demo__controls">
                <p class="component-demo__controls-label">可调参数</p>
                @Controls
            </div>
        }
    </div>

    @if (HasCode)
    {
        <div class="component-demo__panel component-demo__panel--code"
             id="@($"{Id}-code")"
             hidden="@(_showCode ? null : true)">
            <ShowcaseCode Id="@($"{Id}-code-block")" Code="@Code" Label="@Title" />
        </div>
    }
</section>

@code {
    [CascadingParameter]
    private ShowcaseSectionRegistry? Sections { get; set; }

    /// <summary>Anchor for this demo; also the prefix of its code block id.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment Preview { get; set; } = default!;

    /// <summary>Optional attribute controls. A demo that only shows one state needs none.</summary>
    [Parameter]
    public RenderFragment? Controls { get; set; }

    /// <summary>The snippet a consumer copies; the shape, not a transcript of the demo.</summary>
    [Parameter]
    public string? Code { get; set; }

    private bool _showCode;

    /// <summary>Options of the preview/code switch. <c>false</c> is the preview.</summary>
    private static readonly bool[] ViewItems = [false, true];

    /// <summary>
    /// Whether this card has a snippet at all. A card without one gets the preview alone:
    /// a one-option segmented control would be a switch that cannot switch.
    /// </summary>
    private bool HasCode => !string.IsNullOrWhiteSpace(Code);

    // 段在首次渲染前登记，目录因此与卡片同时出现；卡片被移除时注销，目录不会留下死链。
    protected override void OnInitialized() => Sections?.Register(new ShowcaseSection(Id, Title));

    public void Dispose() => Sections?.Unregister(Id);

    private string ViewText(bool showCode) => showCode ? "代码" : "预览";

    private void ShowCodeChanged(bool showCode) => _showCode = showCode;
}
