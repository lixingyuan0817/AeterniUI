@namespace AeterniUI.Sample.Components.Showcase

@* 一段演示：标题、说明、实时预览、可选属性控件、可复制代码。市面组件文档的 demo 卡片
   就是这个形状。id 是这段演示的锚点——右栏 TOC 与分享链接都指向它。 *@
<section class="component-demo" id="@Id" aria-labelledby="@($"{Id}-title")">
    <header class="component-demo__header">
        <h3 id="@($"{Id}-title")">@Title</h3>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="component-demo__description">@Description</p>
        }
    </header>

    @* 预览与代码用库内的 Tabs + Tab 切换，代码默认折叠：示例里出现的交互，应当是库自己
       提供的那一套（AGENTS §4.7）。面板的 tab 语义、roving tabindex、方向键与 Home/End
       的自动激活、aria-controls/labelledby 的成对 id 都由组件给出，这里不再自己实现一份。
       未选中的面板由组件输出 hidden（隐藏渲染，而不是不渲染）：这是 Tabs 的既定行为，
       代码片段因此常驻在 DOM 里。 *@
    <Tabs Value="@_view" ValueChanged="HandleViewChanged" AriaLabel="@($"{Title}视图")">
        <Tab Value="preview" Header="@PreviewHeader">
            <div class="component-preview__canvas">@Preview</div>
            @if (Controls is not null)
            {
                <div class="component-demo__controls">@Controls</div>
            }
        </Tab>
        @if (!string.IsNullOrWhiteSpace(Code))
        {
            <Tab Value="code" Header="@CodeHeader">
                <ShowcaseCode Id="@($"{Id}-code-block")" Code="@Code" Label="@Title" />
            </Tab>
        }
    </Tabs>
</section>

@code {
    /// <summary>Anchor for this demo; also the prefix of its code block id.</summary>
    [Parameter, EditorRequired]
    public string Id { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment Preview { get; set; } = default!;

    /// <summary>Optional attribute controls. A demo that only shows one state needs none.</summary>
    [Parameter]
    public RenderFragment? Controls { get; set; }

    /// <summary>The snippet a consumer copies; the shape, not a transcript of the demo.</summary>
    [Parameter]
    public string? Code { get; set; }

    private const string PreviewView = "preview";

    private string _view = PreviewView;

    // Header 是 RenderFragment：Tab 的标签内容由调用方给，文字直接写成片段。
    private RenderFragment PreviewHeader => @<text>预览</text>;

    private RenderFragment CodeHeader => @<text>代码</text>;

    private void HandleViewChanged(string? value) =>
        _view = string.IsNullOrWhiteSpace(value) ? PreviewView : value;
}
