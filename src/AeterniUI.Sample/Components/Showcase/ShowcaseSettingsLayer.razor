@namespace AeterniUI.Sample.Components.Showcase
@using AeterniUI.Enums

@* 外观设置浮层：渲染在页头玻璃卡片之外，按页头的齿轮按钮定位（见 `ShowcaseSettings`）。
   可见标签与控件的 aria-label 说同一件事：分段控件本身不渲染文字标签，页头里没有它俩的
   上下文，读者得看得出来哪个是品牌色、哪个是主题。关闭后焦点归还触发器。 *@
<PopupHost>
    <ChildContent>
        <Popover Open="@Model.Open"
                 OpenChanged="Model.SetOpen"
                 Anchor="@Model.Anchor"
                 Placement="PopupPlacement.BottomEnd"
                 AriaLabel="外观设置"
                 RestoreFocusOnClose="true"
                 Class="showcase-settings__popover">
            <div id="showcase-settings-panel" class="showcase-settings">
                <div class="showcase-settings__group">
                    <p class="showcase-settings__label">品牌色</p>
                    <ThemeBrandSwitch Size="Size.Small" AriaLabel="品牌色" />
                </div>
                <div class="showcase-settings__group">
                    <p class="showcase-settings__label">主题模式</p>
                    <ThemeSwitch Size="Size.Small" AriaLabel="主题模式" />
                </div>
                @* 预览状态：RTL 方向、减少动效、窄屏三个示例级开关，作用在整站外壳上，
                   由 ShowcasePreviewModel 驱动；开关值由模型给出、变更写回模型，布局据此重渲染。 *@
                <div class="showcase-settings__group">
                    <p class="showcase-settings__label">预览状态</p>
                    <div class="showcase-settings__toggles">
                        <Switch Size="Size.Small"
                                Value="Preview.Rtl"
                                ValueChanged="Preview.SetRtl"
                                AriaLabel="方向 RTL">方向 RTL</Switch>
                        <Switch Size="Size.Small"
                                Value="Preview.ReducedMotion"
                                ValueChanged="Preview.SetReducedMotion"
                                AriaLabel="减少动效">减少动效</Switch>
                        <Switch Size="Size.Small"
                                Value="Preview.Narrow"
                                ValueChanged="Preview.SetNarrow"
                                AriaLabel="窄屏">窄屏</Switch>
                    </div>
                </div>
            </div>
        </Popover>
    </ChildContent>
</PopupHost>
