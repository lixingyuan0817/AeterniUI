@namespace AeterniUI.Sample.Components.Showcase
@using AeterniUI.Enums
@implements IDisposable

@* 头部设置入口的触发器：品牌色与主题模式收进浮层，页头不再并排挂两个分段控件。
   触发器是库内 Button（带 aria-haspopup / aria-expanded），浮层由 `ShowcaseSettingsLayer`
   渲染在页头玻璃卡片之外——玻璃卡片的 `backdrop-filter` 会成为最近的 backdrop root，
   浮层自己的模糊就只采样卡片内部那张透明的背景。两半共享 `ShowcaseSettingsModel`。

   这一层包裹元素是浮层的锚点：浮层渲染在别处却按这里定位，"点击外部"也把这里算作层内。 *@
<div class="sample-header__settings" @ref="_anchor">
    <Button Id="showcase-settings-button"
            Variant="ButtonVariant.Ghost"
            Size="Size.Small"
            AriaLabel="外观设置"
            aria-haspopup="true"
            aria-expanded="@(Model.Open ? "true" : "false")"
            OnClick="Model.Toggle"
            StartIcon="@GearIcon" />
</div>

@code {
    [Inject]
    private ShowcaseSettingsModel Model { get; set; } = default!;

    private static readonly RenderFragment GearIcon = @<Icon Definition="@FontAwesomeIcons.Solid.Gear" />;

    private ElementReference _anchor;

    protected override void OnInitialized() => Model.Changed += HandleModelChanged;

    protected override void OnAfterRender(bool firstRender) => Model.SetAnchor(_anchor);

    private void HandleModelChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Model.Changed -= HandleModelChanged;
}
