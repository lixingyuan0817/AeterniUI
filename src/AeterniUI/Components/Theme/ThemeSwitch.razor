@inherits AeterniComponent

@* One option template drives all three modes, so the label, the selected class and
   the pressed state can never drift between them. The slider position is derived
   from data-mode on the root, which is why the options carry no index of their own. *@
<div @ref="RootElement"
     @attributes="BuildAttributes()"
     role="group"
     aria-label="@GroupLabel"
     data-mode="@ThemeService.Mode.ToString().ToLowerInvariant()">
    <span class="aeterni-theme-switch__slider" aria-hidden="true"></span>

    @foreach (var mode in Modes)
    {
        var selected = ThemeService.Mode == mode;
        <button class="aeterni-theme-switch__option @(selected ? "is-selected" : string.Empty)"
                type="button"
                aria-pressed="@(selected ? "true" : "false")"
                disabled="@Disabled"
                @onclick="() => SelectModeAsync(mode)">
            @ModeLabel(mode)
        </button>
    }
</div>
