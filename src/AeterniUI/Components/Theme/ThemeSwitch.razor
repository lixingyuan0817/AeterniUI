@inherits AeterniComponent

<div @attributes="BuildAttributes()"
     role="group"
     aria-label="@GroupLabel"
     data-mode="@ThemeService.Mode.ToString().ToLowerInvariant()">
    <span class="aeterni-theme-switch__slider" aria-hidden="true"></span>

    <button class="aeterni-theme-switch__option @(ThemeService.Mode == ThemeMode.System ? "is-selected" : string.Empty)"
            type="button"
            aria-pressed="@(ThemeService.Mode == ThemeMode.System)"
            disabled="@Disabled"
            @onclick="() => SelectModeAsync(ThemeMode.System)">
        @SystemLabel
    </button>
    <button class="aeterni-theme-switch__option @(ThemeService.Mode == ThemeMode.Light ? "is-selected" : string.Empty)"
            type="button"
            aria-pressed="@(ThemeService.Mode == ThemeMode.Light)"
            disabled="@Disabled"
            @onclick="() => SelectModeAsync(ThemeMode.Light)">
        @LightLabel
    </button>
    <button class="aeterni-theme-switch__option @(ThemeService.Mode == ThemeMode.Dark ? "is-selected" : string.Empty)"
            type="button"
            aria-pressed="@(ThemeService.Mode == ThemeMode.Dark)"
            disabled="@Disabled"
            @onclick="() => SelectModeAsync(ThemeMode.Dark)">
        @DarkLabel
    </button>
</div>
