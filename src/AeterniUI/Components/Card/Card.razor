@inherits AeterniComponent

<div @ref="RootElement"
     @attributes="BuildAttributes()"
     @onclick="ClickHandler"
     @onkeydown="KeyDownHandler">
    @if (Header is not null)
    {
        <div class="aeterni-card__header">
            @Header
        </div>
    }

    @if (ChildContent is not null)
    {
        <div class="aeterni-card__body">
            @ChildContent
        </div>
    }

    @if (Footer is not null)
    {
        <div class="aeterni-card__footer">
            @Footer
        </div>
    }
</div>
