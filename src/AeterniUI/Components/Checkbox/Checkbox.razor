@inherits AeterniComponent

<label @ref="RootElement" @attributes="BuildAttributes()">
    <input @ref="_inputElement"
           @attributes="BuildInputAttributes()"
           id="@_effectiveId"
           type="checkbox"
           class="aeterni-checkbox__input"
           checked="@_currentValue"
           @onchange="HandleChangeAsync" />

    <span class="aeterni-checkbox__control" aria-hidden="true">
        <svg class="aeterni-checkbox__check" viewBox="0 0 16 16" focusable="false" aria-hidden="true">
            <path d="M2.9 8.4 6.4 11.7 13.1 4.5 12.2 3.7 6.5 9.8 3.8 7.3z" />
        </svg>
    </span>

    @if (ChildContent is not null)
    {
        <span class="aeterni-checkbox__label">@ChildContent</span>
    }
</label>
