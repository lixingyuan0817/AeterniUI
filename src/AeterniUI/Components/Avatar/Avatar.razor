@inherits AeterniComponent

<span @ref="RootElement" @attributes="BuildAttributes()" role="img" aria-label="@(Alt ?? Name ?? Initials)">
    @if (!string.IsNullOrWhiteSpace(Src))
    {
        <img src="@Src" alt="@(Alt ?? Name ?? Initials)" />
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Initials
    }
</span>
