@inherits AeterniComponent

<span @ref="RootElement"
      @attributes="BuildAttributes()"
      role="@(string.IsNullOrWhiteSpace(Src) ? "img" : null)"
      aria-label="@(string.IsNullOrWhiteSpace(Src) ? EffectiveLabel : null)">
    @if (!string.IsNullOrWhiteSpace(Src))
    {
        <img src="@Src" alt="@ImageAlt" />
    }
    else if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @Initials
    }
</span>
