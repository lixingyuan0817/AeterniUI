@inherits AeterniComponent

<div @ref="RootElement" @attributes="BuildAttributes()">
    <PopupHost>
        <Button Variant="@Variant"
                Intent="@Intent"
                Size="@Size"
                Loading="@Loading"
                Disabled="@Disabled"
                FullWidth="@FullWidth"
                AriaLabel="@AriaLabel"
                AdditionalAttributes="@TriggerAttributes"
                OnClick="ToggleAsync"
                EndIcon="@ChevronIcon">
            @Label
        </Button>

        <Popover Open="@EffectiveOpen"
                 OpenChanged="@HandleOpenChangedAsync"
                 Placement="@Placement"
                 AriaLabel="@(AriaLabel ?? Label)">
            <Menu Items="@Items"
                  AriaLabel="@(AriaLabel ?? Label)"
                  AdditionalAttributes="@MenuAttributes"
                  OnItemSelected="@HandleItemSelectedAsync" />
        </Popover>
    </PopupHost>
</div>

@code {
    private RenderFragment ChevronIcon => @<Icon Definition="@AeterniIcons.ChevronDown" />;
}
