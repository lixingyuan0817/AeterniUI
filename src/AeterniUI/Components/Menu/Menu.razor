@inherits AeterniComponent

<nav @ref="RootElement" @attributes="BuildAttributes()" aria-label="@AriaLabel">
    @foreach (var group in Items)
    {
        var open = IsOpen(group.Key);
        <section class="aeterni-menu__group @(open ? "is-open" : "")">
            <button type="button" class="aeterni-menu__group-toggle" aria-expanded="@open" @onclick="() => ToggleGroupAsync(group.Key)">
                @if (group.Icon is not null) { <span class="aeterni-menu__icon">@group.Icon</span> }
                <span>@group.Label</span><span class="aeterni-menu__chevron" aria-hidden="true">⌄</span>
            </button>
            @if (open)
            {
                <div class="aeterni-menu__items">
                    @foreach (var item in group.Items)
                    {
                        <button type="button" class="aeterni-menu__item @(SelectedId == item.Id ? "is-selected" : "")" disabled="@item.Disabled" aria-current="@(SelectedId == item.Id ? "page" : null)" @onclick="() => SelectAsync(item)">
                            @if (item.Icon is not null) { <span class="aeterni-menu__icon">@item.Icon</span> }
                            <span class="aeterni-menu__item-copy"><span>@item.Label</span>@if (!string.IsNullOrWhiteSpace(item.Description)) { <small>@item.Description</small> }</span>
                        </button>
                    }
                </div>
            }
        </section>
    }
</nav>
