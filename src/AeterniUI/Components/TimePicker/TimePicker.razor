@inherits AeterniComponent

<div @ref="RootElement" @attributes="BuildAttributes()">
    <PopupHost>
        <button type="button"
                class="aeterni-time-picker__trigger @SizeClass @(IsInvalid ? "is-invalid" : null)"
                id="@TriggerId"
                aria-label="@EffectiveAriaLabel"
                aria-labelledby="@FormField?.LabelId"
                aria-describedby="@FormField?.DescribedBy"
                aria-invalid="@(IsInvalid ? "true" : null)"
                aria-required="@(IsRequired ? "true" : null)"
                aria-haspopup="dialog"
                aria-expanded="@(_open ? "true" : "false")"
                disabled="@IsDisabled"
                @onkeydown="HandleKeyDownAsync"
                @onclick="ToggleAsync">
            <span class="@(Value.HasValue ? null : "is-placeholder")">@DisplayValue</span>
            <span class="aeterni-time-picker__icon" aria-hidden="true"><Icon Definition="@AeterniIcons.Clock" /></span>
        </button>
        <Popover Open="@_open" OpenChanged="HandleOpenChanged" Placement="@Placement" RestoreFocusOnClose="true" AriaLabel="@EffectiveAriaLabel">
            <ChildContent>
                <TimeOptionList Value="@Value"
                                ValueSelected="SelectAsync"
                                Step="@Step"
                                MinTime="@MinTime"
                                MaxTime="@MaxTime"
                                DisabledTime="@DisabledTime"
                                TimeFormat="@TimeFormat"
                                AriaLabel="@EffectiveOptionsLabel"
                                EmptyText="@UiText.TimePickerEmptyText"
                                CancelText="@EffectiveCancelText"
                                ConfirmText="@EffectiveConfirmText"
                                CancelRequested="CancelAsync" />
            </ChildContent>
        </Popover>
    </PopupHost>
</div>
