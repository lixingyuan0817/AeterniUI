@inherits AeterniComponent
@typeparam TItem

@* 触发器 + 「一列一级」的浮层面板。焦点始终留在触发器（`role="combobox"`），浮层里用
   `aria-activedescendant` 指向活动项——与 ComboBox 同一套键盘/焦点模型：单一 Tab 停留点，
   面板不抢走容器焦点。面板是**一个** `role="listbox"`，每一列是它的 `role="group"`
   （`group` 是 ARIA 允许的 listbox 子角色；每列再套一层 listbox 是非法的嵌套）。 *@
<PopupHost Class="aeterni-cascader__host">
    <ChildContent>
        <div @ref="RootElement" @attributes="BuildAttributes()">
            <button @ref="_triggerElement" type="button"
                    class="aeterni-cascader__trigger"
                    id="@FormFieldInputId"
                    role="combobox"
                    aria-labelledby="@FormFieldLabelId"
                    aria-describedby="@EffectiveDescribedBy"
                    aria-expanded="@(_open ? "true" : "false")"
                    aria-controls="@PanelId"
                    aria-haspopup="listbox"
                    aria-label="@(FormFieldLabelId is null ? EffectiveAriaLabel : null)"
                    aria-required="@(IsRequired ? "true" : null)"
                    aria-invalid="@(IsInvalid ? "true" : null)"
                    aria-activedescendant="@ActiveOptionId"
                    disabled="@IsDisabled"
                    @onclick="HandleTriggerClickAsync"
                    @onkeydown="HandleTriggerKeyDownAsync">
                <span class="aeterni-cascader__value @(Value is null ? "is-placeholder" : null)">
                    @(Value is null ? PlaceholderText : PathText)
                </span>
                <Icon Definition="@AeterniIcons.ChevronDown" Class="aeterni-cascader__chevron" />
            </button>

            <Popover Open="@_open"
                     OpenChanged="HandlePopoverOpenChangedAsync"
                     Placement="PopupPlacement.BottomStart"
                     CloseOnScroll="true"
                     Class="aeterni-cascader__popover"
                     AriaLabel="@ListLabel">
                <div class="aeterni-cascader__panel" id="@PanelId" role="listbox" aria-label="@ListLabel">
                    @for (var column = 0; column < _columns.Count; column++)
                    {
                        @* 局部副本：闭包要按当前列取值，不能捕获循环变量本身。 *@
                        var columnItems = _columns[column];
                        var columnIndex = column;

                        <div class="aeterni-cascader__column" role="group" aria-label="@ColumnLabel(columnIndex)">
                            @if (columnItems.Count == 0)
                            {
                                <div class="aeterni-cascader__empty">
                                    @if (EmptyContent is not null)
                                    {
                                        @EmptyContent
                                    }
                                    else
                                    {
                                        @UiText.CascaderEmptyText
                                    }
                                </div>
                            }
                            else
                            {
                                @for (var index = 0; index < columnItems.Count; index++)
                                {
                                    var item = columnItems[index];
                                    var optionIndex = index;
                                    var selected = ValuesEqual(item, Value);
                                    var active = columnIndex == _activeColumn && optionIndex == _activeIndex;
                                    var expandable = HasChildren(item);

                                    <div id="@($"{PanelId}-{OptionId(columnIndex, optionIndex)}")"
                                         role="option"
                                         aria-selected="@(selected ? "true" : "false")"
                                         class="aeterni-cascader__option @(active ? "is-active" : null) @(selected ? "is-selected" : null)"
                                         @onclick="@(args => HandleOptionClickAsync(columnIndex, optionIndex))">
                                        @if (ItemTemplate is not null)
                                        {
                                            @ItemTemplate(item)
                                        }
                                        else
                                        {
                                            <span class="aeterni-cascader__option-text">@DisplayText(item)</span>
                                        }
                                        @if (expandable)
                                        {
                                            <Icon Definition="@AeterniIcons.ChevronRight" Class="aeterni-cascader__option-caret" />
                                        }
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            </Popover>
        </div>
    </ChildContent>
</PopupHost>
