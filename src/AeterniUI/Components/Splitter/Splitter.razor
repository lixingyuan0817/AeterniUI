@inherits AeterniComponent

@* The handle is an overlay on the seam; the two panes stay in the grid so the
   host can put its own scrolling surfaces inside them. *@
<div @ref="_root" @attributes="BuildAttributes()">
    <div class="aeterni-splitter__pane aeterni-splitter__pane--first">@FirstPane</div>

    <div @ref="_handle"
         class="aeterni-splitter__handle"
         role="separator"
         tabindex="@(Disabled ? "-1" : "0")"
         aria-orientation="@SeparatorOrientation"
         aria-valuemin="@MinFirstSize"
         aria-valuemax="@MaxFirstSize"
         aria-valuenow="@_size"
         aria-label="@EffectiveAriaLabel"
         aria-disabled="@(Disabled ? "true" : null)"></div>

    <div class="aeterni-splitter__pane aeterni-splitter__pane--second">@SecondPane</div>
</div>
