@inherits AeterniComponent

@* The handle is an overlay on the seam; the two panes stay in the grid so the
   host can put its own scrolling surfaces inside them. @ref goes through
   RenderedRootElement so the base class still receives Element / ElementChanged. *@
<div @ref="RenderedRootElement" @attributes="BuildAttributes()">
    <div class="aeterni-splitter__pane">@FirstPane</div>

    <div @ref="_renderedHandle"
         class="aeterni-splitter__handle"
         role="separator"
         tabindex="@(Disabled ? "-1" : "0")"
         aria-orientation="@SeparatorOrientation"
         aria-valuemin="@MinFirstSize"
         aria-valuemax="@MaxFirstSize"
         aria-valuenow="@_size"
         aria-label="@EffectiveAriaLabel"
         aria-disabled="@(Disabled ? "true" : null)"></div>

    <div class="aeterni-splitter__pane">@SecondPane</div>
</div>
