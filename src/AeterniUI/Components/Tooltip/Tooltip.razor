@inherits AeterniComponent

<span @attributes="BuildAttributes()" class="aeterni-tooltip">
    <span class="aeterni-tooltip__trigger">@ChildContent</span>
    @if (!Disabled && !string.IsNullOrWhiteSpace(Text))
    {
        <span class="aeterni-tooltip__content" role="tooltip">@Text</span>
    }
</span>
