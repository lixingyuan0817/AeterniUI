@inherits AeterniComponent

<span @ref="RootElement" @attributes="BuildAttributes()">
    <span class="aeterni-tooltip__trigger">@ChildContent</span>
    @if (!Disabled && !string.IsNullOrWhiteSpace(Text))
    {
        <span class="aeterni-tooltip__content" id="@ContentId" role="tooltip">@Text</span>
    }
</span>
