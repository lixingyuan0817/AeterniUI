@inherits AeterniComponent

<nav @ref="RootElement" @attributes="BuildAttributes()" aria-label="@EffectiveAriaLabel">
    <button type="button" disabled="@(Disabled || CurrentPage == 1)" aria-label="@EffectivePreviousLabel" @onclick="() => GoToAsync(CurrentPage - 1)">
        <Icon Definition="@AeterniIcons.ChevronLeft" />
    </button>
    @{ var previous = 0; }
    @foreach (var page in VisiblePages)
    {
        if (page - previous > 1)
        {
            <span class="aeterni-pagination__ellipsis" aria-hidden="true">…</span>
        }
        var value = page;
        <button type="button" class="@(page == CurrentPage ? "is-current" : "")" aria-current="@(page == CurrentPage ? "page" : null)" aria-label="@PageLabel(value)" disabled="@Disabled" @onclick="() => GoToAsync(value)">@value</button>
        previous = page;
    }
    <button type="button" disabled="@(Disabled || CurrentPage == TotalPages)" aria-label="@EffectiveNextLabel" @onclick="() => GoToAsync(CurrentPage + 1)">
        <Icon Definition="@AeterniIcons.ChevronRight" />
    </button>
</nav>
