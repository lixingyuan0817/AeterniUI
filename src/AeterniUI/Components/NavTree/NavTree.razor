@inherits AeterniComponent

<ul @ref="_root" @attributes="BuildAttributes()" role="tree" aria-label="@EffectiveAriaLabel">
    @foreach (var node in Items)
    {
        @RenderNode(node, 0)
    }
</ul>

@code {
    private RenderFragment RenderNode(NavTreeNode node, int depth) => @<text>
        @if (node.Visible)
        {
            <li class="aeterni-nav-tree__node @(IsNodeSelected(node) ? "is-selected" : null)"
                role="treeitem"
                aria-level="@(depth + 1)"
                aria-selected="@(CanSelect(node) ? (IsNodeSelected(node) ? "true" : "false") : null)"
                aria-expanded="@(node.HasChildren ? (IsOpen(node.Id) ? "true" : "false") : null)">
                <div class="aeterni-nav-tree__row">
                    <button type="button"
                            id="@NodeElementId(node.Id)"
                            class="aeterni-nav-tree__button"
                            tabindex="@TabIndexFor(node.Id)"
                            disabled="@node.Disabled"
                            @onfocus="() => HandleFocus(node.Id)"
                            @onclick="() => ActivateAsync(node)"
                            @onkeydown="eventArgs => HandleKeyDownAsync(node, eventArgs)">
                        @if (node.Icon is not null)
                        {
                            <span class="aeterni-nav-tree__icon" aria-hidden="true">@node.Icon</span>
                        }

                        <span class="aeterni-nav-tree__copy">
                            <span class="aeterni-nav-tree__label">@node.Label</span>
                            @if (!string.IsNullOrWhiteSpace(node.Description))
                            {
                                <span class="aeterni-nav-tree__description">@node.Description</span>
                            }
                        </span>
                    </button>

                    @if (node.Trailing is not null)
                    {
                        <div class="aeterni-nav-tree__trailing">@node.Trailing</div>
                    }
                </div>

                @if (node.HasChildren && IsOpen(node.Id))
                {
                    <ul class="aeterni-nav-tree__group" role="group">
                        @foreach (var child in node.Children!)
                        {
                            @RenderNode(child, depth + 1)
                        }
                    </ul>
                }
            </li>
        }
    </text>;
}
