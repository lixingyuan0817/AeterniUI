@inherits AeterniComponent

<button @ref="RootElement" @attributes="BuildAttributes()" @onclick="HandleClickAsync">
    @if (Loading)
    {
        <span class="aeterni-icon-button__loading" aria-hidden="true"><Spinner /></span>
    }
    else if (EffectiveIcon is not null)
    {
        <span class="aeterni-icon-button__icon" aria-hidden="true">@EffectiveIcon</span>
    }
</button>
