@inherits AeterniComponent

<button @ref="RootElement" @attributes="BuildAttributes()" @onclick="HandleClickAsync">
    <span class="aeterni-button__content">
        @if (Loading)
        {
            @* The button already carries aria-busy, so the nested spinner is decorative. *@
            <span class="aeterni-button__loading" aria-hidden="true">
                <Spinner />
            </span>
        }
        else if (EffectiveStartIcon is not null)
        {
            <span class="aeterni-button__icon" aria-hidden="true">
                @EffectiveStartIcon
            </span>
        }

        @ChildContent

        @if (!Loading && EndIcon is not null)
        {
            <span class="aeterni-button__icon" aria-hidden="true">
                @EndIcon
            </span>
        }
    </span>
</button>
