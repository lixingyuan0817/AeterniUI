@typeparam TValue
@inherits AeterniComponent

@* Native radio inputs inside a labelled radiogroup: the browser already provides the
   single tab stop (roving focus), the arrow keys and the RTL-aware arrow direction.
   The one thing a radio group has no behaviour for is Home/End, so the component adds
   that pair in C# (see HandleKeyDownAsync) and pairs it with a minimal module whose
   only job is to keep the browser's default action - a page scroll - from firing
   underneath it. The pill is decorative and takes its geometry from two custom
   properties (index / count), which is why it does not care how many options the
   control has. *@
<div @ref="RootElement" @attributes="BuildAttributes()" @onkeydown="HandleKeyDownAsync">
    <span class="aeterni-segmented__slider" aria-hidden="true"></span>

    @for (var index = 0; index < Items.Count; index++)
    {
        var item = Items[index];
        // Local copy: the @ref capture below is a lambda, and Razor's @for shares one
        // loop variable, so every capture would otherwise store the final index.
        var optionIndex = index;
        var isSelected = IsSelected(item);
        var isDisabled = IsItemDisabled(item);

        <label class="@OptionClass(isSelected, isDisabled)">
            <input class="aeterni-segmented__input"
                   type="radio"
                   name="@GroupName"
                   checked="@isSelected"
                   disabled="@isDisabled"
                   @ref="_optionElements[optionIndex]"
                   @onchange="() => SelectAsync(item)" />
            <span class="aeterni-segmented__label">
                @if (ItemTemplate is not null)
                {
                    @ItemTemplate(item)
                }
                else
                {
                    @ItemText(item)
                }
            </span>
        </label>
    }
</div>
